#!/usr/bin/env bash
set -euo pipefail

# Use the system profile so the plugin-enabled Rofi override is not shadowed.
export PATH="/run/current-system/sw/bin:${PATH:-}"

exec rofi -dmenu -password -p 'System password' \
  -config "${XDG_CONFIG_HOME:-$HOME/.config}/rofi/config.rasi" \
  -theme-str 'window { width: 36%; } mainbox { children: [ inputbar ]; }'
