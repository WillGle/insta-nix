#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=/dev/null
. "@screenTimeLib@/lib/common.sh"
# shellcheck source=/dev/null
. "@screenTimeLib@/lib/menu.sh"

TARGET_DATE="$(date +%F)"
DAY_FILE="${SCREEN_TIME_HOME}/days/${TARGET_DATE}.json"

load_day_json() {
  if [ -r "$DAY_FILE" ] && jq -e . "$DAY_FILE" >/dev/null 2>&1; then
    jq -c . "$DAY_FILE"
  else
    default_day_json "$TARGET_DATE"
  fi
}

active_window_json() {
  # hyprctl can return socket errors on stdout with status 0; validate JSON.
  hyprctl activewindow -j 2>/dev/null | jq -c . 2>/dev/null || jq -n '{}'
}

emit_json() {
  local text="$1"
  local tooltip="$2"
  local class="$3"

  jq -cn \
    --arg text "$text" \
    --arg tooltip "$tooltip" \
    --arg class "$class" \
    '{text: $text, tooltip: $tooltip, class: $class}'
}

main() {
  local mode_file="${XDG_RUNTIME_DIR:-/tmp}/waybar_clock_mode"

  if [ "${1:-}" = "toggle" ]; then
    local current_mode="0"
    if [ -f "$mode_file" ]; then
      current_mode="$(cat "$mode_file")"
    fi
    if [ "$current_mode" = "0" ]; then
      echo "1" > "$mode_file"
    else
      echo "0" > "$mode_file"
    fi
    pkill -RTMIN+7 -x waybar || pkill -RTMIN+7 -x .waybar-wrapped || true
    return 0
  fi

  local display_mode="0"
  if [ -f "$mode_file" ]; then
    display_mode="$(cat "$mode_file")"
  fi

  local day_json active_window
  local total_seconds active_class active_key active_name active_seconds active_title
  local class text tooltip sep current_time current_date_tooltip

  day_json="$(load_day_json)"
  active_window="$(active_window_json)"

  total_seconds="$(printf '%s' "$day_json" | jq -r '.total_seconds // 0')"
  active_class="$(printf '%s' "$active_window" | jq -r '.class // .initialClass // empty')"
  active_key="$(normalize_class "$active_class")"
  active_name="$(printf '%s' "$day_json" | jq -r --arg key "$active_key" '.apps[$key].name // empty')"
  [ -n "$active_name" ] || active_name="$(humanize_class "${active_key:-unknown}")"
  active_seconds="$(printf '%s' "$day_json" | jq -r --arg key "$active_key" '.apps[$key].seconds // 0')"
  active_title="$(printf '%s' "$active_window" | jq -r '.title // empty')"

  class="normal"
  if [ "$total_seconds" -eq 0 ]; then
    class="idle"
  elif [ "$total_seconds" -ge 28800 ]; then
    class="high"
  elif [ "$total_seconds" -ge 14400 ]; then
    class="medium"
  fi

  current_time="$(date +'%H:%M')"
  current_date_tooltip="$(date +'%A, %d %B %Y')"

  if [ "$display_mode" = "1" ]; then
    text=" ${current_time}   󰔟 $(seconds_to_short "$total_seconds")"
  else
    text=" ${current_time}"
  fi

  sep="<span alpha='30%'>──────────────────────────</span>"
  tooltip="<b><span foreground='@themeAccent@'>TIME</span></b>
$sep
<tt>${current_date_tooltip}</tt>

<b><span foreground='@themeAccent@'>SCREEN TIME</span></b>
$sep
<tt>Total:        $(seconds_to_short "$total_seconds")</tt>

<b><span foreground='@themeAccent@'>CURRENT</span></b>
$sep
<tt>App:          $(escape_markup "$active_name") ($(seconds_to_short "$active_seconds"))"
  if [ -n "$active_title" ]; then
    tooltip+="
Title:        $(escape_markup "$active_title")"
  fi
  tooltip+="</tt>

<span size='small' alpha='65%'>Click: toggle view · Right: dashboard</span>"

  emit_json "$text" "$tooltip" "$class"
}

main "$@"
