#!/usr/bin/env bash
set -euo pipefail

# Use build-time library paths to avoid runtime link resolution.
SCREEN_TIME_LIB_DIR="@screenTimeLib@/lib"
# shellcheck source=/dev/null
. "$SCREEN_TIME_LIB_DIR/common.sh"

ROFI_CONFIG="${HOME}/.config/rofi/config.rasi"
ROFI_THEME="${HOME}/.config/rofi/screen-time.rasi"
STATS_BIN="${STATS_BIN:-${HOME}/.local/bin/rofi-screen-time-stats}"
CACHE_ROOT="${SCREEN_TIME_CACHE_HOME}/popup-cache"
CACHE_TTL_SECONDS=300

VIEW="summary"
TARGET_DATE="$(date +%F)"
force_refresh=false

usage() {
  cat <<'EOF'
Usage: rofi-screen-time [--date YYYY-MM-DD] [--view summary|activity]
EOF
}

palette_stamp() {
  local digest=""
  if [ ! -r "$THEME_PALETTE_FILE" ]; then
    printf 'static\n'
    return 0
  fi

  digest="$(sha256sum "$THEME_PALETTE_FILE" 2>/dev/null || true)"
  [ -n "$digest" ] || {
    printf 'static\n'
    return 0
  }
  printf '%s\n' "${digest%% *}"
}

cache_dir_for() {
  printf '%s/%s-%s\n' "$CACHE_ROOT" "$VIEW" "$TARGET_DATE"
}

cache_is_fresh() {
  local dir now age
  local -a meta=()
  dir="$(cache_dir_for)"
  [ -r "$dir/theme.rasi" ] || return 1
  [ -r "$dir/rows.txt" ] || return 1
  [ -r "$dir/meta" ] || return 1
  mapfile -t meta <"$dir/meta"
  [ "${#meta[@]}" -eq 3 ] || return 1
  [ "${meta[0]}" = "$TARGET_DATE" ] || return 1
  [ "${meta[1]}" = "$(palette_stamp)" ] || return 1
  now="$(date +%s)"
  age=$((now - meta[2]))
  [ "$age" -ge 0 ] && [ "$age" -lt "$CACHE_TTL_SECONDS" ]
}

write_cache() {
  local theme_source="$1"
  local rows_source="$2"
  local dir theme_tmp rows_tmp meta_tmp

  dir="$(cache_dir_for)"
  mkdir -p "$dir"
  theme_tmp="$(mktemp "$dir/theme.XXXXXX")"
  rows_tmp="$(mktemp "$dir/rows.XXXXXX")"
  meta_tmp="$(mktemp "$dir/meta.XXXXXX")"

  cat "$theme_source" >"$theme_tmp"
  cat "$rows_source" >"$rows_tmp"
  # Write the stamp last so an interrupted render cannot mark partial output fresh.
  printf '%s\n%s\n%s\n' "$TARGET_DATE" "$(palette_stamp)" "$(date +%s)" >"$meta_tmp"

  mv "$theme_tmp" "$dir/theme.rasi"
  mv "$rows_tmp" "$dir/rows.txt"
  mv "$meta_tmp" "$dir/meta"
}

render_sync() {
  local tmpdir
  tmpdir="$(mktemp -d)"
  "$STATS_BIN" --view "$VIEW" --date "$TARGET_DATE" --format files \
    --theme-file "$tmpdir/theme.rasi" \
    --rows-file "$tmpdir/rows.txt"
  write_cache "$tmpdir/theme.rasi" "$tmpdir/rows.txt"
  rm -rf "$tmpdir"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --date)
      TARGET_DATE="${2:-}"
      shift 2
      ;;
    --view)
      VIEW="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

TARGET_DATE="$(date -d "$TARGET_DATE" +%F 2>/dev/null || date +%F)"
VIEW="$(resolve_screen_time_view "$VIEW")"

while :; do
  if [ "$force_refresh" = false ] && cache_is_fresh; then
    cache_dir="$(cache_dir_for)"
  else
    render_sync
    cache_dir="$(cache_dir_for)"
  fi
  force_refresh=false

  rows_file="$cache_dir/rows.txt"
  theme_str="$(cat "$cache_dir/theme.rasi")"

  if ! selection_idx="$(
    cat "$rows_file" \
      | rofi -dmenu -markup-rows -show-icons -no-custom -format i \
          -config "$ROFI_CONFIG" \
          -theme "$ROFI_THEME" \
          -theme-str "$theme_str" \
          -p ""
  )"; then
    exit 0
  fi

  # Bash strings cannot hold NUL; the row token ends before the metadata suffix.
  mapfile -t rows <"$rows_file"
  selection="${rows[$selection_idx]:-}"

  case "$selection" in
    close|"")
      exit 0
      ;;
    view:*:*)
      VIEW="${selection#view:}"
      VIEW="${VIEW%%:*}"
      TARGET_DATE="${selection##*:}"
      ;;
    nav:prev-day:*|nav:next-day:*)
      TARGET_DATE="$(printf '%s' "$selection" | cut -d: -f3)"
      VIEW="$(printf '%s' "$selection" | cut -d: -f4)"
      ;;
    refresh:*)
      force_refresh=true
      ;;
    *)
      exit 0
      ;;
  esac
done
