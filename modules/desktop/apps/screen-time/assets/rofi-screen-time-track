#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=/dev/null
. "@screenTimeLib@/lib/common.sh"

STATE_DIR="$SCREEN_TIME_HOME"
INTERVAL_SECONDS="$SCREEN_TIME_SAMPLE_SECONDS"
RUN_ONCE=0

usage() {
  cat <<'EOF'
Usage: rofi-screen-time-track [--interval-seconds N] [--once] [--state-dir PATH]
EOF
}

ignored_class() {
  case "${1,,}" in
    ""|desktop|unknown|rofi|hyprlock|quickshell|dunst)
      return 0
      ;;
  esac
  return 1
}

ensure_dirs() {
  mkdir -p "$STATE_DIR/days" "$SCREEN_TIME_CACHE_HOME"
}

resolve_name_icon() {
  local normalized="$1"
  local resolved=""
  local icon=""

  build_desktop_cache
  if [ -s "$CACHE_FILE" ]; then
    resolved="$(awk -F '\t' -v key="$normalized" '$1 == key { print $2; exit }' "$CACHE_FILE")"
    icon="$(awk -F '\t' -v key="$normalized" '$1 == key { print $3; exit }' "$CACHE_FILE")"
  fi

  if [ -z "$resolved" ]; then
    resolved="$(humanize_class "$normalized")"
  fi

  printf '%s\t%s\n' "$resolved" "$icon"
}

is_idle() {
  if [ -n "${SCREEN_TIME_TEST_IDLE_HINT:-}" ]; then
    [ "${SCREEN_TIME_TEST_IDLE_HINT}" = "yes" ]
    return
  fi

  if [ -z "${XDG_SESSION_ID:-}" ]; then
    return 1
  fi

  loginctl show-session "$XDG_SESSION_ID" -p IdleHint 2>/dev/null | grep -q 'IdleHint=yes'
}

is_locked() {
  if [ -n "${SCREEN_TIME_TEST_LOCKED:-}" ]; then
    [ "${SCREEN_TIME_TEST_LOCKED}" = "1" ]
    return
  fi

  pgrep -x hyprlock >/dev/null 2>&1
}

get_active_window_json() {
  if [ -n "${SCREEN_TIME_TEST_ACTIVEWINDOW_JSON:-}" ]; then
    printf '%s\n' "$SCREEN_TIME_TEST_ACTIVEWINDOW_JSON"
    return 0
  fi

  hyprctl activewindow -j 2>/dev/null || return 1
}

record_sample() {
  local payload="$1"
  local raw_class=""
  local normalized=""
  local title=""
  local metadata=""
  local display_name=""
  local icon_name=""

  raw_class="$(printf '%s' "$payload" | jq -r '.initialClass // .class // empty')"
  title="$(printf '%s' "$payload" | jq -r '.initialTitle // .title // empty')"
  [ -n "$raw_class" ] || return 0

  normalized="$(normalize_class "$raw_class")"
  [ -n "$normalized" ] || return 0
  ignored_class "$normalized" && return 0

  # The Desktop window is the compositor background, not an application.
  if [ "${title,,}" = "desktop" ]; then
    return 0
  fi

  metadata="$(resolve_name_icon "$normalized")"
  display_name="${metadata%%$'\t'*}"
  icon_name="${metadata#*$'\t'}"

  with_day_lock "$STATE_DIR" \
    commit_sample "$normalized" "$raw_class" "$display_name" "$icon_name"
}

# Hold the shared day-file lock across the read and rewrite.
commit_sample() {
  local normalized="$1"
  local raw_class="$2"
  local display_name="$3"
  local icon_name="$4"
  local target_date=""
  local day_file=""
  local tmp_file=""
  local hour=""
  local minute=""
  local slot_idx=""
  local now_iso=""
  local normalized_json=""

  target_date="$(date +%F)"
  day_file="${STATE_DIR}/days/${target_date}.json"
  now_iso="$(date --iso-8601=seconds)"
  hour="$(date +%H)"
  minute="$(date +%M)"
  slot_idx=$((10#$hour * 2 + 10#$minute / 30))

  if [ -f "$day_file" ]; then
    normalized_json="$(normalize_day_json "$target_date" "$now_iso" "$INTERVAL_SECONDS" <"$day_file")"
  else
    normalized_json="$(default_day_json "$target_date" "$now_iso" "$INTERVAL_SECONDS")"
  fi

  tmp_file="$(mktemp "${day_file}.XXXXXX")"
  printf '%s' "$normalized_json" \
    | jq \
      --arg now "$now_iso" \
      --arg key "$normalized" \
      --arg class "$raw_class" \
      --arg name "$display_name" \
      --arg icon "$icon_name" \
      --argjson sample "$INTERVAL_SECONDS" \
      --argjson slot "$slot_idx" \
      '
      .updated_at = $now
      | .sample_count = ((.sample_count // 0) + 1)
      | .first_seen = (if (.first_seen // "") == "" then $now else .first_seen end)
      | .last_seen = $now
      | .total_seconds = ((.total_seconds // 0) + $sample)
      | .slots_30m = ((.slots_30m // ([range(0; 48)] | map(0))) | .[$slot] += $sample)
      | .apps[$key] = (
          (.apps[$key] // {
            class: $class,
            name: $name,
            icon: $icon,
            seconds: 0,
            sample_count: 0,
            first_seen: $now,
            last_seen: $now,
            slots_30m: ([range(0; 48)] | map(0))
          })
          | .class = $class
          | .name = $name
          | .icon = $icon
          | .seconds = ((.seconds // 0) + $sample)
          | .sample_count = ((.sample_count // 0) + 1)
          | .first_seen = (if (.first_seen // "") == "" then $now else .first_seen end)
          | .last_seen = $now
          | .slots_30m = ((.slots_30m // ([range(0; 48)] | map(0))) | .[$slot] += $sample)
        )
      ' >"$tmp_file"
  mv "$tmp_file" "$day_file"
}

sample_once() {
  local payload=""

  is_idle && return 0
  is_locked && return 0
  payload="$(get_active_window_json)" || return 0
  [ "$payload" != "{}" ] || return 0
  record_sample "$payload"
}

# Hold flock for the process lifetime; the kernel releases it on exit.
acquire_lock() {
  local lock_file="${XDG_RUNTIME_DIR:-/tmp}/rofi-screen-time-track.lock"

  if ! exec 9>"$lock_file"; then
    printf 'rofi-screen-time-track: cannot open %s\n' "$lock_file" >&2
    return 1
  fi

  if ! flock -n 9; then
    printf 'rofi-screen-time-track: another tracker instance is already running\n' >&2
    return 1
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --interval-seconds)
      INTERVAL_SECONDS="${2:-}"
      shift 2
      ;;
    --once)
      RUN_ONCE=1
      shift
      ;;
    --state-dir)
      STATE_DIR="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

case "$INTERVAL_SECONDS" in
  ''|*[!0-9]*)
    printf 'rofi-screen-time-track: invalid interval %s\n' "$INTERVAL_SECONDS" >&2
    exit 2
    ;;
esac

ensure_dirs

if [ "$RUN_ONCE" -eq 1 ]; then
  sample_once
  exit 0
fi

acquire_lock || exit 0
while :; do
  sample_once || true
  sleep "$INTERVAL_SECONDS"
done
