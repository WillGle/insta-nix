#!/usr/bin/env bash
set -euo pipefail

# rofi-hub — one entry point for the desktop Rofi surfaces.
#
# Community modes stay upstream: drun/window are built into rofi, calc and
# emoji come from the configured plugins, and power comes from
# rofi-power-menu. The hub only adds the shared config and generated themes.
# The repo-owned menus live in ~/.local/lib/rofi-hub/ and are not on PATH.

# shellcheck source=/dev/null
. "@menuLib@"

HUB_LIBEXEC="${HOME}/.local/lib/rofi-hub"
ROFI_BIN="${ROFI_BIN:-rofi}"
ROFI_CONFIG="${ROFI_CONFIG:-$(rofi_config_path)}"

usage() {
  cat <<'EOF'
Usage: rofi-hub <command> [args...]

Commands:
  launcher (default)    Application launcher (drun)
  window                Window switcher
  calc                  Calculator (rofi-calc)
  emoji                 Emoji picker (rofi-emoji)
  clipboard             Clipboard history
  calendar [args...]    Calendar
  network               Network manager
  keybinds              Keyboard shortcuts
  power                 Power menu
  show <mode> [args...] Raw rofi mode with the shared theme
  help                  Show this help
EOF
}

die() {
  printf 'rofi-hub: %s\n' "$1" >&2
  exit 2
}

theme_for_mode() {
  case "$1" in
    drun) printf 'launcher' ;;
    *) printf '%s' "$1" ;;
  esac
}

show_mode() {
  local mode="$1"
  local theme_name="$2"
  shift 2
  local theme
  local -a args=(-show "$mode" -config "$ROFI_CONFIG")

  theme="$(rofi_theme_path "$theme_name")"
  [ -r "$theme" ] && args+=(-theme "$theme")

  exec "$ROFI_BIN" "${args[@]}" "$@"
}

toggle_show_mode() {
  local mode="$1"
  local theme_name="$2"
  shift 2

  if close_running_rofi; then
    exit 0
  fi

  show_mode "$mode" "$theme_name" "$@"
}

run_libexec() {
  local name="$1"
  shift
  local path="${HUB_LIBEXEC}/${name}"

  [ -x "$path" ] || die "missing internal command: ${path}"
  exec "$path" "$@"
}

subcommand="${1:-launcher}"
[ "$#" -gt 0 ] && shift

case "$subcommand" in
  launcher | drun | apps)
    toggle_show_mode drun launcher "$@"
    ;;
  window | windows)
    toggle_show_mode window window "$@"
    ;;
  calc | calculator)
    # rofi-calc runs the command through the shell; keep wl-copy on PATH.
    toggle_show_mode calc calc \
      -modi calc \
      -no-show-match \
      -no-sort \
      -calc-command "echo -n '{result}' | wl-copy" \
      "$@"
    ;;
  emoji)
    toggle_show_mode emoji emoji -modi emoji "$@"
    ;;
  clipboard)
    run_libexec clipboard "$@"
    ;;
  calendar)
    run_libexec calendar "$@"
    ;;
  network | wifi)
    run_libexec network "$@"
    ;;
  keybinds | shortcuts)
    run_libexec keybinds "$@"
    ;;
  power)
    power_theme="$(rofi_theme_path power)"
    power_args=(
      -show power-menu
      -modi "power-menu:${ROFI_POWER_MENU_BIN:-rofi-power-menu}"
      -config "$ROFI_CONFIG"
    )
    [ -r "$power_theme" ] && power_args+=(-theme "$power_theme")
    exec "$ROFI_BIN" "${power_args[@]}" "$@"
    ;;
  show)
    [ "$#" -gt 0 ] || die 'show requires a rofi mode'
    raw_mode="$1"
    shift
    toggle_show_mode "$raw_mode" "$(theme_for_mode "$raw_mode")" "$@"
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    die "unknown command: ${subcommand} (try 'rofi-hub help')"
    ;;
esac
