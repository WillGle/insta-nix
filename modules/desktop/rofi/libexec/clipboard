#!/usr/bin/env bash
set -euo pipefail

# Internal rofi-hub command: clipboard history.
# shellcheck source=/dev/null
. "@menuLib@"

if close_running_rofi; then
  exit 0
fi

config="$(rofi_config_path)"
theme="$(rofi_theme_path clipboard)"

entries="$(cliphist list)"
selection="$(
  printf '%s\n' "$entries" | rofi -dmenu -i \
    -no-custom \
    -p "Clipboard" \
    -config "$config" \
    -theme "$theme"
)" && rc=0 || rc=$?

case "$rc" in
  0) ;;
  1) exit 0 ;;
  *) exit "$rc" ;;
esac

if [ -n "$selection" ]; then
  printf '%s\n' "$selection" | cliphist decode | wl-copy
fi
