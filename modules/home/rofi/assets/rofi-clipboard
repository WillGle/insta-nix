#!/usr/bin/env bash
set -euo pipefail

if pgrep -x rofi >/dev/null 2>&1; then
  pkill -x rofi
  exit 0
fi

entries="$(cliphist list)"
selection="$(
  printf '%s\n' "$entries" | rofi -dmenu -i \
    -no-custom \
    -p "Clipboard" \
    -config ~/.config/rofi/config.rasi \
    -theme ~/.config/rofi/clipboard.rasi
)" && rc=0 || rc=$?

case "$rc" in
  0) ;;
  1) exit 0 ;;
  *) exit "$rc" ;;
esac

if [ -n "$selection" ]; then
  printf '%s\n' "$selection" | cliphist decode | wl-copy
fi
