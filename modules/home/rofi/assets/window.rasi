@theme "~/.config/rofi/theme.rasi"

/* Window switching is a scan task, so titles stay in one readable column. */

configuration {
  sidebar-mode: true;
  fixed-num-lines: false;
}

window {
  width: 52%;
  border: 1px;
  padding: 12px;
}

mainbox {
  spacing: 9px;
  padding: 9px;
}

sidebar {
  border: 0px;
  border-radius: 8px;
  background-color: @panel-bg;
  padding: 5px;
  spacing: 5px;
}

button {
  padding: 7px 10px;
  border-radius: 8px;
  background-color: transparent;
  text-color: @subtext;
}

button selected {
  background-color: @accent;
  text-color: @base;
}

entry {
  placeholder: "Search windows...";
}

listview {
  columns: 1;
  lines: 8;
  fixed-height: false;
  spacing: 6px;
  scrollbar: false;
  border: 0px;
  padding: 0px;
}

element {
  children: [ element-icon, element-text ];
  spacing: 7px;
  padding: 7px 9px;
  border: 1px;
  border-radius: 9px;
  border-color: @outline-soft;
  background-color: @panel-bg;
  text-color: @text;
}

element-icon {
  size: 1.2em;
  background-color: transparent;
}

element-text {
  font: @mono-font;
  vertical-align: 0.5;
}
