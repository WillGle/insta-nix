{
  "layer": "top",
  "position": "top",
  "height": 34,
  "modules-left": [
    "hyprland/workspaces",
    "custom/screen_time",
    "clock#calendar"
  ],
  "modules-center": [
    "custom/atomic_note"
  ],
  "modules-right": [
    "custom/systemd_failed",
    "custom/screen_rec",
    "custom/memory_info",
    "custom/disk_info",
    "custom/apu_info",
    "custom/power_flow",
    "backlight",
    "pulseaudio",
    "custom/network_info",
    "tray"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "sort-by": "number",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },
  "clock#calendar": {
    "format": " {:%a %d %b}",
    "interval": 60,
    "on-click": "setsid -f $HOME/.local/bin/rofi-calendar",
    "tooltip-format": "<b><span foreground='#58a6ff'>CALENDAR</span></b>\n<span alpha='30%'>──────────────────────────</span>\n<tt>{:%A, %d %B %Y}</tt>\n\n<span size='small' alpha='65%'>Click: open calendar</span>"
  },
  "custom/screen_time": {
    "exec": "$HOME/.local/bin/waybar-screen-time",
    "return-type": "json",
    "interval": 30,
    "signal": 7,
    "on-click": "$HOME/.local/bin/waybar-screen-time toggle",
    "on-click-right": "setsid -f $HOME/.local/bin/rofi-screen-time",
    "on-click-middle": "setsid -f $HOME/.local/bin/rofi-study-timer",
    "tooltip": true
  },
  // Memory
  "custom/memory_info": {
    "exec": "$HOME/.local/bin/waybar-memory-info",
    "return-type": "json",
    // Limit expensive memory/process scans to every two seconds.
    "interval": 2,
    "on-click": "$HOME/.local/bin/waybar-disk-info toggle",
    "tooltip": true
  },
  // Disks: hidden until memory is clicked; signal 8 refreshes visibility.
  "custom/disk_info": {
    "exec-if": "$HOME/.local/bin/waybar-disk-info visible",
    "exec": "$HOME/.local/bin/waybar-disk-info",
    "return-type": "json",
    // Refresh temperatures while the block is open.
    "interval": 2,
    "signal": 8,
    "tooltip": true
  },
  // Audio
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": " {volume}%",
    "format-muted": "󰖁",
    "format-bluetooth-muted": " 󰖁",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 1,
    "tooltip-format": "<b><span foreground='#58a6ff'>AUDIO DEVICE</span></b>\n<span alpha='30%'>──────────────────────────</span>\n<tt>{desc}\nVolume:      {volume}%</tt>\n\n<span size='small' alpha='65%'>Click: mute · Scroll: volume</span>",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        ""
      ]
    }
  },
  // Temperature and power
  "custom/apu_info": {
    "exec": "$HOME/.local/bin/waybar-power-monitor apu",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "on-click": "$HOME/.local/bin/waybar-power-monitor toggle",
    "tooltip": true
  },
  "custom/power_flow": {
    "exec": "$HOME/.local/bin/waybar-power-monitor pwr",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 2,
    "on-click": "$HOME/.local/bin/waybar-power-monitor bmode-toggle",
    "tooltip": true
  },
  // Recording changes signal 9; polling catches recorder crashes.
  "custom/screen_rec": {
    "exec": "$HOME/.local/bin/screen-rec status",
    "return-type": "json",
    "interval": 30,
    "signal": 9,
    "on-click": "$HOME/.local/bin/screen-rec toggle",
    "on-click-right": "$HOME/.local/bin/screen-rec region",
    "on-click-middle": "setsid -f $HOME/.local/bin/screen-rec audio",
    "tooltip": true
  },
  "custom/atomic_note": {
    "exec": "$HOME/.local/bin/atomic-note render-waybar",
    "max-length": 40,
    "return-type": "json",
    // Signal 5 refreshes changes, including editor exit; avoid frequent polling.
    "interval": 30,
    "on-click": "$HOME/.local/bin/atomic-note rofi",
    "on-click-right": "$HOME/.local/bin/atomic-note add",
    // Middle click completes the task; undo is available in the menu.
    "on-click-middle": "$HOME/.local/bin/atomic-note done-top",
    "signal": 5,
    "tooltip": true
  },
  "custom/network_info": {
    "exec": "$HOME/.local/bin/waybar-network-info",
    "return-type": "json",
    // Signal 6 handles menu changes; polling catches external changes.
    "interval": 10,
    "signal": 6,
    // Left click opens network settings; right click opens Bluetooth.
    "on-click": "$HOME/.local/bin/rofi-network",
    "on-click-right": "$HOME/.local/bin/bluetooth-gui",
    "tooltip": true
  },
  "backlight": {
    "device": "amd_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip": false
  },
  "custom/systemd_failed": {
    "exec": "$HOME/.local/bin/waybar-systemd-failed",
    "return-type": "json",
    "interval": 10,
    "on-click": "setsid -f $HOME/.local/bin/rofi-keybinds",
    "tooltip": true
  },
  "tray": {}
}
