/* =========================================================================
   Waybar Theme – rendered from /etc/nixos/theme/templates/waybar.css.template
   ========================================================================= */

@define-color base __BASE__;
@define-color mantle __MANTLE__;
@define-color text __TEXT__;
@define-color subtext __SUBTEXT__;
@define-color accent __ACCENT__;
@define-color success __SUCCESS__;
@define-color warning __WARNING__;
@define-color error __ERROR__;
@define-color purple __PURPLE__;
@define-color cyan __CYAN__;

/* -------------------------------------------------------------------------
   Signal palette — rendered from theme.signal, NOT from theme.colors, and
   therefore never touched by the wallpaper-driven generator.

   CONTRACT: every rule that encodes a state, a severity step, or an indicator
   line (border-top / border-bottom) must reference a @signal-* color only.
   The colors above are decorative and may change with the wallpaper; using one
   of them for a warning silently repaints the warning.
   ------------------------------------------------------------------------- */
@define-color signal-ok __SIGNAL_OK__;
@define-color signal-notice __SIGNAL_NOTICE__;
@define-color signal-warning __SIGNAL_WARNING__;
@define-color signal-critical __SIGNAL_CRITICAL__;
@define-color signal-eco __SIGNAL_ECO__;
@define-color signal-muted __SIGNAL_MUTED__;

@keyframes blink {
  to {
    background-color: @signal-critical;
    color: @base;
  }
}

@keyframes pulse-critical {
  from {
    background-color: @signal-critical;
    color: @base;
  }
  to {
    background-color: alpha(@signal-critical, 0.15);
    color: @text;
  }
}

* {
  border: none;
  border-radius: 0;
  padding: 0 5px;
  margin: 0;
  font-family: "__UI_FONT__", monospace;
  font-weight: bold;
  font-size: __UI_FONT_SIZE__px;
  background: transparent;
  color: @text;
  transition: none;
}

window#waybar {
  background: @base;
  border-bottom: 1px solid alpha(@text, 0.1);
  min-height: 28px;
}

#workspaces button,
#clock,
#clock.time,
#clock.calendar,
#tray,
#pulseaudio,
#custom-screen_time,
#custom-memory_info,
#custom-network_info,
#custom-apu_info,
#custom-power_flow,
#custom-refresh_rate,
#custom-atomic_note,
#backlight,
#idle_inhibitor,
#custom-systemd_failed,
tooltip,
menuitem,
.popup menuitem {
  margin: 0;
  padding-left: 10px;
  padding-right: 10px;
  font-family: "__UI_FONT__", monospace;
  font-weight: bold;
  font-size: __UI_FONT_SIZE__px;
}

#workspaces button,
#clock,
#clock.time,
#clock.calendar,
#tray,
#pulseaudio,
#custom-screen_time,
#custom-memory_info,
#custom-network_info,
#custom-apu_info,
#custom-power_flow,
#custom-refresh_rate,
#custom-atomic_note,
#backlight,
#idle_inhibitor,
#custom-systemd_failed {
  border-radius: 0;
  padding-top: 0;
  padding-bottom: 0;
}

#workspaces button {
  color: @subtext;
}

#workspaces button.focused {
  color: @accent;
  background: alpha(@text, 0.05);
  border-bottom: 2px solid @accent;
}

#workspaces button:hover {
  background: alpha(@text, 0.1);
  color: @text;
}

#clock,
#clock.time,
#clock.calendar,
#tray,
#pulseaudio,
#custom-screen_time,
#custom-memory_info,
#custom-network_info,
#custom-apu_info,
#custom-power_flow,
#custom-refresh_rate,
#custom-atomic_note,
#backlight,
#idle_inhibitor,
#custom-systemd_failed {
  background: alpha(@text, 0.05);
  border-left: 1px solid alpha(@text, 0.05);
}

tooltip,
menu,
.menu,
.popup {
  background-color: @mantle;
  color: @text;
  border: 1px solid @accent;
  border-radius: 6px;
}

tooltip label {
  font-family: "JetBrainsMono Nerd Font Mono", monospace;
  font-weight: normal;
  padding: 0;
}

#clock tooltip label,
#clock.calendar tooltip label {
  font-family: "JetBrainsMono Nerd Font Mono", monospace;
  font-weight: normal;
  font-size: 15px;
}

tooltip label,
menu *,
.menu *,
.popup * {
  color: @text;
  font-size: __UI_FONT_SIZE__px;
}

menuitem,
.popup menuitem {
  padding-top: 6px;
  padding-bottom: 6px;
  border-radius: 4px;
}

#clock:hover,
#clock.time:hover,
#clock.calendar:hover,
#tray:hover,
#pulseaudio:hover,
#custom-screen_time:hover,
#custom-memory_info:hover,
#custom-network_info:hover,
#custom-apu_info:hover,
#custom-power_flow:hover,
#custom-refresh_rate:hover,
#custom-atomic_note:hover,
#backlight:hover,
#idle_inhibitor:hover,
#custom-systemd_failed:hover,
#workspaces button:hover,
menuitem:hover,
.popup menuitem:hover {
  background: alpha(@text, 0.1);
  color: @text;
}

#custom-apu_info.warm {
  color: @signal-warning;
}

#custom-apu_info.hot {
  color: @signal-critical;
  font-weight: bold;
}

#custom-apu_info.critical {
  animation-name: pulse-critical;
  animation-duration: 0.8s;
  animation-direction: alternate;
  animation-iteration-count: infinite;
}

/* Upper line = power draw, lower line = battery state. Both fire at once on
   this module, so the two tokens must stay visually distinct. */
#custom-power_flow.charging {
  color: @signal-eco;
  border-bottom: 2px solid @signal-eco;
}

#custom-power_flow.medium {
  border-top: 2px solid @signal-warning;
}

#custom-power_flow.high {
  color: @signal-critical;
  border-top: 2px solid @signal-critical;
}

#custom-power_flow.critical {
  color: @signal-critical;
  border-bottom: 2px solid @signal-critical;
}

#custom-memory_info.warning {
  color: @signal-warning;
}

#custom-memory_info.critical {
  color: @signal-critical;
  font-weight: bold;
}

#custom-network_info.disconnected,
#custom-network_info.disabled {
  color: @signal-muted;
}

#custom-network_info.ethernet {
  color: @signal-notice;
}

#pulseaudio.muted {
  color: @signal-muted;
}

#custom-screen_time.studying {
  color: @signal-eco;
  border-bottom: 2px solid @signal-eco;
}

#custom-screen_time.medium {
  color: @signal-warning;
}

#custom-screen_time.high {
  color: @signal-critical;
  border-bottom: 2px solid @signal-critical;
}

#custom-screen_time.idle {
  color: @signal-muted;
}

#clock.calendar {
  color: @accent;
}

tooltip {
  padding-top: 6px;
  padding-bottom: 6px;
}

menu,
.menu,
.popup {
  margin: 0;
  padding: 4px 0;
}

#custom-atomic_note {
  color: @accent;
}

/* Four-step ladder on one lower line: keep every step on its own signal token
   so low/moderate never collapse into the same hue. */
#custom-atomic_note.critical,
#custom-atomic_note.urgent {
  color: @signal-critical;
  border-bottom: 2px solid @signal-critical;
}

#custom-atomic_note.high,
#custom-atomic_note.warning {
  color: @signal-warning;
  border-bottom: 2px solid @signal-warning;
}

#custom-atomic_note.moderate {
  color: @signal-notice;
  border-bottom: 2px solid @signal-notice;
}

#custom-atomic_note.low {
  color: @signal-ok;
  border-bottom: 2px solid @signal-ok;
}

#custom-atomic_note.empty {
  color: @signal-muted;
}

#custom-systemd_failed.failed {
  color: @signal-critical;
  font-weight: bold;
  animation-name: blink;
  animation-duration: 0.8s;
  animation-direction: alternate;
  animation-iteration-count: infinite;
}

/* The healthy state is deliberately visible. If it rendered as nothing, a
   module that died or could not query systemd would be indistinguishable from
   one reporting all-clear — absence must never read as good news. */
#custom-systemd_failed.ok {
  color: @signal-ok;
  opacity: 0.45;
}

#custom-systemd_failed.unknown {
  color: @signal-warning;
  border-bottom: 2px solid @signal-warning;
}
