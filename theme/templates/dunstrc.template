# Keep upstream layout defaults; theme-apply renders colors and reloads Dunst.

[global]
    # Urgency sections override this fallback frame.
    frame_color = "__SIGNAL_NOTICE__"
    separator_color = frame

    # Scale the summary relative to the configured font.
    format = "<big><b>%s</b></big>\n%b"

    # Progress indicates a value, so it may use a decorative color.
    highlight = "__ACCENT__"

# Use fixed signal colors for urgency; backgrounds may follow the wallpaper.

[urgency_low]
    background = "__MANTLE__"
    foreground = "__SUBTEXT__"
    frame_color = "__SIGNAL_MUTED__"

[urgency_normal]
    background = "__MANTLE__"
    foreground = "__TEXT__"
    frame_color = "__SIGNAL_NOTICE__"

[urgency_critical]
    background = "__MANTLE__"
    foreground = "__TEXT__"
    frame_color = "__SIGNAL_CRITICAL__"
