* {
  base: __BASE__;
  mantle: __MANTLE__;
  text: __TEXT__;
  subtext: __SUBTEXT__;
  accent: __ACCENT__;
  success: __SUCCESS__;
  warning: __WARNING__;
  error: __ERROR__;
  purple: __PURPLE__;
  cyan: __CYAN__;

  /* Signal palette: from theme.signal, never wallpaper-derived. Only these may
     encode a state or a severity. */
  signal-ok: __SIGNAL_OK__;
  signal-notice: __SIGNAL_NOTICE__;
  signal-warning: __SIGNAL_WARNING__;
  signal-critical: __SIGNAL_CRITICAL__;
  signal-eco: __SIGNAL_ECO__;
  signal-muted: __SIGNAL_MUTED__;

  /* Stable dark-theme surfaces; decorative colours remain wallpaper-derived. */
  outline: rgba(255, 255, 255, 0.10);
  outline-soft: rgba(255, 255, 255, 0.08);
  overlay: rgba(255, 255, 255, 0.05);
  window-bg: #__BASE_STRIP__F0;
  panel-bg: #__MANTLE_STRIP__EB;
  accent-soft: #__ACCENT_STRIP__24;

  background-color: transparent;
  text-color: @text;
  /* Pango points, from theme.fonts.rofi.size — not theme.fonts.ui.size, which
     Waybar consumes as CSS pixels. Sharing that number rendered every menu
     about a third too large. */
  font: "__UI_FONT__ __ROFI_FONT_SIZE__";
  mono-font: "__MONO_FONT__ __ROFI_FONT_SIZE__";
  mono-font-label: "__MONO_FONT__ __ROFI_FONT_LABEL_SIZE__";
  mono-font-subtitle: "__MONO_FONT__ __ROFI_FONT_SUBTITLE_SIZE__";
  mono-font-calendar: "__MONO_FONT__ __ROFI_FONT_CALENDAR_SIZE__";
  mono-font-value: "__MONO_FONT__ Bold __ROFI_FONT_VALUE_SIZE__";
  mono-font-title: "__MONO_FONT__ Bold __ROFI_FONT_TITLE_SIZE__";
}

window {
  width:            45%;
  border:           1px;
  border-color:     @accent;
  border-radius:    14px;
  background-color: @window-bg;
  padding:          12px;
}

mainbox {
  spacing:          7px;
  padding:          8px;
  children:         [ inputbar, message, listview ];
  background-color: transparent;
}

inputbar {
  enabled:          true;
  margin:           0 0 8px 0;
  spacing:          8px;
  padding:          6px 7px;
  border:           1px;
  border-color:     @outline-soft;
  border-radius:    10px;
  children:         [ prompt, entry ];
  background-color: @panel-bg;
}

prompt {
  background-color: @accent;
  text-color:       @base;
  padding:          4px 10px;
  border-radius:    8px;
  font:             "__MONO_FONT__ Bold __ROFI_FONT_SIZE__";
}

entry {
  text-color:       @text;
  font:             @mono-font;
  placeholder:      "Search...";
  placeholder-color: @subtext;
  vertical-align:   0.5;
  padding:          0 6px;
}

message {
  enabled:          true;
  margin:           4px 0;
  padding:          10px;
  border-radius:    10px;
  background-color: @panel-bg;
  text-color:       @text;
}

textbox {
  markup:           true;
  text-color:       @text;
  background-color: transparent;
}

listview {
  lines:            8;
  columns:          1;
  fixed-height:     false;
  spacing:          6px;
  scrollbar:        false;
  background-color: transparent;
  padding:          0px;
}

element {
  spacing:          10px;
  padding:          7px 10px;
  margin:           0px;
  border:           1px;
  border-color:     transparent;
  border-radius:    10px;
  background-color: transparent;
  text-color:       @text;
  children:         [ element-icon, element-text ];
}

element selected {
  border-color:     @accent;
  background-color: @accent;
  text-color:       @base;
}

element-icon {
  size:             1.2em;
  background-color: transparent;
  vertical-align:   0.0;
}

element-text {
  markup:           true;
  text-color:       inherit;
  vertical-align:   0.0;
}

error-message {
  padding: 10px;
  border-radius: 8px;
  border: 1px;
  border-color: @signal-critical;
  background-color: @mantle;
  text-color: @signal-critical;
}
