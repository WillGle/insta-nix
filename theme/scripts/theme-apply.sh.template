#!__BASH_BIN__
# shellcheck shell=bash
set -euo pipefail

MATUGEN_BIN="__MATUGEN_BIN__"
JQ_BIN="__JQ_BIN__"
SED_BIN="__SED_BIN__"
MKTEMP_BIN="__MKTEMP_BIN__"
MKDIR_BIN="__MKDIR_BIN__"
MV_BIN="__MV_BIN__"
RM_BIN="__RM_BIN__"
CMP_BIN="__CMP_BIN__"
SYSTEMCTL_BIN="__SYSTEMCTL_BIN__"
LS_BIN="__LS_BIN__"
HEAD_BIN="__HEAD_BIN__"
HYPRCTL_BIN="__HYPRCTL_BIN__"
DUNSTCTL_BIN="__DUNSTCTL_BIN__"
SHA256_BIN="__SHA256_BIN__"
CAT_BIN="__CAT_BIN__"
OD_BIN="__OD_BIN__"
TR_BIN="__TR_BIN__"
GREP_BIN="__GREP_BIN__"
FLOCK_BIN="__FLOCK_BIN__"
TIMEOUT_BIN="__TIMEOUT_BIN__"

STATIC_ENV="__THEME_STATIC_ENV__"

if [ ! -f "$STATIC_ENV" ]; then
  exit 0
fi

# shellcheck disable=SC1090
. "$STATIC_ENV"

if [ "${THEME_RUNTIME_ENABLE:-0}" != "1" ]; then
  exit 0
fi

log() {
  printf '[theme-apply] %s\n' "$*" >&2
}

# Keep state and severity colors fixed to theme.signal.
for _signal_var in \
  THEME_SIGNAL_OK THEME_SIGNAL_NOTICE THEME_SIGNAL_WARNING \
  THEME_SIGNAL_CRITICAL THEME_SIGNAL_ECO THEME_SIGNAL_MUTED; do
  if [ -z "${!_signal_var:-}" ]; then
    log "missing $_signal_var in $STATIC_ENV; refusing to render an unsignalled theme"
    exit 1
  fi
done
unset _signal_var

readonly SIGNAL_OK="$THEME_SIGNAL_OK"
readonly SIGNAL_NOTICE="$THEME_SIGNAL_NOTICE"
readonly SIGNAL_WARNING="$THEME_SIGNAL_WARNING"
readonly SIGNAL_CRITICAL="$THEME_SIGNAL_CRITICAL"
readonly SIGNAL_ECO="$THEME_SIGNAL_ECO"
readonly SIGNAL_MUTED="$THEME_SIGNAL_MUTED"

usage() {
  "$CAT_BIN" >&2 <<'EOF'
usage: theme-apply [--wallpaper PATH] [--strict] [--force]

  --wallpaper PATH  generate the theme from PATH instead of the stored selection
  --strict          never fall back to the static palette; fail without touching
                    the previous wallpaper, generated theme or live applications
  --force           regenerate even when the inputs are unchanged
EOF
}

OPT_WALLPAPER=""
OPT_STRICT=0
OPT_FORCE=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --wallpaper)
      [ "$#" -ge 2 ] || { usage; exit 2; }
      OPT_WALLPAPER="$2"
      shift 2
      ;;
    --strict)
      OPT_STRICT=1
      shift
      ;;
    --force)
      OPT_FORCE=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      log "unknown argument: $1"
      usage
      exit 2
      ;;
  esac
done

"$MKDIR_BIN" -p "$THEME_GENERATED_DIR" "$THEME_STATE_DIR" "$THEME_WALLPAPER_STORE"

# Serialize generations without changing argv; release the lock on exit.
exec 9>>"$THEME_LOCK_FILE"
if ! "$FLOCK_BIN" -w 60 9; then
  log "another theme-apply run still holds $THEME_LOCK_FILE after 60s"
  exit 1
fi

# Stage on the same filesystem for atomic per-file renames.
STAGE_DIR="$("$MKTEMP_BIN" -d "$THEME_GENERATED_DIR/.stage.XXXXXX")"
trap '"$RM_BIN" -rf "$STAGE_DIR"' EXIT INT TERM

GENERATED_OUTPUTS="waybar.css rofi.rasi hyprlock.conf hyprland-decoration.conf nvim-matugen.lua hyprpaper.conf dunstrc palette.json"

escape_sed() {
  printf '%s' "$1" | "$SED_BIN" 's/[\/&]/\\&/g'
}

strip_hex() {
  printf '%s' "${1#\#}"
}

# Check extension and magic bytes; Matugen rejects corrupt images.
__IS_SUPPORTED_IMAGE__

have_previous_theme() {
  local name
  for name in $GENERATED_OUTPUTS; do
    [ -s "$THEME_GENERATED_DIR/$name" ] || return 1
  done
}

# Identity of everything that can change the rendered output.
compute_stamp() {
  {
    printf '%s\n' "${THEME_GENERATOR_VERSION:-v0}"
    printf '%s\n' "$WALLPAPER"
    "$SHA256_BIN" "$WALLPAPER"
    "$SHA256_BIN" "$STATIC_ENV"
    "$SHA256_BIN" "$THEME_TEMPLATE_DIR"/*.template
  } | "$SHA256_BIN" | "$SED_BIN" 's/ .*//'
}

set_fallback_palette() {
  BASE="$THEME_STATIC_BASE"
  MANTLE="$THEME_STATIC_MANTLE"
  TEXT="$THEME_STATIC_TEXT"
  SUBTEXT="$THEME_STATIC_SUBTEXT"
  ACCENT="$THEME_STATIC_ACCENT"
  SUCCESS="$THEME_STATIC_SUCCESS"
  WARNING="$THEME_STATIC_WARNING"
  ERROR="$THEME_STATIC_ERROR"
  PURPLE="$THEME_STATIC_PURPLE"
  CYAN="$THEME_STATIC_CYAN"
}

set_dynamic_palette() {
  local palette_tmp="$1"
  local base mantle text subtext accent success warning error purple cyan

  # Supply an index to avoid Matugen 4 prompts; use it only for palette data.
  if ! "$TIMEOUT_BIN" 45 "$MATUGEN_BIN" image "$WALLPAPER" \
    --source-color-index 0 --dry-run -m dark -j hex -q > "$palette_tmp"; then
    return 1
  fi

  base="$("$JQ_BIN" -r '.colors.surface.default.color' "$palette_tmp")"
  mantle="$("$JQ_BIN" -r '.colors.surface_container.default.color' "$palette_tmp")"
  text="$("$JQ_BIN" -r '.colors.on_surface.default.color' "$palette_tmp")"
  subtext="$("$JQ_BIN" -r '.colors.on_surface_variant.default.color' "$palette_tmp")"
  accent="$("$JQ_BIN" -r '.colors.primary.default.color' "$palette_tmp")"
  success="$("$JQ_BIN" -r '.colors.secondary.default.color' "$palette_tmp")"
  warning="$("$JQ_BIN" -r '.colors.tertiary.default.color' "$palette_tmp")"
  error="$("$JQ_BIN" -r '.colors.error.default.color' "$palette_tmp")"
  # Use tone 70 for secondary accents to distinguish them from tone 80 roles.
  purple="$("$JQ_BIN" -r '.palettes.tertiary."70".color' "$palette_tmp")"
  cyan="$("$JQ_BIN" -r '.palettes.secondary."70".color' "$palette_tmp")"

  for value in "$base" "$mantle" "$text" "$subtext" "$accent" "$success" "$warning" "$error" "$purple" "$cyan"; do
    if [[ ! "$value" =~ ^#[[:xdigit:]]{6}$ ]]; then
      return 1
    fi
  done

  BASE="$base"
  MANTLE="$mantle"
  TEXT="$text"
  SUBTEXT="$subtext"
  ACCENT="$accent"
  SUCCESS="$success"
  WARNING="$warning"
  ERROR="$error"
  PURPLE="$purple"
  CYAN="$cyan"

  # Include the fixed signal colors in the rendered palette dump.
  annotate_palette_signal "$palette_tmp"
}

# $ok and similar names are jq variables, not shell expansions.
# shellcheck disable=SC2016
annotate_palette_signal() {
  local file="$1"
  local tmp="$file.signal"

  if "$JQ_BIN" \
    --arg ok "$SIGNAL_OK" \
    --arg notice "$SIGNAL_NOTICE" \
    --arg warning "$SIGNAL_WARNING" \
    --arg critical "$SIGNAL_CRITICAL" \
    --arg eco "$SIGNAL_ECO" \
    --arg muted "$SIGNAL_MUTED" \
    '. + {signal: {ok: $ok, notice: $notice, warning: $warning, critical: $critical, eco: $eco, muted: $muted}}' \
    "$file" > "$tmp"; then
    "$MV_BIN" "$tmp" "$file"
  else
    "$RM_BIN" -f "$tmp"
  fi
}

write_fallback_palette_json() {
  local output="$1"
  "$CAT_BIN" > "$output" <<EOF
{
  "source": "static-fallback",
  "colors": {
    "base": "$THEME_STATIC_BASE",
    "mantle": "$THEME_STATIC_MANTLE",
    "text": "$THEME_STATIC_TEXT",
    "subtext": "$THEME_STATIC_SUBTEXT",
    "accent": "$THEME_STATIC_ACCENT",
    "success": "$THEME_STATIC_SUCCESS",
    "warning": "$THEME_STATIC_WARNING",
    "error": "$THEME_STATIC_ERROR",
    "purple": "$THEME_STATIC_PURPLE",
    "cyan": "$THEME_STATIC_CYAN"
  },
  "signal": {
    "ok": "$SIGNAL_OK",
    "notice": "$SIGNAL_NOTICE",
    "warning": "$SIGNAL_WARNING",
    "critical": "$SIGNAL_CRITICAL",
    "eco": "$SIGNAL_ECO",
    "muted": "$SIGNAL_MUTED"
  }
}
EOF
}

render_template() {
  local input="$1"
  local output="$2"

  "$SED_BIN" \
    -e "s/__BASE__/$(escape_sed "$BASE")/g" \
    -e "s/__MANTLE__/$(escape_sed "$MANTLE")/g" \
    -e "s/__TEXT__/$(escape_sed "$TEXT")/g" \
    -e "s/__SUBTEXT__/$(escape_sed "$SUBTEXT")/g" \
    -e "s/__ACCENT__/$(escape_sed "$ACCENT")/g" \
    -e "s/__SUCCESS__/$(escape_sed "$SUCCESS")/g" \
    -e "s/__WARNING__/$(escape_sed "$WARNING")/g" \
    -e "s/__ERROR__/$(escape_sed "$ERROR")/g" \
    -e "s/__PURPLE__/$(escape_sed "$PURPLE")/g" \
    -e "s/__CYAN__/$(escape_sed "$CYAN")/g" \
    -e "s/__BASE_STRIP__/$(escape_sed "$(strip_hex "$BASE")")/g" \
    -e "s/__MANTLE_STRIP__/$(escape_sed "$(strip_hex "$MANTLE")")/g" \
    -e "s/__TEXT_STRIP__/$(escape_sed "$(strip_hex "$TEXT")")/g" \
    -e "s/__ACCENT_STRIP__/$(escape_sed "$(strip_hex "$ACCENT")")/g" \
    -e "s/__PURPLE_STRIP__/$(escape_sed "$(strip_hex "$PURPLE")")/g" \
    -e "s/__SIGNAL_OK__/$(escape_sed "$SIGNAL_OK")/g" \
    -e "s/__SIGNAL_NOTICE__/$(escape_sed "$SIGNAL_NOTICE")/g" \
    -e "s/__SIGNAL_WARNING__/$(escape_sed "$SIGNAL_WARNING")/g" \
    -e "s/__SIGNAL_CRITICAL__/$(escape_sed "$SIGNAL_CRITICAL")/g" \
    -e "s/__SIGNAL_ECO__/$(escape_sed "$SIGNAL_ECO")/g" \
    -e "s/__SIGNAL_MUTED__/$(escape_sed "$SIGNAL_MUTED")/g" \
    -e "s/__UI_FONT__/$(escape_sed "$THEME_UI_FONT")/g" \
    -e "s/__UI_FONT_SIZE__/$(escape_sed "$THEME_UI_FONT_SIZE")/g" \
    -e "s/__ROFI_FONT_SIZE__/$(escape_sed "$THEME_ROFI_FONT_SIZE")/g" \
    -e "s/__ROFI_FONT_LABEL_SIZE__/$(escape_sed "$THEME_ROFI_FONT_LABEL_SIZE")/g" \
    -e "s/__ROFI_FONT_SUBTITLE_SIZE__/$(escape_sed "$THEME_ROFI_FONT_SUBTITLE_SIZE")/g" \
    -e "s/__ROFI_FONT_CALENDAR_SIZE__/$(escape_sed "$THEME_ROFI_FONT_CALENDAR_SIZE")/g" \
    -e "s/__ROFI_FONT_VALUE_SIZE__/$(escape_sed "$THEME_ROFI_FONT_VALUE_SIZE")/g" \
    -e "s/__ROFI_FONT_TITLE_SIZE__/$(escape_sed "$THEME_ROFI_FONT_TITLE_SIZE")/g" \
    -e "s/__MONO_FONT__/$(escape_sed "$THEME_MONO_FONT")/g" \
    -e "s/__LOCK_FONT__/$(escape_sed "$THEME_LOCK_FONT")/g" \
    -e "s/__LOCK_FONT_BOLD__/$(escape_sed "$THEME_LOCK_FONT_BOLD")/g" \
    -e "s/__LOCK_CLOCK_SIZE__/$(escape_sed "$THEME_LOCK_CLOCK_SIZE")/g" \
    -e "s/__LOCK_TEXT_SIZE__/$(escape_sed "$THEME_LOCK_TEXT_SIZE")/g" \
    -e "s/__WALLPAPER_PATH__/$(escape_sed "$WALLPAPER")/g" \
    "$input" > "$output"
}

# Reject missing signal colors or unresolved placeholders before committing.
verify_signal_palette() {
  local file="$1"
  local color

  if "$GREP_BIN" -q '__SIGNAL_[A-Z_]*__' "$file"; then
    log "unsubstituted signal placeholder left in $(basename "$file")"
    return 1
  fi

  for color in "$SIGNAL_OK" "$SIGNAL_NOTICE" "$SIGNAL_WARNING" \
    "$SIGNAL_CRITICAL" "$SIGNAL_ECO" "$SIGNAL_MUTED"; do
    if ! "$GREP_BIN" -qiF "$color" "$file"; then
      log "signal color $color missing from $(basename "$file")"
      return 1
    fi
  done
}

# Dunst uses only three signal colors; reject unresolved placeholders.
verify_no_placeholder() {
  local file="$1"

  if "$GREP_BIN" -q '__[A-Z][A-Z_]*__' "$file"; then
    log "unsubstituted placeholder left in $(basename "$file")"
    return 1
  fi
}

# Argument 3 is the changed-output flag, or "-" when no reload is needed.
apply_if_changed() {
  local src="$1"
  local dest="$2"
  local changed_var="$3"

  if [ ! -f "$dest" ] || ! "$CMP_BIN" -s "$src" "$dest"; then
    "$MV_BIN" "$src" "$dest"
    if [ "$changed_var" != "-" ]; then
      printf -v "$changed_var" '1'
    fi
  else
    "$RM_BIN" -f "$src"
  fi
}

# Persist the selection only once the generation it produced has been committed.
store_selection() {
  local tmp
  [ -n "$OPT_WALLPAPER" ] || return 0
  tmp="$("$MKTEMP_BIN" "$THEME_STATE_DIR/.wallpaper.XXXXXX")"
  printf '%s\n' "$WALLPAPER" > "$tmp"
  "$MV_BIN" "$tmp" "$THEME_WALLPAPER_POINTER"
}

# Use the current socket path, with a fallback for Hyprland before 0.41.
ensure_hypr_signature() {
  local dir candidate

  [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || return 0

  for dir in "${XDG_RUNTIME_DIR:-}/hypr" /tmp/hypr; do
    [ "$dir" != "/hypr" ] || continue
    [ -d "$dir" ] || continue
    candidate="$("$LS_BIN" -1t "$dir" 2>/dev/null | "$HEAD_BIN" -n1 || true)"
    if [ -n "$candidate" ]; then
      HYPRLAND_INSTANCE_SIGNATURE="$candidate"
      export HYPRLAND_INSTANCE_SIGNATURE
      return 0
    fi
  done
}

# If Hyprland or hyprpaper is stopped, load this config on its next start.
sync_hyprpaper() {
  ensure_hypr_signature
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || return 0

  # Hyprpaper 0.8 uses a single request; preload/unload/listloaded were removed.
  if ! "$HYPRCTL_BIN" hyprpaper wallpaper ",$WALLPAPER,cover"; then
    log "hyprpaper refused to display $WALLPAPER"
    return 1
  fi
}

# Resolve wallpaper.

PALETTE_SOURCE="dynamic"

if [ -n "$OPT_WALLPAPER" ]; then
  WALLPAPER="$OPT_WALLPAPER"
  if ! is_supported_image "$WALLPAPER"; then
    log "not a readable jpg/jpeg/png/webp image: $WALLPAPER"
    exit 1
  fi
else
  WALLPAPER=""
  if [ -s "$THEME_WALLPAPER_POINTER" ]; then
    WALLPAPER="$("$HEAD_BIN" -n1 "$THEME_WALLPAPER_POINTER")"
  fi
  if [ -z "$WALLPAPER" ] || ! is_supported_image "$WALLPAPER"; then
    WALLPAPER="$THEME_WALLPAPER"
  fi
  if ! is_supported_image "$WALLPAPER"; then
    log "wallpaper not found, using static fallback palette"
    PALETTE_SOURCE="fallback"
  fi
fi

# Skip unchanged input.

STAMP_FILE="$THEME_GENERATED_DIR/stamp"
STAMP=""

if [ "$PALETTE_SOURCE" = "dynamic" ]; then
  STAMP="$(compute_stamp)"
  if [ "$OPT_FORCE" -eq 0 ] && have_previous_theme && [ -s "$STAMP_FILE" ] \
    && [ "$STAMP" = "$("$HEAD_BIN" -n1 "$STAMP_FILE")" ]; then
    store_selection
    exit 0
  fi
fi

# Stage the generation.

PALETTE_TMP="$STAGE_DIR/palette.json"

if [ "$PALETTE_SOURCE" = "dynamic" ]; then
  if ! set_dynamic_palette "$PALETTE_TMP"; then
    if [ "$OPT_STRICT" -eq 1 ] || have_previous_theme; then
      log "matugen failed or returned an invalid palette, keeping the previous theme"
      exit 1
    fi
    log "matugen failed or returned an invalid palette, using static fallback palette"
    PALETTE_SOURCE="fallback"
  fi
fi

if [ "$PALETTE_SOURCE" = "fallback" ]; then
  set_fallback_palette
  write_fallback_palette_json "$PALETTE_TMP"
fi

render_template "$THEME_TEMPLATE_DIR/waybar.css.template" "$STAGE_DIR/waybar.css"
render_template "$THEME_TEMPLATE_DIR/rofi.rasi.template" "$STAGE_DIR/rofi.rasi"
render_template "$THEME_TEMPLATE_DIR/hyprlock.conf.template" "$STAGE_DIR/hyprlock.conf"
render_template "$THEME_TEMPLATE_DIR/hyprland-decoration.conf.template" "$STAGE_DIR/hyprland-decoration.conf"
render_template "$THEME_TEMPLATE_DIR/nvim-colors.lua.template" "$STAGE_DIR/nvim-matugen.lua"
render_template "$THEME_TEMPLATE_DIR/hyprpaper.conf.template" "$STAGE_DIR/hyprpaper.conf"
render_template "$THEME_TEMPLATE_DIR/dunstrc.template" "$STAGE_DIR/dunstrc"

verify_signal_palette "$STAGE_DIR/waybar.css"
verify_no_placeholder "$STAGE_DIR/dunstrc"

# Commit the generation.

# Track changes only for live reloads; refresh hyprpaper using the content stamp.
waybar_changed=0
hyprland_changed=0
dunst_changed=0

apply_if_changed "$STAGE_DIR/waybar.css" "$THEME_GENERATED_DIR/waybar.css" waybar_changed
apply_if_changed "$STAGE_DIR/rofi.rasi" "$THEME_GENERATED_DIR/rofi.rasi" -
apply_if_changed "$STAGE_DIR/hyprlock.conf" "$THEME_GENERATED_DIR/hyprlock.conf" -
apply_if_changed "$STAGE_DIR/hyprland-decoration.conf" "$THEME_GENERATED_DIR/hyprland-decoration.conf" hyprland_changed
apply_if_changed "$STAGE_DIR/nvim-matugen.lua" "$THEME_GENERATED_DIR/nvim-matugen.lua" -
apply_if_changed "$STAGE_DIR/dunstrc" "$THEME_GENERATED_DIR/dunstrc" dunst_changed
apply_if_changed "$STAGE_DIR/hyprpaper.conf" "$THEME_GENERATED_DIR/hyprpaper.conf" -
apply_if_changed "$PALETTE_TMP" "$THEME_GENERATED_DIR/palette.json" -

store_selection

if [ -n "$STAMP" ]; then
  printf '%s\n' "$STAMP" > "$STAGE_DIR/stamp"
  "$MV_BIN" "$STAGE_DIR/stamp" "$STAMP_FILE"
else
  "$RM_BIN" -f "$STAMP_FILE"
fi

# Reloads are best effort: committed files must not be rolled back on reload failure.

if [ "$waybar_changed" -eq 1 ] && "$SYSTEMCTL_BIN" --user is-active --quiet waybar.service; then
  if ! "$SYSTEMCTL_BIN" --user reload waybar.service; then
    log "waybar is running but did not reload; the new style applies on its next restart"
  fi
fi

if [ "$hyprland_changed" -eq 1 ]; then
  ensure_hypr_signature
  "$HYPRCTL_BIN" reload config-only >/dev/null 2>&1 || true
fi

# Reload without restarting Dunst or dropping queued notifications.
if [ "$dunst_changed" -eq 1 ]; then
  "$DUNSTCTL_BIN" reload >/dev/null 2>&1 || true
fi

# Always refresh after a stamp change: the same path may contain new image bytes.
sync_hyprpaper || true

if [ "$PALETTE_SOURCE" = "fallback" ]; then
  log "applied static fallback palette"
fi

exit 0
