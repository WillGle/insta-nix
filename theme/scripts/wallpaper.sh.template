#!__BASH_BIN__
# shellcheck shell=bash
set -euo pipefail

THEME_APPLY_BIN="__THEME_APPLY_BIN__"
CAT_BIN="__CAT_BIN__"
CP_BIN="__CP_BIN__"
FLOCK_BIN="__FLOCK_BIN__"
FIND_BIN="__FIND_BIN__"
GREP_BIN="__GREP_BIN__"
HEAD_BIN="__HEAD_BIN__"
MKDIR_BIN="__MKDIR_BIN__"
MKTEMP_BIN="__MKTEMP_BIN__"
MV_BIN="__MV_BIN__"
OD_BIN="__OD_BIN__"
READLINK_BIN="__READLINK_BIN__"
RM_BIN="__RM_BIN__"
ROFI_BIN="__ROFI_BIN__"
SHA256_BIN="__SHA256_BIN__"
SORT_BIN="__SORT_BIN__"
TR_BIN="__TR_BIN__"

STATIC_ENV="__THEME_STATIC_ENV__"

if [ ! -f "$STATIC_ENV" ]; then
  printf 'wallpaper: missing %s\n' "$STATIC_ENV" >&2
  exit 1
fi

# shellcheck disable=SC1090
. "$STATIC_ENV"

log() {
  printf 'wallpaper: %s\n' "$*" >&2
}

usage() {
  "$CAT_BIN" <<'EOF'
usage: wallpaper [command]

  pick          choose an image in Rofi from ~/Pictures/Wallpapers or an
                optional packaged fallback, then apply it (this is also what
                running `wallpaper` with no argument does)
                Put your own images in ~/Pictures/Wallpapers.
  set <image>   use <image> (jpg, jpeg, png or webp) as the wallpaper and
                regenerate the theme from it
  current       print the wallpaper currently in use
  reset         go back to the packaged fallback, when one is configured
  reapply       re-render and re-apply the current wallpaper
  help          show this message

The selected image is copied into the XDG state directory, so it survives
Home Manager and NixOS rebuilds and stays valid if the original is moved or
deleted.
EOF
}

# Check extension and magic bytes; Matugen rejects corrupt images before commit.
__IS_SUPPORTED_IMAGE__

current_wallpaper() {
  local stored=""

  if [ -s "$THEME_WALLPAPER_POINTER" ]; then
    stored="$("$HEAD_BIN" -n1 "$THEME_WALLPAPER_POINTER")"
  fi
  if [ -n "$stored" ] && [ -r "$stored" ]; then
    printf '%s\n' "$stored"
  elif is_supported_image "$THEME_WALLPAPER"; then
    printf '%s\n' "$THEME_WALLPAPER"
  else
    log "no wallpaper is selected"
    return 1
  fi
}

# Use a separate store lock: sharing theme-apply's lock would deadlock its child.
lock_wallpaper_state() {
  "$MKDIR_BIN" -p "$THEME_STATE_DIR"
  exec 8>>"$THEME_WALLPAPER_LOCK_FILE"
  if ! "$FLOCK_BIN" -w 60 8; then
    log "another wallpaper change still holds $THEME_WALLPAPER_LOCK_FILE after 60s"
    exit 1
  fi
}

# Prune unreferenced copies only after successful generation.
prune_store() {
  local keep="$1" entry
  for entry in "$THEME_WALLPAPER_STORE"/*; do
    [ -f "$entry" ] || continue
    if [ "$entry" != "$keep" ]; then
      "$RM_BIN" -f "$entry"
    fi
  done
}

cmd_set() {
  local source="$1" resolved ext digest dest tmp existed=0

  resolved="$("$READLINK_BIN" -f -- "$source" 2>/dev/null || true)"
  if [ -z "$resolved" ] || [ ! -f "$resolved" ] || [ ! -r "$resolved" ]; then
    log "cannot read image: $source"
    exit 1
  fi

  if ! is_supported_image "$resolved"; then
    log "unsupported or invalid image (want jpg, jpeg, png or webp): $source"
    exit 1
  fi

  lock_wallpaper_state

  ext="${resolved##*.}"
  ext="${ext,,}"
  if [ "$ext" = "jpeg" ]; then
    ext="jpg"
  fi
  digest="$("$SHA256_BIN" -- "$resolved")"
  digest="${digest%% *}"
  dest="$THEME_WALLPAPER_STORE/$digest.$ext"

  "$MKDIR_BIN" -p "$THEME_WALLPAPER_STORE"

  if [ -f "$dest" ]; then
    existed=1
  else
    # Copy then rename within the store for atomic writes and safe digest filenames.
    tmp="$("$MKTEMP_BIN" "$THEME_WALLPAPER_STORE/.incoming.XXXXXX")"
    if ! "$CP_BIN" -- "$resolved" "$tmp"; then
      "$RM_BIN" -f "$tmp"
      log "failed to copy $source into $THEME_WALLPAPER_STORE"
      exit 1
    fi
    "$MV_BIN" "$tmp" "$dest"
  fi

  if ! "$THEME_APPLY_BIN" --wallpaper "$dest" --strict; then
    if [ "$existed" -eq 0 ]; then
      "$RM_BIN" -f "$dest"
    fi
    log "keeping the previous wallpaper and theme"
    exit 1
  fi

  prune_store "$dest"
  printf '%s\n' "$dest"
}

cmd_reset() {
  if ! is_supported_image "$THEME_WALLPAPER"; then
    log "no packaged default wallpaper is configured"
    exit 1
  fi

  lock_wallpaper_state

  # Drop the override only after success so future rebuilds follow the Nix default.
  if ! "$THEME_APPLY_BIN" --wallpaper "$THEME_WALLPAPER" --strict; then
    log "keeping the previous wallpaper and theme"
    exit 1
  fi
  "$RM_BIN" -f "$THEME_WALLPAPER_POINTER"
  prune_store ""
  printf '%s\n' "$THEME_WALLPAPER"
}

# Offer user wallpapers and the packaged file, never its Home Manager-owned directory.
collect_candidates() {
  local resolved entry

  CANDIDATES=()

  resolved="$("$READLINK_BIN" -f -- "${THEME_WALLPAPER_DROP_DIR:-$HOME/Pictures/Wallpapers}" 2>/dev/null || true)"
  if [ -n "$resolved" ] && [ -d "$resolved" ]; then
    while IFS= read -r -d '' entry; do
      is_supported_image "$entry" || continue
      CANDIDATES+=("$entry")
    done < <("$FIND_BIN" "$resolved" -maxdepth 1 -type f -print0 2>/dev/null | "$SORT_BIN" -z)
  fi

  if is_supported_image "$THEME_WALLPAPER"; then
    CANDIDATES+=("$THEME_WALLPAPER")
  fi
}

cmd_pick() {
  local entry choice
  local -a rofi_args=(
    -dmenu -i -no-custom -format i -p "Wallpaper"
    -theme-str 'window { width: 64%; }'
    -theme-str 'listview { columns: 3; lines: 5; }'
  )
  local icons=0

  collect_candidates

  if [ "${#CANDIDATES[@]}" -eq 0 ]; then
    log "no jpg/jpeg/png/webp images in ${THEME_WALLPAPER_DROP_DIR:-$HOME/Pictures/Wallpapers}"
    exit 1
  fi

  # Read all Rofi help output to avoid SIGPIPE under pipefail.
  if "$ROFI_BIN" -h 2>&1 | "$GREP_BIN" -- '-show-icons' >/dev/null; then
    icons=1
    rofi_args+=(-show-icons -theme-str 'element-icon { size: 2.5em; }')
  fi
  if [ -r "$HOME/.config/rofi/config.rasi" ]; then
    rofi_args+=(-config "$HOME/.config/rofi/config.rasi")
  fi

  # Use row indices rather than parsing labels; cancellation returns no selection.
  choice="$(
    for entry in "${CANDIDATES[@]}"; do
      if [ "$icons" -eq 1 ]; then
        printf '%s\0icon\x1f%s\n' "${entry##*/}" "$entry"
      else
        printf '%s\n' "${entry##*/}"
      fi
    done | "$ROFI_BIN" "${rofi_args[@]}"
  )" || return 0

  case "$choice" in
    '' | *[!0-9]*) return 0 ;;
  esac
  [ "$choice" -lt "${#CANDIDATES[@]}" ] || return 0

  cmd_set "${CANDIDATES[$choice]}"
}

cmd_reapply() {
  "$THEME_APPLY_BIN" --force
}

case "${1-}" in
  "" | pick)
    [ "$#" -le 1 ] || { usage >&2; exit 2; }
    cmd_pick
    ;;
  set)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    cmd_set "$2"
    ;;
  current)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    current_wallpaper
    ;;
  reset)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    cmd_reset
    ;;
  reapply)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    cmd_reapply
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
