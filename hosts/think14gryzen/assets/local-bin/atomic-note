#!/usr/bin/env bash
set -euo pipefail

# atomic-note — a small task queue on the waybar.
#
#   Storage   ~/.atomic_tasks, one task per line: "[Priority] body".
#   Order     shown by priority (critical → low), then file order; a new task
#             is prepended so it leads its group, "move to top" puts it first.
#   Undo      done/clear move the lines to ~/.atomic_tasks.done as
#             "<batch epoch><TAB>line"; `undo` (Alt+z in the menu) restores the
#             most recent batch.
#   Quick add one screen: a priority prefix in the text replaces the picker —
#             "!! …" critical · "! …" high · "- …" low · none = moderate ·
#             the "[critical] …" spelling still works.

TASK_FILE="${HOME}/.atomic_tasks"
TASK_LOCK_FILE="${TASK_FILE}.lock"
DONE_FILE="${TASK_FILE}.done"
ROFI_CONFIG="${HOME}/.config/rofi/config.rasi"
THEME_STATIC_ENV="${HOME}/.config/theme/static.env"

touch "$TASK_FILE"

if [ -r "$THEME_STATIC_ENV" ]; then
  # shellcheck disable=SC1090
  . "$THEME_STATIC_ENV"
fi

ACTION_FG="${THEME_STATIC_BASE:-#11111b}"
ACTION_ADD_BG="${THEME_STATIC_ACCENT:-#89b4fa}"
ACTION_OPEN_BG="${THEME_STATIC_CYAN:-#74c7ec}"
ACTION_CLEAR_BG="@signalCritical@"
ACTION_EDIT_BG="${THEME_STATIC_PURPLE:-#cba6f7}"
ACTION_MOVE_BG="${THEME_STATIC_WARNING:-#fab387}"
ACTION_CANCEL_BG="${THEME_STATIC_SUBTEXT:-#6c7086}"
SECTION_BG="${THEME_STATIC_MANTLE:-#161b22}"
SECTION_FG="${THEME_STATIC_TEXT:-#f0f6fc}"
INFO_FG="${THEME_STATIC_SUBTEXT:-#8b949e}"
TASK_CRITICAL_BG="@signalCritical@"
TASK_HIGH_BG="@signalWarning@"
TASK_MODERATE_BG="@signalNotice@"
TASK_LOW_BG="@signalOk@"
CHIP_ICON_FONT_DESC="@monoFont@ @rofiFontSize@"

# The generated Rofi theme follows the current wallpaper. Keep static.env as a
# fallback, but refresh decorative action colours once per menu invocation so
# the inline Pango markup and the Rasi containers stay aligned. Priority colours
# below remain pinned signal colours because they carry semantic meaning.
THEME_PALETTE_FILE="${THEME_GENERATED_DIR:-${XDG_CONFIG_HOME:-${HOME}/.config}/theme/generated}/palette.json"
load_runtime_palette() {
  local values=""
  local -a palette=()

  [ -r "$THEME_PALETTE_FILE" ] || return 0
  values="$(jq -er '
    [
      .colors.surface.default,
      .colors.surface_container.default,
      .colors.on_surface.default,
      .colors.on_surface_variant.default,
      .colors.primary.default,
      .colors.secondary.default,
      .colors.tertiary.default,
      .colors.error.default,
      .palettes.tertiary["70"],
      .palettes.secondary["70"]
    ] as $palette
    | if all($palette[]; type == "string" and test("^#[0-9A-Fa-f]{6}$"))
      then $palette | @tsv
      else error("invalid runtime palette")
      end
  ' "$THEME_PALETTE_FILE" 2>/dev/null
  )" || return 0

  IFS=$'\t' read -r -a palette <<< "$values"
  [ "${#palette[@]}" -eq 10 ] || return 0

  ACTION_FG="${palette[0]}"
  ACTION_ADD_BG="${palette[4]}"
  ACTION_OPEN_BG="${palette[9]}"
  ACTION_EDIT_BG="${palette[8]}"
  ACTION_MOVE_BG="${palette[6]}"
  ACTION_CANCEL_BG="${palette[3]}"
  SECTION_BG="${palette[1]}"
  SECTION_FG="${palette[2]}"
  INFO_FG="${palette[3]}"
}
load_runtime_palette

# Exact process name only: without -x the pattern also matched the waybar-*
# helper scripts running at that instant (waybar-memory-info every second,
# waybar-power-monitor…) and an RT signal terminates them, blanking their
# module for a refresh. Nix wraps the binary, so both names are tried.
refresh_waybar() {
  pkill -RTMIN+5 -x waybar >/dev/null 2>&1 || pkill -RTMIN+5 -x .waybar-wrapped >/dev/null 2>&1 || true
}

resolve_editor() {
  if [ -n "${EDITOR:-}" ]; then
    printf '%s\n' "$EDITOR"
    return 0
  fi

  if command -v nano >/dev/null 2>&1; then
    printf '%s\n' "nano"
    return 0
  fi

  printf '%s\n' "vi"
}

trim_whitespace() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s\n' "$value"
}

normalize_priority() {
  local raw="${1:-moderate}"
  raw="$(trim_whitespace "${raw,,}")"
  case "$raw" in
    critical|crit|p0|a)
      printf '%s\n' "critical"
      ;;
    high|p1|b)
      printf '%s\n' "high"
      ;;
    moderate|medium|med|normal|default|p2|c|"")
      printf '%s\n' "moderate"
      ;;
    low|p3|d)
      printf '%s\n' "low"
      ;;
    *)
      return 1
      ;;
  esac
}

priority_label() {
  case "$1" in
    critical) printf '%s\n' "Critical" ;;
    high)     printf '%s\n' "High" ;;
    moderate) printf '%s\n' "Moderate" ;;
    low)      printf '%s\n' "Low" ;;
  esac
}

priority_icon() {
  case "$1" in
    critical) printf '%s\n' "◆" ;;
    high)     printf '%s\n' "▲" ;;
    moderate) printf '%s\n' "●" ;;
    low)      printf '%s\n' "○" ;;
  esac
}

priority_bg() {
  case "$1" in
    critical) printf '%s\n' "$TASK_CRITICAL_BG" ;;
    high)     printf '%s\n' "$TASK_HIGH_BG" ;;
    moderate) printf '%s\n' "$TASK_MODERATE_BG" ;;
    low)      printf '%s\n' "$TASK_LOW_BG" ;;
  esac
}

# Sort key: lower is shown first.
priority_rank() {
  case "$1" in
    critical) printf '0\n' ;;
    high)     printf '1\n' ;;
    moderate) printf '2\n' ;;
    low)      printf '3\n' ;;
    *)        printf '2\n' ;;
  esac
}

task_priority() {
  local task="$1"
  local lower="${task,,}"
  case "$lower" in
    \[critical\]*|\[a\]*) printf '%s\n' "critical" ;;
    \[high\]*|\[b\]*)     printf '%s\n' "high" ;;
    \[moderate\]*|\[medium\]*|\[c\]*) printf '%s\n' "moderate" ;;
    \[low\]*|\[d\]*)      printf '%s\n' "low" ;;
    *)                    printf '%s\n' "moderate" ;;
  esac
}

task_body() {
  local task="$1"
  # Matched case-insensitively, and against the same tag set task_priority
  # accepts: a hand-edited "[critical] ..." must lose its prefix here too, or
  # the next edit re-wraps it into "[Critical] [critical] ...".
  if [[ "${task,,}" =~ ^\[(critical|high|moderate|medium|low|a|b|c|d)\][[:space:]]* ]]; then
    printf '%s\n' "${task:${#BASH_REMATCH[0]}}"
    return 0
  fi
  printf '%s\n' "$task"
}

format_task() {
  local body="$1"
  local priority="$2"
  body="$(trim_whitespace "$body")"
  if [ -z "$body" ]; then
    return 1
  fi
  printf '[%s] %s\n' "$(priority_label "$priority")" "$body"
}

# Quick-add syntax: a leading "!!" / "!" / "-" sets the priority so the picker
# is not needed; the "[critical] …" spelling is still honoured. Prints
# "<priority><TAB><body>".
parse_quick_add() {
  local text priority body
  text="$(trim_whitespace "$1")"
  case "$text" in
    '!!'*) priority="critical"; body="${text#!!}" ;;
    '!'*)  priority="high";     body="${text#!}" ;;
    '-'*)  priority="low";      body="${text#-}" ;;
    *)     priority="$(task_priority "$text")"; body="$(task_body "$text")" ;;
  esac
  printf '%s\t%s\n' "$priority" "$(trim_whitespace "$body")"
}

escape_markup() {
  local value="${1//&/"&amp;"}"
  value="${value//</"&lt;"}"
  value="${value//>/"&gt;"}"
  printf '%s\n' "$value"
}

rasi_quote() {
  jq -Rn --arg value "$1" '$value'
}

chip_label() {
  local icon="$1"
  local bg="$2"
  local label="$3"
  printf '<span bgcolor="%s" foreground="%s"><span font_desc="%s"> %s </span></span>  %s\n' \
    "$bg" \
    "$ACTION_FG" \
    "$(escape_markup "$CHIP_ICON_FONT_DESC")" \
    "$icon" \
    "$(escape_markup "$label")"
}

icon_chip() {
  local icon="$1"
  local bg="$2"
  printf '<span bgcolor="%s" foreground="%s"><span font_desc="%s"> %s </span></span>\n' \
    "$bg" \
    "$ACTION_FG" \
    "$(escape_markup "$CHIP_ICON_FONT_DESC")" \
    "$icon"
}

empty_task_label() {
  printf '<span foreground="%s" weight="600">No active tasks</span>  <span foreground="%s" size="small">Alt+a to add one</span>\n' \
    "$SECTION_FG" \
    "$INFO_FG"
}

task_label() {
  local task="$1"
  local priority body
  priority="$(task_priority "$task")"
  body="$(task_body "$task")"
  printf '%s  <span weight="600">%s</span>\n' \
    "$(icon_chip "$(priority_icon "$priority")" "$(priority_bg "$priority")")" \
    "$(escape_markup "$body")"
}

# ── prompts ──────────────────────────────────────────────────────────────────

quick_add_prompt() {
  printf '' | rofi -dmenu -p "Add" \
    -theme-str 'entry { placeholder: "Task…   !! critical · ! high · - low · none = moderate"; }' \
    -config "$ROFI_CONFIG"
}

select_priority() {
  local prompt="$1"
  local default_priority="${2:-moderate}"
  local critical_option high_option moderate_option low_option selection

  critical_option="$(chip_label "$(priority_icon critical)" "$(priority_bg critical)" "Critical")"
  high_option="$(chip_label "$(priority_icon high)" "$(priority_bg high)" "High")"
  moderate_option="$(chip_label "$(priority_icon moderate)" "$(priority_bg moderate)" "Moderate")"
  low_option="$(chip_label "$(priority_icon low)" "$(priority_bg low)" "Low")"

  selection="$(
    printf '%s\n%s\n%s\n%s\n' \
      "$critical_option" "$high_option" "$moderate_option" "$low_option" \
      | rofi -dmenu -i -no-custom -markup-rows -p "$prompt" -config "$ROFI_CONFIG"
  )" || true

  case "$selection" in
    "$critical_option") printf '%s\n' "critical" ;;
    "$high_option")     printf '%s\n' "high" ;;
    "$moderate_option") printf '%s\n' "moderate" ;;
    "$low_option")      printf '%s\n' "low" ;;
    *)                  printf '%s\n' "$default_priority" ;;
  esac
}

# ── storage ──────────────────────────────────────────────────────────────────

read_tasks() {
  mapfile -t TASKS < "$TASK_FILE"
}

# Replace the file in one step. waybar polls this list while the menu edits it,
# and a truncating redirect would let a render observe a half-written file.
write_tasks() {
  local tmp
  tmp="$(mktemp "${TASK_FILE}.XXXXXX")"
  if [ "$#" -gt 0 ]; then
    printf '%s\n' "$@" > "$tmp"
  fi
  mv "$tmp" "$TASK_FILE"
}

# Every mutation is a read-modify-write against a file three processes touch
# (the waybar poller, the rofi menu, and the right-click add), so they all run
# through here: the mutator sees TASKS under an exclusive lock and rewrites it
# in place. Interactive prompts stay outside, so an open menu never blocks a
# render.
update_tasks() {
  local mutator="$1"
  shift
  local status=0

  exec 8>>"$TASK_LOCK_FILE"
  flock 8
  read_tasks
  if "$mutator" "$@"; then
    write_tasks ${TASKS[@]+"${TASKS[@]}"}
  else
    status=1
  fi
  exec 8>&-

  if [ "$status" -eq 0 ]; then
    refresh_waybar
  fi
  return "$status"
}

# Tasks are addressed by their text rather than by a menu row index: the list
# can have shifted under a concurrent edit between drawing the menu and acting
# on it, and acting on the wrong row is worse than doing nothing.
task_index_of() {
  local target="$1"
  local i
  for i in "${!TASKS[@]}"; do
    if [ "${TASKS[$i]}" = "$target" ]; then
      printf '%s\n' "$i"
      return 0
    fi
  done
  return 1
}

# Indices of TASKS in display order: priority rank, then file order.
sorted_task_indices() {
  local i
  for i in "${!TASKS[@]}"; do
    printf '%s\t%s\n' "$(priority_rank "$(task_priority "${TASKS[$i]}")")" "$i"
  done | sort -s -t $'\t' -k1,1n | cut -f2
}

# Completed lines go to the done log as "<batch epoch><TAB>line", so a whole
# clear can be undone as one batch.
log_done() {
  local batch="$1"
  shift
  local line
  for line in "$@"; do
    printf '%s\t%s\n' "$batch" "$line"
  done >> "$DONE_FILE"
}

# ── mutators (run under update_tasks) ────────────────────────────────────────

task_prepend() {
  TASKS=("$1" ${TASKS[@]+"${TASKS[@]}"})
}

task_drop() {
  local index
  index="$(task_index_of "$1")" || return 1
  log_done "$(date +%s)" "$1"
  TASKS=("${TASKS[@]:0:index}" "${TASKS[@]:index+1}")
}

task_promote() {
  local index
  index="$(task_index_of "$1")" || return 1
  TASKS=("$1" "${TASKS[@]:0:index}" "${TASKS[@]:index+1}")
}

task_replace() {
  local index
  index="$(task_index_of "$1")" || return 1
  TASKS[index]="$2"
}

task_truncate() {
  if [ "${#TASKS[@]}" -gt 0 ]; then
    log_done "$(date +%s)" "${TASKS[@]}"
  fi
  TASKS=()
}

# Put the most recent done batch back at the top and drop it from the log.
task_undo_last() {
  local batch tmp
  local -a restored=()
  [ -s "$DONE_FILE" ] || return 1
  batch="$(tail -n 1 "$DONE_FILE" | cut -f1)"
  mapfile -t restored < <(awk -F '\t' -v b="$batch" '$1 == b { sub(/^[^\t]*\t/, ""); print }' "$DONE_FILE")
  [ "${#restored[@]}" -gt 0 ] || return 1
  tmp="$(mktemp "${DONE_FILE}.XXXXXX")"
  awk -F '\t' -v b="$batch" '$1 != b' "$DONE_FILE" > "$tmp"
  mv "$tmp" "$DONE_FILE"
  TASKS=("${restored[@]}" ${TASKS[@]+"${TASKS[@]}"})
}

# ── commands ─────────────────────────────────────────────────────────────────

add_task() {
  local note="${1:-}"
  local priority_input="${2:-}"
  local priority="" body="" parsed

  if [ -z "$note" ]; then
    note="$(quick_add_prompt)" || true
  fi
  note="$(trim_whitespace "$note")"
  [ -n "$note" ] || return 0

  # An explicit priority argument wins; otherwise the text itself says it.
  if [ -n "$priority_input" ] && priority="$(normalize_priority "$priority_input" 2>/dev/null)"; then
    body="$(task_body "$note")"
  else
    parsed="$(parse_quick_add "$note")"
    priority="${parsed%%$'\t'*}"
    body="${parsed#*$'\t'}"
  fi

  local formatted
  formatted="$(format_task "$body" "$priority")" || return 0
  update_tasks task_prepend "$formatted"
}

open_file_in_terminal() {
  local editor_cmd
  editor_cmd="$(resolve_editor)"
  # resolve_editor can return a command with arguments ("nvim -p"), so the split
  # here is deliberate. Read into an array to say that explicitly, instead of
  # relying on an unquoted expansion that reads like an oversight.
  local -a editor_argv
  read -r -a editor_argv <<< "$editor_cmd"
  # Refresh once the editor closes: this is the one path that changes the file
  # without going through update_tasks, and the module no longer polls every
  # second to notice it.
  (
    foot -e sh -lc 'exec "$@"' sh "${editor_argv[@]}" "$TASK_FILE" >/dev/null 2>&1
    refresh_waybar
  ) &
}

list_tasks() {
  cat "$TASK_FILE"
}

clear_tasks() {
  update_tasks task_truncate
}

# The task shown on the bar: first in display order.
top_task() {
  read_tasks
  [ "${#TASKS[@]}" -gt 0 ] || return 1
  local first
  first="$(sorted_task_indices | head -n 1)"
  printf '%s\n' "${TASKS[$first]}"
}

done_top_task() {
  local task
  task="$(top_task)" || return 0
  update_tasks task_drop "$task"
}

undo_last() {
  update_tasks task_undo_last
}

edit_task() {
  local current="$1"
  local current_body current_priority updated
  current_body="$(task_body "$current")"
  current_priority="$(task_priority "$current")"
  updated="$(printf '%s' "$current_body" | rofi -dmenu -p "Edit" -config "$ROFI_CONFIG")" || true
  [ -n "$updated" ] || return 0
  update_tasks task_replace "$current" "$(format_task "$updated" "$current_priority")"
}

set_priority() {
  local current="$1"
  local new_priority="$2"
  update_tasks task_replace "$current" "$(format_task "$(task_body "$current")" "$new_priority")"
}

change_priority() {
  local current="$1"
  local updated_priority
  updated_priority="$(select_priority "Priority" "$(task_priority "$current")")"
  set_priority "$current" "$updated_priority"
}

confirm_clear() {
  local choice no_option yes_option
  no_option="$(chip_label "󰜺" "$ACTION_CANCEL_BG" "No")"
  yes_option="$(chip_label "󰄬" "$ACTION_CLEAR_BG" "Yes, clear all")"

  choice="$(
    printf '%s\n%s\n' "$no_option" "$yes_option" \
      | rofi -dmenu -i -no-custom -markup-rows -p "Clear all tasks?" \
          -mesg "Alt+z in the menu brings them back." \
          -config "$ROFI_CONFIG"
  )" || true
  [ "$choice" = "$yes_option" ]
}

# Per-task menu for mouse users; every action here also has a key on the row.
task_menu() {
  local task="$1"
  local choice done_option edit_option priority_option move_option cancel_option

  done_option="$(chip_label "󰄬" "$ACTION_ADD_BG" "Mark done")"
  edit_option="$(chip_label "󰏫" "$ACTION_EDIT_BG" "Edit task")"
  priority_option="$(chip_label "󰦨" "$ACTION_OPEN_BG" "Change priority")"
  move_option="$(chip_label "󰁝" "$ACTION_MOVE_BG" "Move to top")"
  cancel_option="$(chip_label "󰜺" "$ACTION_CANCEL_BG" "Cancel")"

  # The body goes in the message line, not the prompt: a long task made the
  # prompt chip run across the window.
  choice="$(
    printf '%s\n%s\n%s\n%s\n%s\n' \
      "$done_option" "$edit_option" "$priority_option" "$move_option" "$cancel_option" \
      | rofi -dmenu -i -no-custom -markup-rows -p "Task" \
          -mesg "$(escape_markup "$(task_body "$task")")" \
          -config "$ROFI_CONFIG"
  )" || true

  case "$choice" in
    "$done_option")     update_tasks task_drop "$task" ;;
    "$edit_option")     edit_task "$task" ;;
    "$priority_option") change_priority "$task" ;;
    "$move_option")     update_tasks task_promote "$task" ;;
    *) ;;
  esac
}

# ── waybar ───────────────────────────────────────────────────────────────────

render_waybar() {
  read_tasks

  local count="${#TASKS[@]}"
  if [ "$count" -eq 0 ]; then
    jq -cn \
      --arg text "󰠮 Empty" \
      --arg tooltip "No active tasks" \
      --arg class "empty" \
      '{text: $text, tooltip: $tooltip, class: $class}'
    return 0
  fi

  local -a order
  mapfile -t order < <(sorted_task_indices)
  local top_task="${TASKS[${order[0]}]}"
  local remaining=$((count - 1))
  local top_priority display_text tooltip priority tooltip_body i

  top_priority="$(task_priority "$top_task")"
  display_text="[$(priority_icon "$top_priority")] $(task_body "$top_task")"
  if [ "$remaining" -gt 0 ]; then
    display_text="$display_text   ($remaining)"
  fi

  # Every task, in display order; the 5-row cap was too low for a list whose
  # whole point is to be short.
  tooltip="<b><span foreground='${ACTION_ADD_BG}'>ATOMIC TASKS</span></b>
<span alpha='30%'>──────────────────────────</span>
<tt>"
  for i in "${order[@]}"; do
    priority="$(task_priority "${TASKS[$i]}")"
    tooltip_body="$(task_body "${TASKS[$i]}")"
    if [ "${#tooltip_body}" -gt 68 ]; then
      tooltip_body="${tooltip_body:0:67}…"
    fi
    tooltip+="<span foreground='$(priority_bg "$priority")'>$(priority_icon "$priority")</span> $(escape_markup "$tooltip_body")"$'\n'
  done
  tooltip="${tooltip%$'\n'}</tt>

<span size='small' alpha='65%'>Click: menu · Right: add · Middle: done top</span>"

  jq -cn \
    --arg text "$display_text" \
    --arg tooltip "$tooltip" \
    --arg class "$top_priority" \
    '{text: $text, tooltip: $tooltip, class: $class}'
}

# ── main menu ────────────────────────────────────────────────────────────────
# One sorted list. Enter opens the per-task menu; the row keys act directly:
#   Alt+a add · Alt+o open file · Alt+x clear · Alt+z undo
#   Alt+d done · Alt+e edit · Alt+↑ move to top · Alt+1..4 set priority
# rofi prints the highlighted row (-format i) with every custom key, so a key
# always acts on the row under the cursor.

rofi_menu() {
  # EXIT runs after function-local variables leave scope under nounset.
  action_theme="$(mktemp)"
  # rofi reads the theme by path, so it must outlive the menu call; clean it
  # up on the way out too, or a killed menu leaves it in /tmp.
  trap 'rm -f "$action_theme"' EXIT

  while true; do
    read_tasks

    local -a order=() options=() row_task=()
    local total_count="${#TASKS[@]}"
    local status_text menu_lines selection status i task hot=0

    mapfile -t order < <(sorted_task_indices)
    for i in ${order[@]+"${order[@]}"}; do
      task="${TASKS[$i]}"
      options+=("$(task_label "$task")")
      row_task+=("$task")
      case "$(task_priority "$task")" in critical|high) hot=$((hot + 1)) ;; esac
    done
    if [ "$total_count" -eq 0 ]; then
      options+=("$(empty_task_label)")
      row_task+=("")
      status_text="No active tasks"
    else
      status_text="$total_count active  •  $hot urgent"
    fi
    status_text="$status_text   <span alpha='60%'>Alt+d done · Alt+e edit · Alt+↑ top · Alt+1-4 priority · Alt+z undo</span>"

    menu_lines="${#options[@]}"
    [ "$menu_lines" -gt 12 ] && menu_lines=12

    cat > "$action_theme" <<EOF
@theme "~/.config/rofi/theme.rasi"

window {
  width: 54%;
  children: [ mainbox ];
  padding: 12px;
}

mainbox {
  children: [ actionbar, inputbar, statusbar, listview ];
  spacing: 8px;
  padding: 8px;
}

statusbar {
  expand: false;
  padding: 6px 9px;
  border: 1px;
  border-radius: 8px;
  border-color: @outline;
  background-color: ${SECTION_BG};
  children: [ textbox-status ];
}

textbox-status {
  markup: true;
  content: $(rasi_quote "$status_text");
  text-color: ${INFO_FG};
  font: @mono-font;
}

actionbar {
  expand: false;
  orientation: horizontal;
  spacing: 5px;
  children: [ button-add, button-open, button-clear ];
}

button {
  cursor: pointer;
}

button-add, button-open, button-clear {
  expand: false;
  padding: 5px 9px;
  border-radius: 8px;
  border: 1px;
  background-color: ${SECTION_BG};
  font: @mono-font;
  horizontal-align: 0.5;
}

button selected,
button selected.normal {
  text-color: ${ACTION_FG};
}

button-add {
  content: "󰐕 Add  Alt+a";
  text-color: ${ACTION_ADD_BG};
  border-color: ${ACTION_ADD_BG};
  action: "kb-custom-1";
}

button-add selected,
button-add selected.normal {
  background-color: ${ACTION_ADD_BG};
  text-color: ${ACTION_FG};
}

button-open {
  content: "󰈔 Open  Alt+o";
  text-color: ${ACTION_OPEN_BG};
  border-color: ${ACTION_OPEN_BG};
  action: "kb-custom-2";
}

button-open selected,
button-open selected.normal {
  background-color: ${ACTION_OPEN_BG};
  text-color: ${ACTION_FG};
}

button-clear {
  content: "󰩹 Clear  Alt+x";
  text-color: ${ACTION_CLEAR_BG};
  border-color: ${ACTION_CLEAR_BG};
  action: "kb-custom-3";
}

button-clear selected,
button-clear selected.normal {
  background-color: ${ACTION_CLEAR_BG};
  text-color: ${ACTION_FG};
}

inputbar {
  margin: 0;
  padding: 5px;
  border: 1px;
  border-radius: 8px;
  border-color: @outline-soft;
  background-color: ${SECTION_BG};
}

entry {
  placeholder: "Filter…";
}

listview {
  columns: 1;
  lines: ${menu_lines};
  fixed-height: false;
  spacing: 5px;
  padding: 0;
}

element {
  padding: 6px 9px;
  border-radius: 8px;
  spacing: 7px;
}

EOF

    status=0
    selection="$(
      printf '%s\n' "${options[@]}" \
        | rofi -dmenu -i -no-custom -hover-select -markup-rows -format i -p "Atomic Tasks" \
          -kb-custom-1 "Alt+a" \
          -kb-custom-2 "Alt+o" \
          -kb-custom-3 "Alt+x" \
          -kb-custom-4 "Alt+z" \
          -kb-custom-5 "Alt+d" \
          -kb-custom-6 "Alt+e" \
          -kb-custom-7 "Alt+Up" \
          -kb-custom-8 "Alt+1" \
          -kb-custom-9 "Alt+2" \
          -kb-custom-10 "Alt+3" \
          -kb-custom-11 "Alt+4" \
          -config "$ROFI_CONFIG" -theme "$action_theme"
    )" || status=$?

    # The task under the cursor, if the key needs one.
    task=""
    if [[ "$selection" =~ ^[0-9]+$ ]] && [ "$selection" -lt "${#row_task[@]}" ]; then
      task="${row_task[$selection]}"
    fi

    case "$status" in
      0)  [ -n "$task" ] || return 0; task_menu "$task" ;;
      1)  return 0 ;;
      10) add_task ;;
      11) open_file_in_terminal; return 0 ;;
      12) if confirm_clear; then clear_tasks; fi ;;
      13) undo_last || true ;;
      14) [ -n "$task" ] && update_tasks task_drop "$task" ;;
      15) [ -n "$task" ] && edit_task "$task" ;;
      16) [ -n "$task" ] && update_tasks task_promote "$task" ;;
      17) [ -n "$task" ] && set_priority "$task" critical ;;
      18) [ -n "$task" ] && set_priority "$task" high ;;
      19) [ -n "$task" ] && set_priority "$task" moderate ;;
      20) [ -n "$task" ] && set_priority "$task" low ;;
      *)  return 0 ;;
    esac
  done
}

case "${1:-}" in
  render-waybar)
    render_waybar
    ;;
  add)
    add_task "${2:-}" "${3:-}"
    ;;
  done-top)
    done_top_task
    ;;
  undo)
    undo_last
    ;;
  file)
    open_file_in_terminal
    ;;
  list)
    list_tasks
    ;;
  clear)
    clear_tasks
    ;;
  # edit|rofi|menu and the bare invocation all open the same menu.
  *)
    rofi_menu
    ;;
esac
