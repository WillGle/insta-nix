#!/usr/bin/env bash
set -euo pipefail
# rofi-calendar — a month sheet, nothing else. No search box, no menu rows:
# the window is the calendar, navigation is on the keyboard.
#   ←/h  previous month     →/l  next month     t  today     Enter/Esc  close
# Colours come from the theme at build time (replaceVars), like every other
# script here, so the sheet follows a theme regeneration instead of drifting.

ACCENT="@themeAccent@"
BASE="@themeBase@"
SUBTEXT="@themeSubtext@"
RASI="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/calendar.rasi"

today_y=$(date +%Y)
today_m=$(date +%-m)
today_d=$(date +%-d)

year=$(( ${1:-$today_y} + 0 ))
month=$(( ${2:-$today_m} + 0 ))
if   [ "$month" -gt 12 ]; then month=1;  year=$((year + 1))
elif [ "$month" -lt 1 ];  then month=12; year=$((year - 1))
fi

# cal in the Vietnamese locale prints "Tháng 8 2026" and T2…CN, matching the
# rest of the UI; -m starts the week on Monday. Every line is padded to the
# 20-column grid so the textbox can centre them as one block.
sheet="$(
  LC_ALL=vi_VN.UTF-8 cal -m "$month" "$year" | LC_ALL=C.UTF-8 awk \
    -v ty="$today_y" -v tm="$today_m" -v td="$today_d" -v cy="$year" -v cm="$month" \
    -v accent="$ACCENT" -v base="$BASE" -v subtext="$SUBTEXT" '
    function trim(s) { gsub(/^ +| +$/, "", s); return s }
    NR == 1 {
      title = trim($0)
      # Centre by hand: the markup around the title would defeat %-20s.
      pad = int((20 - length(title)) / 2)
      printf "%*s<span foreground=\"%s\" size=\"large\"><b>%s</b></span>\n", pad, "", accent, title
      next
    }
    NR == 2 { printf "<span foreground=\"%s\">%-20s</span>\n", subtext, $0; next }
    {
      row = sprintf("%-20s", $0)
      line = ""
      for (c = 1; c <= 7; c++) {
        cell = substr(row, (c - 1) * 3 + 1, 2)
        num = trim(cell)
        if (num != "" && cy == ty && cm == tm && num + 0 == td + 0)
          cell = sprintf("<span background=\"%s\" foreground=\"%s\"><b>%s</b></span>", accent, base, cell)
        else if (c >= 6 && num != "")
          cell = sprintf("<span foreground=\"%s\">%s</span>", subtext, cell)
        line = line cell (c < 7 ? " " : "")
      }
      print line
    }
  '
)"

hint="<span size=\"small\" alpha=\"50%\">←  →  tháng   ·   t  hôm nay   ·   Esc</span>"

rofi_args=(
  -dmenu
  -markup-rows
  -config "${XDG_CONFIG_HOME:-$HOME/.config}/rofi/config.rasi"
  -p "Lịch"
  -mesg "$sheet
$hint"
  # Left/Right normally move the cursor in the (hidden) entry; free them first.
  -kb-move-char-back ""
  -kb-move-char-forward ""
  -kb-custom-1 "Left,h"
  -kb-custom-2 "Right,l"
  -kb-custom-3 "t"
)
[ -r "$RASI" ] && rofi_args+=(-theme "$RASI")

# Exit codes: 10/11/12 for the custom keys, 0/1 for Enter/Esc.
rc=0
rofi "${rofi_args[@]}" <<< "" >/dev/null || rc=$?
case "$rc" in
  10) prev_m=$((month - 1)); prev_y=$year
      [ "$prev_m" -lt 1 ] && { prev_m=12; prev_y=$((year - 1)); }
      exec "$0" "$prev_y" "$prev_m" ;;
  11) exec "$0" "$year" "$((month + 1))" ;;
  12) exec "$0" "$today_y" "$today_m" ;;
  *)  exit 0 ;;
esac
