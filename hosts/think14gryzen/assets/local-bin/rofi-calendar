#!/usr/bin/env bash
set -euo pipefail
# rofi-calendar — a month sheet with a date search box.
#   type a date + Enter   jump to it: 15/3 · 3/2027 · 15/3/2027 · 2027-03-15 · 15
#   ←  →                  previous / next month
#   Ctrl+t                back to today
#   ◀ · Hôm nay · ▶       the same three as mouse buttons under the sheet
#   Enter (empty)         today (the middle button is pre-selected)
#   Esc                   close
# Runtime colours follow the generated theme, with replaceVars as fallback.
#
# Arguments (internal, used when the script re-executes itself):
#   $1 year  $2 month  $3 focused day or ""  $4 message under the sheet or ""

ACCENT="@themeAccent@"
BASE="@themeBase@"
SUBTEXT="@themeSubtext@"
RASI="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/calendar.rasi"
THEME_PALETTE_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/theme/generated/palette.json"

load_runtime_palette() {
  local values=""
  local -a palette=()

  [ -r "$THEME_PALETTE_FILE" ] || return 0
  values="$(
    jq -er '
      [
        .colors.surface.default.color,
        .colors.on_surface_variant.default.color,
        .colors.primary.default.color
      ] as $palette
      | if all($palette[]; type == "string" and test("^#[0-9A-Fa-f]{6}$"))
        then $palette | @tsv
        else error("invalid runtime palette")
        end
    ' "$THEME_PALETTE_FILE" 2>/dev/null
  )" || return 0

  IFS=$'\t' read -r -a palette <<< "$values"
  [ "${#palette[@]}" -eq 3 ] || return 0
  BASE="${palette[0]}"
  SUBTEXT="${palette[1]}"
  ACCENT="${palette[2]}"
}

load_runtime_palette

today_y=$(date +%Y)
today_m=$(date +%-m)
today_d=$(date +%-d)

year=$(( ${1:-$today_y} + 0 ))
month=$(( ${2:-$today_m} + 0 ))
focus="${3:-}"
note="${4:-}"
if   [ "$month" -gt 12 ]; then month=1;  year=$((year + 1))
elif [ "$month" -lt 1 ];  then month=12; year=$((year - 1))
fi

# Turn what was typed into "year month day". Numbers may be separated by
# / - . or spaces; the order is day-first unless the first number is a year.
#   15          → day 15 of the month on screen
#   15/3        → 15 March, this year         3/2027  → March 2027 (no day)
#   15/3/2027   → the full date               2027-03-15 → the same, ISO order
# Prints "y m d" (d may be empty) or nothing when the text is not a date.
parse_query() {
  local q="$1" a b c n y m d
  q="${q//[\/.\-]/ }"
  read -r a b c _ <<< "$q"
  for n in "$a" "${b:-0}" "${c:-0}"; do
    [[ "$n" =~ ^[0-9]+$ ]] || return 0
  done
  if [ -z "${b:-}" ]; then                      # one number: a day
    y=$year; m=$month; d=$a
  elif [ "$a" -ge 1000 ]; then                  # y m [d]
    y=$a; m=$b; d="${c:-}"
  elif [ -z "${c:-}" ]; then                    # d m  or  m y
    if [ "$b" -gt 12 ]; then y=$b; m=$a; d=""; else y=$today_y; m=$b; d=$a; fi
  else                                          # d m y
    y=$c; m=$b; d=$a
    [ "$y" -lt 100 ] && y=$((y + 2000))
  fi
  [ "$m" -ge 1 ] && [ "$m" -le 12 ] || return 0
  if [ -n "$d" ]; then
    date -d "$(printf '%04d-%02d-%02d' "$y" "$m" "$d")" >/dev/null 2>&1 || return 0
  fi
  printf '%s %s %s\n' "$y" "$m" "${d:-}"
}

# Use Vietnamese labels and Monday-first weeks; pad to a 20-column grid.
sheet="$(
  LC_ALL=vi_VN.UTF-8 cal -m "$month" "$year" | LC_ALL=C.UTF-8 awk \
    -v ty="$today_y" -v tm="$today_m" -v td="$today_d" -v cy="$year" -v cm="$month" \
    -v fd="${focus:-0}" -v accent="$ACCENT" -v base="$BASE" -v subtext="$SUBTEXT" '
    function trim(s) { gsub(/^ +| +$/, "", s); return s }
    NR == 1 {
      title = trim($0)
      # Centre by hand: the markup around the title would defeat %-20s.
      pad = int((20 - length(title)) / 2)
      # Taller markup is clipped by rofi; use the base font for spacing.
      printf "%*s<span foreground=\"%s\"><b>%s</b></span>\n", pad, "", accent, title
      next
    }
    NR == 2 { printf "<span foreground=\"%s\">%-20s</span>\n", subtext, $0; next }
    {
      row = sprintf("%-20s", $0)
      line = ""
      for (c = 1; c <= 7; c++) {
        cell = substr(row, (c - 1) * 3 + 1, 2)
        num = trim(cell)
        if (num != "" && cy == ty && cm == tm && num + 0 == td + 0)
          cell = sprintf("<span background=\"%s\" foreground=\"%s\"><b>%s</b></span>", accent, base, cell)
        else if (num != "" && num + 0 == fd + 0)
          cell = sprintf("<span foreground=\"%s\" underline=\"double\"><b>%s</b></span>", accent, cell)
        else if (c >= 6 && num != "")
          cell = sprintf("<span foreground=\"%s\">%s</span>", subtext, cell)
        line = line cell (c < 7 ? " " : "")
      }
      print line
    }
  '
)"

# A found date gets its weekday spelled out under the sheet.
if [ -n "$focus" ] && [ -z "$note" ]; then
  note="$(LC_ALL=vi_VN.UTF-8 date -d "$(printf '%04d-%02d-%02d' "$year" "$month" "$focus")" '+%A, %d/%m/%Y' 2>/dev/null || true)"
fi
note_line=""
[ -n "$note" ] && note_line="
<span foreground=\"$ACCENT\" size=\"small\">$note</span>"

# Short enough to stay on one line under the 20-column grid.
hint="<span size=\"x-small\" alpha=\"50%\">← → tháng · Ctrl+t hôm nay · Esc</span>"

# Three mouse buttons share a row. Preselect today for Enter on empty input;
# typed dates match no label and are returned as text.
BTN_PREV="◀  Trước"
BTN_TODAY="Hôm nay"
BTN_NEXT="Sau  ▶"

rofi_args=(
  -dmenu
  -markup-rows
  -matching normal
  -select "$BTN_TODAY"
  -config "${XDG_CONFIG_HOME:-$HOME/.config}/rofi/config.rasi"
  -p "Lịch"
  -mesg "$sheet$note_line
$hint"
  # Reserve Left/Right for month navigation.
  -kb-move-char-back ""
  -kb-move-char-forward ""
  -kb-custom-1 "Left"
  -kb-custom-2 "Right"
  -kb-custom-3 "Control+t"
)
[ -r "$RASI" ] && rofi_args+=(-theme "$RASI")

# Exit codes: 10/11/12 for the custom keys; 0 with the typed text on Enter;
# 1 on Esc. Enter on an empty box closes.
# Catch the assignment status here; a handler inside $(…) stays in its subshell.
query="$(printf '%s\n%s\n%s\n' "$BTN_PREV" "$BTN_TODAY" "$BTN_NEXT" | rofi "${rofi_args[@]}")" && rc=0 || rc=$?
prev_m=$((month - 1)); prev_y=$year
[ "$prev_m" -lt 1 ] && { prev_m=12; prev_y=$((year - 1)); }
case "$rc" in
  10) exec "$0" "$prev_y" "$prev_m" ;;
  11) exec "$0" "$year" "$((month + 1))" ;;
  12) exec "$0" "$today_y" "$today_m" ;;
  0)
    case "$query" in
      "$BTN_PREV")  exec "$0" "$prev_y" "$prev_m" ;;
      "$BTN_NEXT")  exec "$0" "$year" "$((month + 1))" ;;
      "$BTN_TODAY") exec "$0" "$today_y" "$today_m" ;;
    esac
    query="$(printf '%s' "$query" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [ -n "$query" ] || exit 0
    if parsed="$(parse_query "$query")" && [ -n "$parsed" ]; then
      read -r py pm pd <<< "$parsed"
      exec "$0" "$py" "$pm" "${pd:-}"
    fi
    exec "$0" "$year" "$month" "$focus" "không nhận ra: $(printf '%s' "$query" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')"
    ;;
  *)  exit 0 ;;
esac
