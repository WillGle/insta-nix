#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
export PATH="$PATH:/run/current-system/sw/bin"

# Shared nmcli query helpers, substituted to a store path at build time so the
# two callers cannot drift apart again. See the header of that file for the two
# same-named helpers that deliberately stay private to each caller.
# shellcheck source=/dev/null
. "@networkLib@"

escape_markup() {
  printf '%s' "${1:-}" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
}

# busctl, never bluetoothctl. Every bluetoothctl invocation registers an
# advertisement monitor with bluetoothd and tears it down again on exit, which
# at this module's 5s interval wrote two journal lines a tick — roughly 1700
# lines per hour, for a status string. busctl reads the property and says
# nothing.
bluez_prop() {
  busctl --json=short get-property org.bluez "$1" "$2" "$3" 2>/dev/null \
    | sed -n 's/.*"data":\(.*\)}/\1/p'
}

# Echoes a human-readable summary of the adapter, or the connected devices with
# their battery level when BlueZ exposes one (it only does with Experimental
# enabled, which base.nix sets).
get_bluetooth_status() {
  if ! systemctl is-active --quiet bluetooth; then
    echo "Disabled"
    return
  fi

  local tree adapter paths path connected alias battery output=""

  tree="$(busctl --no-pager tree org.bluez 2>/dev/null)"
  adapter="$(printf '%s\n' "$tree" | grep -oE '/org/bluez/hci[0-9]+$' | sort -u | head -1)"
  if [ -z "$adapter" ]; then
    echo "No adapter"
    return
  fi

  if [ "$(bluez_prop "$adapter" org.bluez.Adapter1 Powered)" != "true" ]; then
    echo "Powered off"
    return
  fi

  paths="$(printf '%s\n' "$tree" | grep -oE '/org/bluez/hci[0-9]+/dev_[0-9A-F_]+$' | sort -u)"
  while read -r path; do
    [ -n "$path" ] || continue
    connected="$(bluez_prop "$path" org.bluez.Device1 Connected)"
    [ "$connected" = "true" ] || continue

    alias="$(bluez_prop "$path" org.bluez.Device1 Alias | sed 's/^"//; s/"$//')"
    battery="$(bluez_prop "$path" org.bluez.Battery1 Percentage)"
    if [ -n "$battery" ]; then
      output+="${alias} (${battery}%), "
    else
      output+="${alias}, "
    fi
  done <<< "$paths"

  [ -n "$output" ] || { echo "None connected"; return; }
  echo "${output%, }"
}

# The bar shows one glyph for Bluetooth next to the network one, so both live in
# a single block. Only three states are worth distinguishing at a glance.
bluetooth_icon() {
  case "${1:-}" in
    Disabled | "Powered off" | "No adapter") printf '󰂲' ;;
    "None connected") printf '󰂯' ;;
    *) printf '󰂱' ;;
  esac
}

active_wifi_ap_line() {
  local iface="$1"
  local target_ssid="${2:-}"
  local masked_ssid="${target_ssid//:/$'\x01'}"
  local ap_line=""

  ap_line="$(nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY,FREQ,BSSID,RATE device wifi list ifname "$iface" --rescan no \
    | sed 's/\\:/\x01/g' \
    | awk -F: '$1 == "*" && !found { print; found = 1 }')"

  if [ -n "$ap_line" ]; then
    printf '%s\n' "$ap_line"
    return 0
  fi

  [ -n "$masked_ssid" ] || return 0

  nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY,FREQ,BSSID,RATE device wifi list ifname "$iface" --rescan no \
    | sed 's/\\:/\x01/g' \
    | awk -F: -v target="$masked_ssid" '$2 == target && !found { print; found = 1 }'
}

current_ip() {
  local iface="$1"
  nmcli -g IP4.ADDRESS device show "$iface" 2>/dev/null | sed -n '1s#/.*##p'
}

active_ethernet() {
  nmcli -t -f TYPE,NAME,DEVICE connection show --active \
    | sed 's/\\:/\x01/g' \
    | awk -F: '$1 == "802-3-ethernet" && !found {
        name=$2; device=$3;
        gsub(/\x01/, ":", name); gsub(/\x01/, ":", device);
        print name "\t" device; found = 1
      }'
}

emit_json() {
  local text="$1"
  local tooltip="$2"
  local class="$3"

  jq -cn \
    --arg text "$text" \
    --arg tooltip "$tooltip" \
    --arg class "$class" \
    '{text: $text, tooltip: $tooltip, class: $class}'
}

main() {
  local iface ethernet_line wifi_conn wifi_name wifi_uuid wifi_device wifi_ssid wifi_ap
  local ssid signal security freq ip gateway dns tooltip
  local ACCENT="@themeAccent@"
  local SEP="<span alpha='30%'>──────────────────────────</span>"
  # One block on the bar carries both link and Bluetooth, so the tooltip is
  # titled for the pair. The transport (Wi-Fi / Ethernet) moves into a Link:
  # field rather than the header, which keeps every heading inside the width of
  # the 26-character rule below it.
  local title="NETWORK AND CONNECTION"
  local escaped_ssid escaped_security escaped_ethernet_name escaped_ethernet_device
  local bt_status escaped_bt_status bt_icon

  iface="$(wifi_iface)"
  ethernet_line="$(active_ethernet)"
  wifi_conn=""
  wifi_name=""
  wifi_uuid=""
  wifi_device=""
  wifi_ssid=""
  wifi_ap=""

  if [ -n "$iface" ]; then
    wifi_conn="$(active_wifi_connection "$iface")"
    if [ -n "$wifi_conn" ]; then
      IFS=$'\t' read -r wifi_name wifi_uuid wifi_device <<< "$wifi_conn"
      wifi_ssid="$(connection_ssid "$wifi_uuid" "$wifi_name")"
      wifi_ap="$(active_wifi_ap_line "$iface" "$wifi_ssid")"
    fi
  fi

  ssid="$wifi_ssid"
  signal=""
  security=""
  freq=""
  bssid=""
  rate=""

  if [ -n "$wifi_ap" ]; then
    IFS=: read -r _in_use ssid signal security freq _bssid rate <<< "$wifi_ap"
    ssid="${ssid//$'\x01'/:}"
    security="${security//$'\x01'/:}"
    bssid="${_bssid//$'\x01'/:}"
  fi

  # Check for active VPN/Wireguard tunnels
  vpn_interfaces=$(ip link show | grep -E -o ' (wg[0-9a-zA-Z_-]+|tun[0-9a-zA-Z_-]+|tailscale[0-9a-zA-Z_-]+|proton[0-9a-zA-Z_-]+)' || true)
  if [ -n "$vpn_interfaces" ]; then
    vpn_interfaces=$(echo "$vpn_interfaces" | tr -d ' ' | sort -u | tr '\n' ' ' | sed 's/ $//')
  else
    vpn_interfaces="None"
  fi

  bt_status="$(get_bluetooth_status)"
  escaped_bt_status="$(escape_markup "$bt_status")"
  bt_icon="$(bluetooth_icon "$bt_status")"

  if [ -n "$ethernet_line" ]; then
    IFS=$'\t' read -r ethernet_name ethernet_device <<< "$ethernet_line"
    ip="$(current_ip "$ethernet_device")"
    gateway="$(current_gateway "$ethernet_device")"
    dns="$(current_dns "$ethernet_device")"
    escaped_ethernet_name="$(escape_markup "${ethernet_name:-Connected}")"
    escaped_ethernet_device="$(escape_markup "${ethernet_device:-Unknown}")"

    tooltip="<b><span foreground='$ACCENT'>$title</span></b>
$SEP
<tt>Link:         Ethernet
SSID/Name:    $escaped_ethernet_name
Device:       $escaped_ethernet_device
Status:       Connected</tt>

<b><span foreground='$ACCENT'>CONNECTIVITY</span></b>
$SEP
<tt>IP:           ${ip:-Unavailable}
Gateway:      ${gateway:-Unavailable}
DNS:          ${dns:-None}
VPN Active:   $vpn_interfaces</tt>"

    if [ -n "$wifi_conn" ]; then
      escaped_ssid="$(escape_markup "${ssid:-<hidden>}")"
      tooltip+=$'\n\n'"<b><span foreground='$ACCENT'>WI-FI (STANDBY)</span></b>
$SEP
<tt>SSID:         $escaped_ssid"
      if [ -n "$wifi_ap" ]; then
        tooltip+=$'\n'"Signal:       ${signal:-0}% ($(signal_icon "$signal"))
Band:         $(band_label "$freq")</tt>"
      else
        tooltip+=$'\n'"Status:       Connected
Signal:       Unavailable
Band:         ?
Security:     Unavailable</tt>"
      fi
    fi
    tooltip+=$'\n\n'"<b><span foreground='$ACCENT'>BLUETOOTH</span></b>
$SEP
<tt>Devices:      $escaped_bt_status</tt>"
    tooltip+=$'\n\n'"<span size='small' alpha='50%'>Left: Network menu  ·  Right: Bluetooth</span>"
    emit_json "$bt_icon 󰈀" "$tooltip" "ethernet"
    exit 0
  fi

  if [ -n "$wifi_conn" ]; then
    ip="$(current_ip "$iface")"
    gateway="$(current_gateway "$iface")"
    dns="$(current_dns "$iface")"
    escaped_ssid="$(escape_markup "${ssid:-<hidden>}")"
    escaped_security="$(escape_markup "$(security_label "$security")")"
    escaped_bssid="$(escape_markup "${bssid:-Unavailable}")"
    escaped_rate="$(escape_markup "${rate:-Unavailable}")"

    tooltip="<b><span foreground='$ACCENT'>$title</span></b>
$SEP
<tt>Link:         Wi-Fi
SSID:         $escaped_ssid
Interface:    $iface
BSSID:        $escaped_bssid
Link Speed:   $escaped_rate"
    if [ -n "$wifi_ap" ]; then
      tooltip+=$'\n'"Signal:       ${signal:-0}% ($(signal_icon "$signal"))
Band:         $(band_label "$freq")
Security:     $escaped_security</tt>"
    else
      tooltip+=$'\n'"Status:       Connected
Signal:       Unavailable
Band:         ?
Security:     Unavailable</tt>"
    fi

    tooltip+=$'\n\n'"<b><span foreground='$ACCENT'>CONNECTIVITY</span></b>
$SEP
<tt>IP:           ${ip:-Unavailable}
Gateway:      ${gateway:-Unavailable}
DNS:          ${dns:-None}
VPN Active:   $vpn_interfaces</tt>"

    tooltip+=$'\n\n'"<b><span foreground='$ACCENT'>BLUETOOTH</span></b>
$SEP
<tt>Devices:      $escaped_bt_status</tt>"

    tooltip+=$'\n\n'"<span size='small' alpha='50%'>Left: Network menu  ·  Right: Bluetooth</span>"
    if [ -n "$wifi_ap" ]; then
      emit_json "$bt_icon $(signal_icon "$signal")" "$tooltip" "connected"
    else
      emit_json "$bt_icon 󰖩" "$tooltip" "connected"
    fi
    exit 0
  fi

  if [ -n "$iface" ] && [ -z "$wifi_conn" ] && ! wifi_enabled; then
    tooltip="<b><span foreground='$ACCENT'>$title</span></b>
$SEP
<tt>Link:         Wi-Fi
Status:       Wi-Fi disabled</tt>

<b><span foreground='$ACCENT'>BLUETOOTH</span></b>
$SEP
<tt>Devices:      $escaped_bt_status</tt>

<span size='small' alpha='50%'>Left: Network menu  ·  Right: Bluetooth</span>"
    emit_json "$bt_icon 󰖪" "$tooltip" "disabled"
    exit 0
  fi

  tooltip="<b><span foreground='$ACCENT'>$title</span></b>
$SEP
<tt>Link:         None
Status:       Disconnected</tt>

<b><span foreground='$ACCENT'>BLUETOOTH</span></b>
$SEP
<tt>Devices:      $escaped_bt_status</tt>

<span size='small' alpha='50%'>Left: Network menu  ·  Right: Bluetooth</span>"
  emit_json "$bt_icon 󰤮" "$tooltip" "disconnected"
}

main "$@"
