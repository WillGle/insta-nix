#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
# Waybar Disk Info — free space on / in the bar, one row per physical drive
# with its NVMe temperature in the tooltip. Split out of waybar-memory-info,
# where the disk table had nothing to do with the question that module
# answers; disks change slowly, so this one refreshes every 30 s.

ICON_DISK=$(printf "")
ACCENT="@themeAccent@"
SEP="<span alpha='30%'>──────────────────────────</span>"

# The block is hidden by default and opened from the memory module's click.
# waybar keeps no state, so the state is this file; `visible` is the module's
# exec-if (a non-zero exit hides it) and `toggle` flips the file and signals
# waybar (SIGRTMIN+8) so every module with "signal": 8 re-runs at once.
# pkill must match the exact process name: without -x, "waybar" also matches
# the helper scripts (waybar-power-monitor…) and an RT signal kills them.
STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/waybar-disk-panel"
SIGNAL=8
case "${1:-}" in
  visible)
    if [ -e "$STATE_FILE" ]; then exit 0; else exit 1; fi
    ;;
  toggle)
    if [ -e "$STATE_FILE" ]; then rm -f "$STATE_FILE"; else : > "$STATE_FILE"; fi
    pkill "-RTMIN+$SIGNAL" -x waybar || pkill "-RTMIN+$SIGNAL" -x .waybar-wrapped || true
    exit 0
    ;;
esac

# Composite temperature per NVMe namespace, keyed by the name df reports
# (nvme1n1). An hwmon node owns the namespace directory it belongs to, so the
# mapping is a plain path test — no readlink needed.
nvme_temp_map() {
  local h name lbl label base raw nsdir

  for h in /sys/class/hwmon/hwmon*; do
    [ -r "$h/name" ] || continue
    read -r name < "$h/name" || continue
    [ "$name" = "nvme" ] || continue

    # "Composite" is the drive-level sensor; the numbered ones are per-die and
    # read lower, so reporting them would understate how hot the drive is.
    for lbl in "$h"/temp*_label; do
      [ -r "$lbl" ] || continue
      read -r label < "$lbl" || continue
      [ "$label" = "Composite" ] || continue

      base="${lbl%_label}"
      [ -r "${base}_input" ] || continue
      read -r raw < "${base}_input" || continue

      for nsdir in "$h"/device/nvme*n[0-9]; do
        [ -d "$nsdir" ] || continue
        printf '%s %s\n' "${nsdir##*/}" "$raw"
      done
      break
    done
  done
}

# One df pass feeds both the bar text (root's free space and fill level) and
# the per-drive table. Partitions of the same disk are summed, so /boot folds
# into its drive's totals instead of taking a row of its own. Pseudo
# filesystems (tmpfs, devtmpfs, efivarfs) are dropped by requiring a /dev
# source, and a device mounted twice — /nix/store alongside / — is only
# counted once. Sizes are read in bytes rather than via -BG, which rounds a
# 1 G partition to "1G / 1G".
df_out="$(
  df -P -B1 2>/dev/null | awk -v temps="$(nvme_temp_map)" '
    BEGIN {
      n = split(temps, lines, "\n")
      for (i = 1; i <= n; i++) {
        if (split(lines[i], kv, " ") == 2) tmap[kv[1]] = kv[2]
      }
      worst_pct = 0; worst_temp = 0
    }
    # Bar label for a mount: "/" stays, anything deeper is cut to its first
    # component ("/mnt/vault" → "/mnt") so two drives fit in the bar.
    function short_mount(m) {
      if (m != "/" && match(m, /^\/[^\/]+/)) return substr(m, RSTART, RLENGTH)
      return m
    }
    function human_bar(b,   g) {
      g = b / 1073741824
      return g >= 100 ? sprintf("%.0fG", g) : sprintf("%.1fG", g)
    }
    function human(b,   g) {
      g = b / 1073741824
      return g >= 100 ? sprintf("%.0f G", g) : sprintf("%.1f G", g)
    }
    function bar(p,   i, s) {
      s = "["
      for (i = 1; i <= 10; i++) s = s (i <= int(p / 10) ? "■" : "□")
      return s "]"
    }
    # df rounds capacity up, so match it: a table that disagrees by a percent
    # with what df itself prints reads as a bug.
    function dfpct(used, avail,   cap, raw) {
      cap = used + avail
      raw = cap > 0 ? used * 100 / cap : 0
      return (raw == int(raw)) ? raw : int(raw) + 1
    }
    # Strip the partition suffix to reach the physical device. A whole-disk
    # mount (nvme0n1, sda) carries no suffix and must survive untouched, which
    # is why the nvme/mmc form is matched explicitly rather than by trailing
    # digits.
    function diskof(dev,   d) {
      d = dev
      sub(/^\/dev\//, "", d)
      if (d ~ /^(nvme[0-9]+n[0-9]+|mmcblk[0-9]+)p[0-9]+$/) sub(/p[0-9]+$/, "", d)
      else if (d ~ /^[a-z]+[0-9]+$/) sub(/[0-9]+$/, "", d)
      return d
    }
    NR > 1 && $1 ~ /^\/dev\// {
      m = $6
      for (i = 7; i <= NF; i++) m = m " " $i
      if (seen[$1]++) next
      gsub(/&/, "\\&amp;", m); gsub(/</, "\\&lt;", m); gsub(/>/, "\\&gt;", m)

      d = diskof($1)
      tot[d] += $2; usd[d] += $3; avl[d] += $4
      # Label the drive by its shallowest mount: "/" reads better than
      # "/boot" for the disk that happens to carry both.
      if (!(d in lbl) || length(m) < length(lbl[d])) lbl[d] = m
    }
    # Two lines per drive rather than one wide row, with the mount on the
    # first line and the device on the second, so no line runs past the
    # 30-odd columns of the rest of the bar tooltips.
    END {
      n = 0
      for (d in tot) ord[++n] = d
      # Insertion sort by mount path — a handful of drives, and sorting here
      # keeps each pair of lines together, which piping to sort would not.
      for (i = 2; i <= n; i++) {
        k = ord[i]
        for (j = i - 1; j >= 1 && lbl[ord[j]] > lbl[k]; j--) ord[j + 1] = ord[j]
        ord[j + 1] = k
      }

      table = ""; text = ""
      for (i = 1; i <= n; i++) {
        d = ord[i]
        pct = dfpct(usd[d], avl[d])
        tc = (d in tmap) ? tmap[d] / 1000 : -1
        t = tc >= 0 ? sprintf("%.0f°C", tc) : "--"
        if (pct > worst_pct) worst_pct = pct
        if (tc > worst_temp) worst_temp = tc
        if (i > 1) table = table "\n\n"
        table = table sprintf("%-14s%7s / %-6s %3d%% %s\n", lbl[d], human(usd[d]), human(tot[d]), pct, bar(pct))
        table = table sprintf("%-14s%7s free · %s", d, human(avl[d]), t)
        # Bar: one "<mount> <free> <temp>" per drive, e.g. "/ 126G 34°".
        text = text (i > 1 ? "  " : "") short_mount(lbl[d]) " " human_bar(avl[d]) (tc >= 0 ? sprintf(" %.0f°", tc) : "")
      }
      # Scalars on the first line, the multi-line table after it; the shell
      # splits on that first newline below (read would stop at it).
      printf "%s\t%d\t%d\n%s", text, worst_pct, worst_temp, table
    }
  '
)"
first_line="${df_out%%$'\n'*}"
disk_table="${df_out#*$'\n'}"
IFS=$'\t' read -r bar_text worst_pct worst_temp <<< "$first_line"
[ -n "${disk_table:-}" ] && [ "$disk_table" != "$df_out" ] || disk_table="Unavailable"
[ -n "${bar_text:-}" ] || bar_text="n/a"

# Worst drive decides the colour: nearly full, or hot for an NVMe (SMART's own
# warning threshold on these drives is 85 °C; 70/80 leaves headroom).
class="normal"
if   [ "${worst_pct:-0}" -ge 95 ] || [ "${worst_temp:-0}" -ge 80 ]; then class="critical"
elif [ "${worst_pct:-0}" -ge 85 ] || [ "${worst_temp:-0}" -ge 70 ]; then class="warning"
fi

tooltip="<b><span foreground='$ACCENT'>DISKS</span></b>
$SEP
<tt>${disk_table}</tt>"

jq -cn \
  --arg text "${ICON_DISK} ${bar_text}" \
  --arg tooltip "$tooltip" \
  --arg class "$class" \
  '{text: $text, tooltip: $tooltip, class: $class}'
