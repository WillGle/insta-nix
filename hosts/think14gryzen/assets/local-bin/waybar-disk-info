#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
# Show free space in the bar and per-drive NVMe temperatures in the tooltip.

ICON_DISK=$(printf "")
ACCENT="@themeAccent@"
SEP="<span alpha='30%'>──────────────────────────</span>"

# The visibility file backs exec-if; toggle signals Waybar to refresh.
# Match its exact process name so RT signals cannot kill helper scripts.
STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/waybar-disk-panel"
SIGNAL=8
case "${1:-}" in
  visible)
    if [ -e "$STATE_FILE" ]; then exit 0; else exit 1; fi
    ;;
  toggle)
    if [ -e "$STATE_FILE" ]; then rm -f "$STATE_FILE"; else : > "$STATE_FILE"; fi
    pkill "-RTMIN+$SIGNAL" -x waybar || pkill "-RTMIN+$SIGNAL" -x .waybar-wrapped || true
    exit 0
    ;;
esac

# Map composite temperatures to NVMe namespaces using their hwmon paths.
nvme_temp_map() {
  local h name lbl label base raw nsdir

  for h in /sys/class/hwmon/hwmon*; do
    [ -r "$h/name" ] || continue
    read -r name < "$h/name" || continue
    [ "$name" = "nvme" ] || continue

    # Per-die sensors read lower; use Composite for drive-level temperature.
    for lbl in "$h"/temp*_label; do
      [ -r "$lbl" ] || continue
      read -r label < "$lbl" || continue
      [ "$label" = "Composite" ] || continue

      base="${lbl%_label}"
      [ -r "${base}_input" ] || continue
      read -r raw < "${base}_input" || continue

      for nsdir in "$h"/device/nvme*n[0-9]; do
        [ -d "$nsdir" ] || continue
        printf '%s %s\n' "${nsdir##*/}" "$raw"
      done
      break
    done
  done
}

# Share one df pass for bar and tooltip. Sum partitions by drive, ignore
# pseudo filesystems, and count duplicate mounts once. Read bytes to avoid
# rounding small partitions to whole GiB.
df_out="$(
  df -P -T -B1 2>/dev/null | awk -v temps="$(nvme_temp_map)" '
    BEGIN {
      n = split(temps, lines, "\n")
      for (i = 1; i <= n; i++) {
        if (split(lines[i], kv, " ") == 2) tmap[kv[1]] = kv[2]
      }
      worst_pct = 0; worst_temp = 0
    }
    # Bar label for a mount: "/" stays, anything deeper is cut to its first
    # component ("/mnt/vault" → "/mnt") so two drives fit in the bar.
    function short_mount(m) {
      if (m != "/" && match(m, /^\/[^\/]+/)) return substr(m, RSTART, RLENGTH)
      return m
    }
    function human_bar(b,   g) {
      g = b / 1073741824
      return g >= 100 ? sprintf("%.0fG", g) : sprintf("%.1fG", g)
    }
    # Tooltip sizes: two decimals and a spaced unit ("307.31 GiB") — the
    # compact "307G" form read as one token and was hard to scan.
    function human(b) { return sprintf("%.2f GiB", b / 1073741824) }
    function bar(p,   i, s) {
      s = "["
      for (i = 1; i <= 10; i++) s = s (i <= int(p / 10) ? "■" : "□")
      return s "]"
    }
    # df rounds capacity up, so match it: a table that disagrees by a percent
    # with what df itself prints reads as a bug.
    function dfpct(used, avail,   cap, raw) {
      cap = used + avail
      raw = cap > 0 ? used * 100 / cap : 0
      return (raw == int(raw)) ? raw : int(raw) + 1
    }
    # Strip partition suffixes explicitly to preserve whole-disk device names.
    function diskof(dev,   d) {
      d = dev
      sub(/^\/dev\//, "", d)
      if (d ~ /^(nvme[0-9]+n[0-9]+|mmcblk[0-9]+)p[0-9]+$/) sub(/p[0-9]+$/, "", d)
      else if (d ~ /^[a-z]+[0-9]+$/) sub(/[0-9]+$/, "", d)
      return d
    }
    # df -T columns: fs type size used avail cap% mount...
    NR > 1 && $1 ~ /^\/dev\// {
      m = $7
      for (i = 8; i <= NF; i++) m = m " " $i
      if (seen[$1]++) next
      gsub(/&/, "\\&amp;", m); gsub(/</, "\\&lt;", m); gsub(/>/, "\\&gt;", m)

      d = diskof($1)
      tot[d] += $3; usd[d] += $4; avl[d] += $5
      # Use the shallowest mount and its filesystem type as the drive label.
      if (!(d in lbl) || length(m) < length(lbl[d])) { lbl[d] = m; fst[d] = $2 }
    }
    # Two lines per drive: "DK n (mount)  used / total (pct) - fstype", then
    # "bar · temperature".
    END {
      n = 0
      for (d in tot) ord[++n] = d
      # Insertion sort by mount path — a handful of drives, and sorting here
      # keeps each pair of lines together, which piping to sort would not.
      for (i = 2; i <= n; i++) {
        k = ord[i]
        for (j = i - 1; j >= 1 && lbl[ord[j]] > lbl[k]; j--) ord[j + 1] = ord[j]
        ord[j + 1] = k
      }

      table = ""; text = ""
      for (i = 1; i <= n; i++) {
        d = ord[i]
        pct = dfpct(usd[d], avl[d])
        tc = (d in tmap) ? tmap[d] / 1000 : -1
        t = tc >= 0 ? sprintf("%.0f°C", tc) : "--"
        if (pct > worst_pct) worst_pct = pct
        if (tc > worst_temp) worst_temp = tc
        if (i > 1) table = table "\n\n"
        # The printed share is used/total (what the numbers on the line show);
        # dfpct above, which excludes the ext4 reserve, only drives the colour.
        share = tot[d] > 0 ? int(usd[d] * 100 / tot[d] + 0.5) : 0
        table = table sprintf("DK %d (%s)   %s / %s (%d%%) - %s\n", i, lbl[d], human(usd[d]), human(tot[d]), share, fst[d])
        table = table sprintf("%s · %s", bar(share), t)
        # Dim mount labels and separators to emphasize free space and temperature.
        text = text (i > 1 ? "  <span alpha=\"60%\">·</span>  " : "") \
               "<span alpha=\"60%\">" short_mount(lbl[d]) "</span>  " human_bar(avl[d]) \
               (tc >= 0 ? sprintf("  %.0f°C", tc) : "")
      }
      # Scalars on the first line, the multi-line table after it; the shell
      # splits on that first newline below (read would stop at it).
      printf "%s\t%d\t%d\n%s", text, worst_pct, worst_temp, table
    }
  '
)"
first_line="${df_out%%$'\n'*}"
disk_table="${df_out#*$'\n'}"
IFS=$'\t' read -r bar_text worst_pct worst_temp <<< "$first_line"
[ -n "${disk_table:-}" ] && [ "$disk_table" != "$df_out" ] || disk_table="Unavailable"
[ -n "${bar_text:-}" ] || bar_text="n/a"

# Use the worst drive: 70/80 °C leaves headroom below the 85 °C SMART warning.
class="normal"
if   [ "${worst_pct:-0}" -ge 95 ] || [ "${worst_temp:-0}" -ge 80 ]; then class="critical"
elif [ "${worst_pct:-0}" -ge 85 ] || [ "${worst_temp:-0}" -ge 70 ]; then class="warning"
fi

tooltip="<b><span foreground='$ACCENT'>DISKS</span></b>
$SEP
<tt>${disk_table}</tt>"

jq -cn \
  --arg text "${ICON_DISK}  ${bar_text}" \
  --arg tooltip "$tooltip" \
  --arg class "$class" \
  '{text: $text, tooltip: $tooltip, class: $class}'
