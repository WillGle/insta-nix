#!/usr/bin/env bash
# Toggle ONLY the refresh rate between 60 and 120 for eDP-1.

set -euo pipefail

notify() {
  command -v notify-send >/dev/null 2>&1 && notify-send "Refresh Rate" "$1"
  return 0
}

notify_error() {
  command -v notify-send >/dev/null 2>&1 && notify-send -u critical "Refresh Rate" "$1"
  return 0
}

if ! monitors_json="$(hyprctl monitors all -j)"; then
  notify_error "Unable to read monitors from Hyprland"
  exit 1
fi

if ! monitor="$(jq -cer '.[] | select(.name == "eDP-1" and .disabled == false)' <<< "$monitors_json")"; then
  notify_error "eDP-1 is not active"
  exit 1
fi

IFS=$'\t' read -r name width height x y scale transform current_rate < <(
  jq -r '[.name, .width, .height, .x, .y, .scale, .transform, (.refreshRate | round)] | @tsv' <<< "$monitor"
)
if [ "$current_rate" = "60" ]; then
  target_rate=120
else
  target_rate=60
fi

if ! target_mode="$(
  jq -er \
    --argjson target "$target_rate" \
    --argjson width "$width" \
    --argjson height "$height" '
    .transform as $transform
    | first(
      .availableModes[]
      | capture("^(?<mode_width>[0-9]+)x(?<mode_height>[0-9]+)@(?<rate>[0-9.]+)Hz$")
      | select(
          ((.mode_width | tonumber) == $width and (.mode_height | tonumber) == $height)
          or (
            ($transform == 1 or $transform == 3)
            and ((.mode_width | tonumber) == $height and (.mode_height | tonumber) == $width)
          )
        )
      | select((.rate | tonumber | round) == $target)
      | "\(.mode_width)x\(.mode_height)@\(.rate)"
    )
  ' <<< "$monitor"
)"; then
  notify_error "${width}x${height}@${target_rate}Hz is not available on eDP-1"
  exit 1
fi

rule="$name,$target_mode,${x}x${y},$scale,transform,$transform"
if hyprctl keyword monitor "$rule"; then
  notify "eDP-1 switched to ${target_rate}Hz"
else
  notify_error "Failed to switch eDP-1 to ${target_rate}Hz"
  exit 1
fi
