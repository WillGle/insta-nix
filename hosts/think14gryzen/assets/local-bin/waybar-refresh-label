#!/usr/bin/env bash
set -euo pipefail

if ! monitors_json="$(hyprctl monitors -j 2>/dev/null)"; then
  printf '?Hz\n'
  exit 0
fi

if ! label="$(jq -er '.[] | select(.name == "eDP-1") | (.refreshRate | round | tostring) + "Hz"' <<< "$monitors_json" 2>/dev/null)"; then
  printf '?Hz\n'
  exit 0
fi

printf '%s\n' "$label"
