#!/usr/bin/env bash
set -euo pipefail

HYPR_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf"

if [ ! -r "$HYPR_CONF" ]; then
  command -v notify-send >/dev/null 2>&1 && notify-send "Keybindings" "Cannot read hyprland.conf"
  exit 1
fi

ROFI_COMMON=(
  -dmenu
  -i
  -markup-rows
  -config "$HOME/.config/rofi/config.rasi"
  -theme-str 'window { width: 90%; }'
  -theme-str 'listview { columns: 3; lines: 14; spacing: 4px; }'
  -theme-str 'element { children: [ element-text ]; padding: 4px 8px; }'
  -theme-str 'element-text { font: "JetBrainsMono Nerd Font Mono 10.5"; }'
)

parsed_list="$(
awk '
  function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
  function modname(m) {
    if (m == "$mod" || m == "SUPER" || m == "MOD4") return "Super"
    if (m == "SHIFT") return "Shift"
    if (m == "ALT")   return "Alt"
    if (m == "CTRL" || m == "CONTROL") return "Ctrl"
    return m
  }
  function keyname(k) {
    if (k ~ /^XF86/) {
      sub(/^XF86/, "", k)
      if (k == "AudioMute") return "Mute"
      if (k == "AudioLowerVolume") return "Vol-"
      if (k == "AudioRaiseVolume") return "Vol+"
      if (k == "AudioMicMute") return "MicMute"
      if (k == "MonBrightnessDown") return "Bright-"
      if (k == "MonBrightnessUp") return "Bright+"
      if (k == "TouchpadToggle") return "Touchpad"
      return k
    }
    if (k == "Return") return "Enter"
    if (k == "Escape") return "Esc"
    if (k == "period") return "."
    if (k == "Equal")  return "="
    if (k == "mouse:272") return "LMB"
    if (k == "mouse:273") return "RMB"
    if (k == "left" || k == "right" || k == "up" || k == "down") return toupper(substr(k, 1, 1)) substr(k, 2)
    return k
  }
  function combo(mods, key,   n, parts, i, out) {
    out = ""
    n = split(mods, parts, /[ \t]+/)
    for (i = 1; i <= n; i++) if (parts[i] != "") out = out modname(parts[i]) "+"
    return out keyname(key)
  }
  function dispdesc(disp, arg) {
    if (disp == "movefocus") {
      if (arg == "l") arg = "Left"; else if (arg == "r") arg = "Right"
      else if (arg == "u") arg = "Up"; else if (arg == "d") arg = "Down"
      return "Focus (" arg ")"
    }
    if (disp == "movetoworkspace") return "Move to WS " arg
    if (disp == "workspace") return "Workspace " arg
    if (disp == "killactive") return "Close Window"
    if (disp == "togglefloating") return "Toggle Float"
    if (disp == "exit") return "Exit Session"
    if (disp == "exec") {
      if (arg ~ /rofi.*power-menu/) return "Power Menu"
      if (arg ~ /rofi-show drun/) return "App Launcher"
      if (arg ~ /rofi-show calc/) return "Calculator"
      if (arg ~ /rofi-show emoji/) return "Emoji Picker"
      if (arg ~ /rofi-network/) return "Network Manager"
      if (arg ~ /rofi-clipboard/) return "Clipboard History"
      if (arg ~ /rofi-show window/) return "Window Switcher"
      if (arg ~ /toggle_waybar/) return "Toggle Waybar"
      if (arg ~ /monitor-setup/) return "Monitor Setup"
      if (arg ~ /theme-lock/) return "Lock Screen"
      if (arg ~ /foot yazi/) return "File Manager"
      if (arg ~ /^foot$/) return "Terminal"
      if (arg ~ /rotate_select/) return "Rotate Screen"
      if (arg ~ /toggle_touchpad/) return "Toggle Touchpad"
      if (arg ~ /wpctl set-mute/) return "Audio Mute"
      if (arg ~ /wpctl set-volume.*-/) return "Volume -"
      if (arg ~ /wpctl set-volume.*\+/) return "Volume +"
      if (arg ~ /brightnessctl.*-/) return "Brightness -"
      if (arg ~ /brightnessctl.*\+/) return "Brightness +"
      if (arg ~ /grim.*slurp/) return "Screenshot (Area)"
      if (arg ~ /grim/) return "Screenshot (Full)"
      return arg
    }
    return arg == "" ? disp : disp " " arg
  }
  # Rows are Pango markup: a bare & < > in a section or description breaks
  # the parse and rofi draws the row as "DDD" (all six Audio & Brightness
  # rows did). Everything that came from the conf is escaped.
  function esc(s) { gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); return s }
  function flush() {
    if (pend_combo == "") return
    s = (pend_sec != "") ? pend_sec : "General"
    printf "<span foreground=\"#89b4fa\">[%s]</span> <b>%-13s</b> ➔ %s\t|%s\n", esc(s), esc(pend_combo), esc(pend_desc), pend_cmd
    pend_combo = ""
  }
  BEGIN { sec = "Basic" }
  /^# --- .* ---/ { flush(); s = $0; sub(/^# --- /, "", s); sub(/ ---.*$/, "", s); sec = s; next }
  /^# ── .* ──/   { flush(); s = $0; sub(/^# ── /, "", s); sub(/ ──.*$/, "", s); sec = s; next }
  # Only keyboard binds: the bindm mouse drags (Super+LMB/RMB) are not
  # shortcuts one forgets, and they cannot be launched from a menu anyway.
  /^bind *=/ {
    line = $0; sub(/^bind *= */, "", line)
    if (match(line, /[ \t]+#.*$/)) line = substr(line, 1, RSTART - 1)
    n = split(line, f, ",")
    mods = trim(f[1]); key = trim(f[2]); disp = trim(f[3])
    arg = ""
    for (i = 4; i <= n; i++) arg = arg (i > 4 ? "," : "") f[i]
    arg = trim(arg)
    c = combo(mods, key)
    desc = dispdesc(disp, arg)
    cmd = (disp == "exec") ? arg : ""

    if (key ~ /^[0-9]$/ && pend_combo != "" && pend_mods == mods && pend_disp == disp && pend_sec == sec) {
      pend_combo = combo(mods, pend_first "..." key)
      pend_desc = (disp == "movetoworkspace") ? "Move to WS 1..5" : "Workspace 1..5"
      next
    }
    flush()
    pend_combo = c; pend_desc = desc; pend_cmd = cmd; pend_sec = sec; pend_mods = mods; pend_disp = disp; pend_first = key
  }
  END { flush() }
' "$HYPR_CONF"
)"

# rofi returns the row index (-format i), and the command is read from that
# same line of parsed_list. Looking the row up by its key as a substring
# picked the first line containing it: "Super+E" (File Manager) hit
# "Super+Enter" and launched a terminal, "Super+S" hit "Super+Shift+E".
idx="$(printf "%s\n" "$parsed_list" | cut -d$'\t' -f1 | rofi "${ROFI_COMMON[@]}" -format i -p "⌨ Shorthands" || true)"

if [ -n "$idx" ]; then
  cmd="$(printf "%s\n" "$parsed_list" | sed -n "$((idx + 1))p" | cut -d$'\t' -f2 | sed 's/^|//')"
  if [ -n "$cmd" ]; then
    cmd="${cmd//\~/$HOME}"
    eval "$cmd" &
  fi
fi
