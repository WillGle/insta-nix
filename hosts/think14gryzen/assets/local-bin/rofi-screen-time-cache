#!/usr/bin/env bash
set -euo pipefail

export PATH="/run/current-system/sw/bin:/etc/profiles/per-user/${USER:-$(id -un)}/bin:${HOME}/.nix-profile/bin:${PATH}"

SCREEN_TIME_CACHE_HOME="${SCREEN_TIME_CACHE_HOME:-${XDG_CACHE_HOME:-${HOME}/.cache}/rofi-screen-time}"
STATS_BIN="${STATS_BIN:-${HOME}/.local/bin/rofi-screen-time-stats}"

if [ ! -x "$STATS_BIN" ]; then
  printf 'rofi-screen-time-cache: stats binary not found at %s. Skipping refresh.\n' "$STATS_BIN" >&2
  exit 0
fi
CACHE_DIR="${SCREEN_TIME_CACHE_HOME}/popup-cache"
TARGET_DATE="$(date +%F)"
THEME_PALETTE_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/theme/generated/palette.json"

palette_stamp() {
  local digest=""
  if [ ! -r "$THEME_PALETTE_FILE" ]; then
    printf 'static\n'
    return 0
  fi

  digest="$(sha256sum "$THEME_PALETTE_FILE" 2>/dev/null || true)"
  [ -n "$digest" ] || {
    printf 'static\n'
    return 0
  }
  printf '%s\n' "${digest%% *}"
}

theme_file() {
  printf '%s/default-%s-theme.rasi\n' "$CACHE_DIR" "$1"
}

rows_file() {
  printf '%s/default-%s-rows.txt\n' "$CACHE_DIR" "$1"
}

date_file() {
  printf '%s/default-%s-date.txt\n' "$CACHE_DIR" "$1"
}

mkdir -p "$CACHE_DIR"

# One warm at a time. Both the timer and the popup's on-open refresh call this,
# and a warm is several seconds of CPU; a second caller while one is running
# would only redo the same work, so it leaves instead of queueing.
exec 9>"${CACHE_DIR}/.warm.lock"
flock -n 9 || exit 0

# All four views, not just summary. Rendering one view costs well over a second,
# and only summary was ever warmed, so every [A]/[F]/[S] keystroke paid that in
# full while [T] came back instantly. They are rendered by a single stats run:
# the day-file bundle behind them is view-independent and used to be rebuilt
# four times. The date stamps are written last, after the payloads, so a run
# interrupted midway leaves stale stamps that fail the freshness check rather
# than half-written views that pass it.
if "$STATS_BIN" --date "$TARGET_DATE" --all-views-dir "$CACHE_DIR"; then
  for view in summary activity health timer; do
    date_tmp="$(mktemp "${CACHE_DIR}/date.XXXXXX")"
    printf '%s\n%s\n' "$TARGET_DATE" "$(palette_stamp)" >"$date_tmp"
    mv "$date_tmp" "$(date_file "$view")"
  done
fi
