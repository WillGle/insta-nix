#!/usr/bin/env bash
# llm-list: every installed GGUF in the shared store, with size, plus what
# the local llama-server is currently serving (if it is up).
ROOT="${LLM_MODELS_DIR:-/mnt/vault/lmstudio-models}"
printf '%-72s %8s\n' 'MODEL (owner/repo/file)' 'SIZE'
find -L "$ROOT" -name '*.gguf' ! -name 'mmproj*' -printf '%P\t%s\n' | sort \
  | awk -F'\t' '{ printf "%-72s %7.1fG\n", $1, $2/1073741824 }'
SERVING="$(curl -s -m 1 "http://127.0.0.1:${LLM_PORT:-8080}/v1/models" 2>/dev/null \
  | jq -r '.data[0].id' 2>/dev/null || true)"
if [ -n "${SERVING:-}" ] && [ "$SERVING" != "null" ]; then
  echo
  echo "serving on :${LLM_PORT:-8080} -> $(basename "$SERVING")"
else
  echo
  echo "llama-server: not running"
fi
