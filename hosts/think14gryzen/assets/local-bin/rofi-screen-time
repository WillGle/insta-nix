#!/usr/bin/env bash
set -euo pipefail

# Substituted at build time, like the network lib: the path needs no runtime
# resolver, cannot dangle before home-manager has linked, and always matches
# the libraries this build of the script was checked against.
SCREEN_TIME_LIB_DIR="@screenTimeLib@/lib"
# shellcheck source=/dev/null
. "$SCREEN_TIME_LIB_DIR/common.sh"

ROFI_CONFIG="${HOME}/.config/rofi/config.rasi"
ROFI_THEME="${HOME}/.config/rofi/screen-time.rasi"
STATS_BIN="${STATS_BIN:-${HOME}/.local/bin/rofi-screen-time-stats}"
CACHE_BIN="${CACHE_BIN:-${HOME}/.local/bin/rofi-screen-time-cache}"
CACHE_DIR="${SCREEN_TIME_CACHE_HOME}/popup-cache"

VIEW="summary"
TARGET_DATE="$(date +%F)"

palette_stamp() {
  local digest=""
  if [ ! -r "$THEME_PALETTE_FILE" ]; then
    printf 'static\n'
    return 0
  fi

  digest="$(sha256sum "$THEME_PALETTE_FILE" 2>/dev/null || true)"
  [ -n "$digest" ] || {
    printf 'static\n'
    return 0
  }
  printf '%s\n' "${digest%% *}"
}

usage() {
  cat <<'EOF'
Usage: rofi-screen-time [--date YYYY-MM-DD] [--view summary|activity|health|timer]
EOF
}

default_theme_cache_file() {
  printf "%s/default-%s-theme.rasi\n" "$CACHE_DIR" "$VIEW"
}

default_rows_cache_file() {
  printf "%s/default-%s-rows.txt\n" "$CACHE_DIR" "$VIEW"
}

default_date_cache_file() {
  printf "%s/default-%s-date.txt\n" "$CACHE_DIR" "$VIEW"
}

can_use_default_cache() {
  local today
  local cached_date=""
  local cached_palette=""
  today="$(date +%F)"
  # Every view caches now, keyed by name; the popup used to recompute all
  # three non-summary views from scratch on each switch.
  [ "$TARGET_DATE" = "$today" ] || return 1
  [ -r "$(default_theme_cache_file)" ] || return 1
  [ -r "$(default_rows_cache_file)" ] || return 1
  [ -r "$(default_date_cache_file)" ] || return 1
  if ! {
    read -r cached_date
    read -r cached_palette
  } < "$(default_date_cache_file)"; then
    return 1
  fi
  [ "$cached_date" = "$today" ] || return 1
  [ "$cached_palette" = "$(palette_stamp)" ]
}

# Seconds a warmed view may be before opening it triggers a background
# re-warm. Every open and every view switch used to spawn a full warm (~10 s
# of CPU) even when the cache was seconds old.
CACHE_STALE_SECONDS=120

refresh_default_cache_async() {
  local stamp age
  stamp="$(default_date_cache_file)"
  if [ -f "$stamp" ]; then
    age=$(( $(date +%s) - $(stat -c %Y "$stamp" 2>/dev/null || echo 0) ))
    [ "$age" -ge "$CACHE_STALE_SECONDS" ] || return 0
  fi
  if [ -x "$CACHE_BIN" ]; then
    setsid -f "$CACHE_BIN" >/dev/null 2>&1 || true
  fi
}

write_default_cache() {
  local theme_str="$1"
  local rows_file="$2"
  local today
  local theme_tmp=""
  local rows_tmp=""
  local date_tmp=""

  today="$(date +%F)"
  mkdir -p "$CACHE_DIR"
  theme_tmp="$(mktemp "${CACHE_DIR}/theme.XXXXXX")"
  rows_tmp="$(mktemp "${CACHE_DIR}/rows.XXXXXX")"
  date_tmp="$(mktemp "${CACHE_DIR}/date.XXXXXX")"

  printf '%s' "$theme_str" >"$theme_tmp"
  cat "$rows_file" >"$rows_tmp"
  printf '%s\n%s\n' "$today" "$(palette_stamp)" >"$date_tmp"

  mv "$theme_tmp" "$(default_theme_cache_file)"
  mv "$rows_tmp" "$(default_rows_cache_file)"
  mv "$date_tmp" "$(default_date_cache_file)"
}

is_default_today_view() {
  local today
  today="$(date +%F)"
  [ "$TARGET_DATE" = "$today" ]
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --date)
      TARGET_DATE="${2:-}"
      shift 2
      ;;
    --view)
      VIEW="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

TARGET_DATE="$(date -d "$TARGET_DATE" +%F 2>/dev/null || date +%F)"
if ! VIEW="$(resolve_screen_time_view "$VIEW")"; then
  printf 'rofi-screen-time: invalid view %s\n' "$VIEW" >&2
  exit 2
fi

while :; do
  local_theme_file=""
  local_rows_file=""
  theme_str=""
  rows_file=""

  if can_use_default_cache; then
    theme_str="$(cat "$(default_theme_cache_file)")"
    rows_file="$(default_rows_cache_file)"
    refresh_default_cache_async
  else
    local_theme_file="$(mktemp)"
    local_rows_file="$(mktemp)"
    "$STATS_BIN" --view "$VIEW" --date "$TARGET_DATE" --format files --theme-file "$local_theme_file" --rows-file "$local_rows_file"
    theme_str="$(cat "$local_theme_file")"
    rows_file="$local_rows_file"
    if is_default_today_view; then
      write_default_cache "$theme_str" "$rows_file"
    fi
    rm -f "$local_theme_file"
  fi

  if ! selection_idx="$(
    cat "$rows_file" \
      | rofi -dmenu -markup-rows -show-icons -no-custom -format i \
          -config "$ROFI_CONFIG" \
          -theme "$ROFI_THEME" \
          -theme-str "$theme_str" \
          -p ""
  )"; then
    if [ -n "$local_rows_file" ] && [ -f "$local_rows_file" ]; then
      rm -f "$local_rows_file"
    fi
    exit 0
  fi

  # Rofi rows contain a NUL separator before metadata. Bash strips NUL bytes
  # during command substitution, so read the token with a byte-safe tool.
  selection="$(
    perl -ne '
      BEGIN { $target = shift @ARGV }
      if ($. == $target) {
        s/\x00.*//s;
        print;
        exit 0;
      }
    ' "$((selection_idx + 1))" "$rows_file"
  )"

  if [ -n "$local_rows_file" ] && [ -f "$local_rows_file" ]; then
    rm -f "$local_rows_file"
  fi

  case "$selection" in
    close|"")
      exit 0
      ;;
    view:study-timer:*|view:timer:*)
      setsid -f "${HOME}/.local/bin/rofi-study-timer" >/dev/null 2>&1 || true
      exit 0
      ;;
    view:*:*)
      VIEW="${selection#view:}"
      VIEW="${VIEW%%:*}"
      TARGET_DATE="${selection##*:}"
      ;;
    nav:prev-day:*)
      TARGET_DATE="$(printf '%s' "$selection" | cut -d: -f3)"
      VIEW="$(printf '%s' "$selection" | cut -d: -f4)"
      ;;
    nav:next-day:*)
      TARGET_DATE="$(printf '%s' "$selection" | cut -d: -f3)"
      VIEW="$(printf '%s' "$selection" | cut -d: -f4)"
      ;;
    refresh:*)
      :
      ;;
    *)
      exit 0
      ;;
  esac
done
