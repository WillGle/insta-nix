#!/usr/bin/env bash
# llm-run: launch llama-server for <model> with auto-sized, overflow-safe settings.
# Model-agnostic: uses llama-fit-params to pick the lightest KV-cache type that keeps
# FULL GPU offload at the requested context (f16 -> q8_0 -> q4_0), so it never silently
# spills to CPU. Universal good defaults baked in: -fa on, -ngl (fitted), mmap, 8 threads.
#
# Usage: llm-run [--dry-run] <model.gguf> [context=8192] [-- extra llama-server args]
set -uo pipefail
export PATH="/run/current-system/sw/bin:${PATH:-}"   # find llama-fit-params/llama-server from systemPackages
FIT="${LLAMA_FIT_PARAMS:-llama-fit-params}"
SERVER="${LLAMA_SERVER:-llama-server}"
HOST="${LLM_HOST:-127.0.0.1}"; PORT="${LLM_PORT:-8080}"
DRY=0; [ "${1:-}" = "--dry-run" ] && { DRY=1; shift; }
MODEL="${1:?usage: llm-run [--dry-run] <model.gguf> [context] [-- extra args]}"; shift
CTX=8192
if [ "${1:-}" ] && [ -z "${1//[0-9]/}" ]; then CTX="$1"; shift; fi
[ "${1:-}" = "--" ] && shift
[ -f "$MODEL" ] || { echo "no such model: $MODEL" >&2; exit 2; }

fit(){ "$FIT" -m "$MODEL" -c "$CTX" -fa on "$@" 2>/dev/null; }
nglof(){ printf '%s' "$1" | grep -oE '\-ngl[[:space:]]+-?[0-9]+' | awk '{print $2}'; }

KVNAME=f16; KVARGS=(); FITTED="$(fit)"
if [ "$(nglof "$FITTED")" != "-1" ]; then
  o="$(fit --cache-type-k q8_0 --cache-type-v q8_0)"
  if [ "$(nglof "$o")" = "-1" ]; then
    KVNAME=q8_0; KVARGS=(--cache-type-k q8_0 --cache-type-v q8_0); FITTED="$o"
  else
    o="$(fit --cache-type-k q4_0 --cache-type-v q4_0)"
    KVNAME=q4_0; KVARGS=(--cache-type-k q4_0 --cache-type-v q4_0); FITTED="$o"
    [ "$(nglof "$o")" = "-1" ] || echo "WARN: ctx=$CTX won't fully fit even with q4 KV; partial offload (slower). Raise GTT or lower ctx." >&2
  fi
fi
# shellcheck disable=SC2086  # FITTED ("-c N -ngl M") must word-split into args
CMD=("$SERVER" -m "$MODEL" $FITTED -fa on "${KVARGS[@]}" -t 8 --host "$HOST" --port "$PORT" "$@")
echo "llm-run: $(basename "$MODEL") ctx=$CTX KV=$KVNAME ngl=$(nglof "$FITTED") -> http://$HOST:$PORT" >&2
if [ "$DRY" = 1 ]; then printf '%q ' "${CMD[@]}"; echo; exit 0; fi
exec "${CMD[@]}"
