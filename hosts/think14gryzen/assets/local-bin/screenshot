#!/usr/bin/env bash
# screenshot: capture the screen, save a timestamped file, and copy to clipboard.
#
# The Super+S / Super+Shift+S / Super+C binds used to call grim inline from
# hyprland.conf. They worked, but silently: nothing said a shot had been taken,
# only the Super+C variant reached the clipboard, and the epoch-second filenames
# collided when two presses landed inside the same second.
#
# notify-send is why this is a wrapped script rather than a longer bind line --
# libnotify is not in systemPackages, so it exists on PATH only through the
# runtimeInputs of the writeShellApplication wrapper in hyprland-helpers.nix.
set -euo pipefail
export PATH="$PATH:/run/current-system/sw/bin"

MODE="${1:-full}"
SHOT_DIR="$HOME/Pictures"

notify_error() {
  notify-send -u critical "Screenshot" "$1"
}

case "$MODE" in
  full | region | clip) ;;
  *)
    notify_error "Unknown mode: $MODE (expected full, region or clip)"
    exit 1
    ;;
esac

GRIM_ARGS=()
if [ "$MODE" != "full" ]; then
  # slurp exits non-zero when the selection is cancelled with Escape or a
  # right-click. That is a normal way to back out, not something to report.
  GEOMETRY="$(slurp)" || exit 0
  [ -n "$GEOMETRY" ] || exit 0
  GRIM_ARGS=(-g "$GEOMETRY")
fi

# -t is explicit so the clipboard advertises image/png rather than whatever
# wl-copy guesses from a pipe.
if [ "$MODE" = "clip" ]; then
  if ! grim "${GRIM_ARGS[@]}" - | wl-copy -t image/png; then
    notify_error "grim failed to capture"
    exit 1
  fi
  notify-send "Screenshot" "Copied to clipboard"
  exit 0
fi

mkdir -p "$SHOT_DIR"
if [ "$MODE" = "region" ]; then PREFIX=selection; else PREFIX=screenshot; fi
FILE="$SHOT_DIR/$PREFIX-$(date +%Y%m%d-%H%M%S).png"

if ! grim "${GRIM_ARGS[@]}" - | tee "$FILE" | wl-copy -t image/png; then
  notify_error "grim failed to capture"
  rm -f "$FILE"
  exit 1
fi

notify-send "Screenshot" "$(basename "$FILE") → ~/Pictures + clipboard"
