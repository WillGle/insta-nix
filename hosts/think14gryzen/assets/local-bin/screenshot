#!/usr/bin/env bash
# Save a timestamped screenshot and copy it to the clipboard.
# The hyprland-helpers.nix wrapper supplies notify-send through runtimeInputs.
set -euo pipefail
export PATH="$PATH:/run/current-system/sw/bin"

MODE="${1:-full}"
SHOT_DIR="$HOME/Pictures"

notify_error() {
  notify-send -u critical "Screenshot" "$1"
}

case "$MODE" in
  full | region | clip) ;;
  *)
    notify_error "Unknown mode: $MODE (expected full, region or clip)"
    exit 1
    ;;
esac

GRIM_ARGS=()
if [ "$MODE" != "full" ]; then
  # Treat Escape or right-click cancellation as normal.
  GEOMETRY="$(slurp)" || exit 0
  [ -n "$GEOMETRY" ] || exit 0
  GRIM_ARGS=(-g "$GEOMETRY")
fi

# Advertise image/png explicitly rather than relying on MIME detection.
if [ "$MODE" = "clip" ]; then
  if ! grim "${GRIM_ARGS[@]}" - | wl-copy -t image/png; then
    notify_error "grim failed to capture"
    exit 1
  fi
  notify-send "Screenshot" "Copied to clipboard"
  exit 0
fi

mkdir -p "$SHOT_DIR"
if [ "$MODE" = "region" ]; then PREFIX=selection; else PREFIX=screenshot; fi
FILE="$SHOT_DIR/$PREFIX-$(date +%Y%m%d-%H%M%S).png"

if ! grim "${GRIM_ARGS[@]}" - | tee "$FILE" | wl-copy -t image/png; then
  notify_error "grim failed to capture"
  rm -f "$FILE"
  exit 1
fi

notify-send "Screenshot" "$(basename "$FILE") → ~/Pictures + clipboard"
