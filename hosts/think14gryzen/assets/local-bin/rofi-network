#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
export PATH="$PATH:/run/current-system/sw/bin"

ROFI_THEME="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/network.rasi"

# Shared nmcli query helpers, substituted to a store path at build time so the
# two callers cannot drift apart again. See the header of that file for the two
# same-named helpers that deliberately stay private to each caller.
# shellcheck source=/dev/null
. "@networkLib@"

ROFI_COMMON=(
  -dmenu
  -i
  -markup-rows
  -config "$HOME/.config/rofi/config.rasi"
  -theme "$ROFI_THEME"
)

NMCLI_CONNECT_TIMEOUT="${NMCLI_CONNECT_TIMEOUT:-20}"
WAYBAR_NETWORK_SIGNAL="${WAYBAR_NETWORK_SIGNAL:-6}"
status_message=""

close_existing_rofi() {
  if pgrep -x rofi >/dev/null 2>&1; then
    pkill -x rofi
    sleep 0.1
  fi
}

strip_ansi() {
  printf '%s' "$1" | sed 's/\x1b\[[0-9;]*[a-zA-Z]//g'
}

first_line() {
  strip_ansi "$1" | sed -n '1p'
}

refresh_waybar_network() {
  pkill -RTMIN+"$WAYBAR_NETWORK_SIGNAL" waybar >/dev/null 2>&1 || true
}

active_wifi_ap_line() {
  local iface="$1"
  local target_ssid="${2:-}"
  local masked_ssid="${target_ssid//:/$'\x01'}"
  local ap_line=""

  ap_line="$(nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY,FREQ,BSSID device wifi list ifname "$iface" --rescan no \
    | sed 's/\\:/\x01/g' \
    | awk -F: '$1 == "*" && !found { print; found = 1 }')"

  if [ -n "$ap_line" ]; then
    printf '%s\n' "$ap_line"
    return 0
  fi

  [ -n "$masked_ssid" ] || return 0

  nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY,FREQ,BSSID device wifi list ifname "$iface" --rescan no \
    | sed 's/\\:/\x01/g' \
    | awk -F: -v target="$masked_ssid" '$2 == target && !found { print; found = 1 }'
}

lookup_ap() {
  local iface="$1"
  local bssid="$2"
  local masked_bssid="${bssid//:/$'\x01'}"
  nmcli -t -f ACTIVE,SSID,SIGNAL,SECURITY,FREQ,BSSID device wifi list ifname "$iface" --rescan no \
    | sed 's/\\:/\x01/g' \
    | awk -F: -v target="$masked_bssid" '$6 == target && !found { print; found = 1 }'
}

current_ip_cidr() {
  local iface="$1"
  ip -4 -o addr show dev "$iface" 2>/dev/null | awk 'NR==1 {print $4}'
}

current_broadcast() {
  local iface="$1"
  ip -4 -o addr show dev "$iface" 2>/dev/null | awk 'NR==1 {for(i=1;i<=NF;i++) if($i=="brd") print $(i+1)}'
}

current_mac() {
  local iface="$1"
  ip link show dev "$iface" 2>/dev/null | awk '/link\/ether/ {print $2}'
}

cidr_to_netmask() {
  local prefix="${1:-0}"
  [ -z "$prefix" ] && prefix=0
  local mask=$(( 0xFFFFFFFF << (32 - prefix) ))
  printf "%d.%d.%d.%d\n" \
    $(( (mask >> 24) & 0xFF )) \
    $(( (mask >> 16) & 0xFF )) \
    $(( (mask >> 8) & 0xFF )) \
    $(( mask & 0xFF ))
}

active_ethernet() {
  nmcli -t -f TYPE,NAME,DEVICE connection show --active \
    | sed 's/\\:/\x01/g' \
    | awk -F: '$1 == "802-3-ethernet" && !found {
        name=$2; device=$3;
        gsub(/\x01/, ":", name); gsub(/\x01/, ":", device);
        print name " on " device; found = 1
      }'
}

ethernet_ifaces() {
  nmcli -t -f DEVICE,TYPE,STATE device \
    | sed 's/\\:/\x01/g' \
    | awk -F: '$2 == "ethernet" && $3 != "unmanaged" { print $1 ":" $3 }'
}

saved_networks() {
  nmcli -t -f NAME,UUID,TYPE,DEVICE connection show \
    | sed 's/\\:/\x01/g' \
    | while IFS=: read -r name uuid type device; do
        [ -n "$name" ] || continue
        [ -n "$uuid" ] || continue
        case "$type" in
          802-11-wireless|802-3-ethernet)
            name="${name//$'\x01'/:}"
            device="${device//$'\x01'/:}"
            printf '%s\t%s\t%s\t%s\n' "$name" "$uuid" "$type" "${device:-}"
            ;;
        esac
      done
}

saved_wifi_uuid_by_name() {
  local ssid="$1"
  local masked_ssid="${ssid//:/$'\x01'}"
  nmcli -t -f NAME,UUID,TYPE connection show \
    | sed 's/\\:/\x01/g' \
    | awk -F: -v target="$masked_ssid" '$3 == "802-11-wireless" && $1 == target && !found { print $2; found = 1 }'
}

wifi_network_entries() {
  local iface="$1"

  nmcli -t -f ACTIVE,SSID,SIGNAL,SECURITY,FREQ,BSSID device wifi list ifname "$iface" --rescan no \
    | sed 's/\\:/\x01/g' \
    | while IFS=: read -r active s sig sec freq b; do
        [ -n "$b" ] || continue
        s="${s//$'\x01'/:}"
        # Hidden SSIDs use the explicit hidden-network action.
        [ -n "$s" ] || continue
        [ "$active" = "yes" ] && prefix='󰄬' || prefix=' '
        b="${b//$'\x01'/:}"
        printf 'ap:%s\0display\x1f%s  %s  %s  %s%%  %s  %s\n' \
          "$b" \
          "$prefix" \
          "$(signal_icon "$sig")" \
          "$s" \
          "${sig:-0}" \
          "$(band_label "$freq")" \
          "$(security_label "$sec")"
      done
}

network_type_label() {
  case "${1:-}" in
    802-11-wireless)
      printf 'Wi-Fi'
      ;;
    802-3-ethernet)
      printf 'Ethernet'
      ;;
    *)
      printf '%s' "${1:-Unknown}"
      ;;
  esac
}

network_type_icon() {
  case "${1:-}" in
    802-11-wireless)
      printf '󰖩'
      ;;
    802-3-ethernet)
      printf '󰈀'
      ;;
    *)
      printf '󰛳'
      ;;
  esac
}

prompt_text() {
  local prompt="$1"
  rofi "${ROFI_COMMON[@]}" -p "$prompt" <<< "" || true
}

scan_network() {
  local iface="$1"

  if [ -z "$iface" ]; then
    status_message="No Wi-Fi adapter detected."
    return 0
  fi

  if ! wifi_enabled; then
    status_message="Wi-Fi is disabled. Turn it on first."
    return 0
  fi

  nmcli device wifi rescan ifname "$iface" >/dev/null 2>&1 || true
  status_message="Requested a Wi-Fi scan."
}

connect_wired_network() {
  local devices selection iface state output count=0

  devices="$(ethernet_ifaces)"
  [ -n "$devices" ] || {
    status_message="No Ethernet adapter detected."
    return 0
  }

  while IFS= read -r _line; do
    [ -n "$_line" ] && count=$((count + 1))
  done <<< "$devices"

  if [ "$count" -eq 1 ]; then
    iface="${devices%%:*}"
    state="${devices#*:}"
    iface="${iface//$'\x01'/:}"
    [ "$state" = "connected" ] && {
      status_message="Ethernet ($iface) is already connected."
      return 0
    }
    output="$(nmcli --wait "$NMCLI_CONNECT_TIMEOUT" device connect "$iface" 2>&1)" && {
      status_message="$(first_line "$output")"
      return 0
    }
    status_message="$(first_line "$output")"
    return 0
  fi

  selection="$(
    while IFS=: read -r iface state; do
      [ -n "$iface" ] || continue
      iface="${iface//$'\x01'/:}"
      printf '󰈀  %s  %s\n' "$iface" "$state"
    done <<< "$devices" \
      | rofi "${ROFI_COMMON[@]}" -no-custom -p "Connect wired" -mesg "Choose the Ethernet device to bring up." || true
  )"

  [ -n "$selection" ] || {
    status_message="Wired connection cancelled."
    return 0
  }

  iface="$(printf '%s' "$selection" | awk '{print $2}')"
  [ -n "$iface" ] || {
    status_message="Could not determine which Ethernet device to connect."
    return 0
  }

  output="$(nmcli --wait "$NMCLI_CONNECT_TIMEOUT" device connect "$iface" 2>&1)" && {
    status_message="$(first_line "$output")"
    return 0
  }
  status_message="$(first_line "$output")"
}

disconnect_wired_network() {
  local ethernet_device
  ethernet_device="$(nmcli -t -f TYPE,DEVICE connection show --active | sed 's/\\:/\x01/g' | awk -F: '$1 == "802-3-ethernet" && !found { gsub(/\x01/, ":", $2); print $2; found = 1 }')"
  if [ -n "$ethernet_device" ]; then
    nmcli device disconnect "$ethernet_device" >/dev/null 2>&1 && status_message="Disconnected wired network." || status_message="Failed to disconnect wired network."
  else
    status_message="No active Ethernet connection to disconnect."
  fi
}

connect_new_network() {
  local iface="$1"
  local selection bssid ssid password output saved_uuid

  if [ -z "$iface" ]; then
    status_message="No Wi-Fi adapter detected."
    return 0
  fi

  if ! wifi_enabled; then
    status_message="Wi-Fi is disabled. Turn it on first."
    return 0
  fi

  selection="$(
    {
      printf '󰖫  Connect to hidden network\n'
      wifi_network_entries "$iface"
    } \
      | rofi "${ROFI_COMMON[@]}" -no-custom -p "Connect new" -mesg "Choose a nearby network or the hidden-network option." || true
  )"

  [ -n "$selection" ] || {
    status_message="Connection cancelled."
    return 0
  }

  if [ "$selection" = "󰖫  Connect to hidden network" ]; then
    ssid="$(prompt_text "SSID")"
    if [ -z "$ssid" ]; then
      status_message="Connection cancelled."
      return 0
    fi

    saved_uuid="$(saved_wifi_uuid_by_name "$ssid")"
    if [ -n "$saved_uuid" ]; then
      output="$(nmcli --wait "$NMCLI_CONNECT_TIMEOUT" connection up uuid "$saved_uuid" ifname "$iface" 2>&1)" && {
        status_message="$(first_line "$output")"
        return 0
      }
      status_message="$(first_line "$output")"
      return 0
    fi

    if ! password="$(rofi "${ROFI_COMMON[@]}" -password -p "Password (leave blank if open)" <<< "")"; then
      status_message="Connection cancelled."
      return 0
    fi
    if [ -n "$password" ]; then
      output="$(nmcli --wait "$NMCLI_CONNECT_TIMEOUT" device wifi connect "$ssid" ifname "$iface" password "$password" hidden yes 2>&1)" && {
        status_message="$(first_line "$output")"
        return 0
      }
    else
      output="$(nmcli --wait "$NMCLI_CONNECT_TIMEOUT" device wifi connect "$ssid" ifname "$iface" hidden yes 2>&1)" && {
        status_message="$(first_line "$output")"
        return 0
      }
    fi

    status_message="$(first_line "$output")"
    return 0
  fi

  if [[ "$selection" =~ ^ap:(([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2})$ ]]; then
    bssid="${BASH_REMATCH[1]}"
    connect_ap "$iface" "$bssid"
    return 0
  fi

  status_message="Unsupported selection."
}

edit_saved_network() {
  local entries selection uuid

  entries="$(
    saved_networks \
      | while IFS=$'\t' read -r name uuid type device; do
          printf '%s  %s  %s  %s  %s\n' \
            "$(network_type_icon "$type")" \
            "$name" \
            "$(network_type_label "$type")" \
            "$device" \
            "$uuid"
        done
  )"

  [ -n "$entries" ] || {
    status_message="No saved Wi-Fi or Ethernet networks found."
    return 0
  }

  selection="$(
    printf '%s\n' "$entries" \
      | rofi "${ROFI_COMMON[@]}" -no-custom -p "Edit saved network" -mesg "Choose a saved Wi-Fi or Ethernet profile to edit." || true
  )"

  [ -n "$selection" ] || {
    status_message="Edit saved network cancelled."
    return 0
  }

  if [[ "$selection" =~ ([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$ ]]; then
    uuid="${BASH_REMATCH[1]}"
    nm-connection-editor --edit="$uuid" >/dev/null 2>&1 &
    exit 0
  fi

  status_message="Could not determine which saved network to edit."
}

append_network_info() {
  local dev="$1"
  local ip_cidr ip prefix netmask broadcast mac gateway dns
  local route_details=""
  local device_details=""

  ip_cidr="$(current_ip_cidr "$dev")"
  ip="${ip_cidr%/*}"
  prefix="${ip_cidr#*/}"
  netmask="$(cidr_to_netmask "$prefix")"
  broadcast="$(current_broadcast "$dev")"
  mac="$(current_mac "$dev")"
  gateway="$(current_gateway "$dev")"
  dns="$(current_dns "$dev")"

  lines+=("IP: ${ip:-Unavailable}  •  Gateway: ${gateway:-Unavailable}")
  [ -n "$netmask" ] && [ "$netmask" != "0.0.0.0" ] && route_details="Subnet: $netmask"
  [ -n "$broadcast" ] && route_details+="${route_details:+  •  }Broadcast: $broadcast"
  [ -n "$route_details" ] && lines+=("$route_details")
  [ -n "$dns" ] && device_details="DNS: $dns"
  [ -n "$mac" ] && device_details+="${device_details:+  •  }MAC: $mac"
  [ -n "$device_details" ] && lines+=("$device_details")
}

build_message() {
  local iface="$1"
  local lines=()
  local ethernet wifi_conn wifi_name wifi_uuid wifi_ssid wifi_ap
  local ssid signal security freq
  local ethernet_device=""

  ethernet="$(active_ethernet)"
  wifi_conn=""
  wifi_name=""
  wifi_uuid=""
  wifi_ssid=""
  wifi_ap=""
  ssid=""
  signal=""
  security=""
  freq=""

  if [ -n "$iface" ]; then
    wifi_conn="$(active_wifi_connection "$iface")"
    if [ -n "$wifi_conn" ]; then
      IFS=$'\t' read -r wifi_name wifi_uuid _wifi_device <<< "$wifi_conn"
      wifi_ssid="$(connection_ssid "$wifi_uuid" "$wifi_name")"
      wifi_ap="$(active_wifi_ap_line "$iface" "$wifi_ssid")"
    fi
  fi

  if [ -n "$wifi_ap" ]; then
    IFS=: read -r _in_use ssid signal security freq _bssid <<< "$wifi_ap"
    ssid="${ssid//$'\x01'/:}"
    security="${security//$'\x01'/:}"
  else
    ssid="$wifi_ssid"
  fi

  if [ -n "$ethernet" ]; then
    ethernet_device="${ethernet##* on }"
    lines+=("Ethernet: $ethernet")
    append_network_info "$ethernet_device"

    if [ -n "$wifi_conn" ]; then
      lines+=("")
      if [ -n "$wifi_ap" ]; then
        lines+=("Wi-Fi: ${ssid:-<hidden>} ($(signal_icon "$signal") ${signal}%, $(band_label "$freq"))")
      else
        lines+=("Wi-Fi: ${ssid:-<hidden>} (connected)")
      fi
      append_network_info "$iface"
      if [ -n "$wifi_ap" ]; then
        lines+=("Security: $(security_label "$security")")
      fi
    elif [ -n "$iface" ] && ! wifi_enabled; then
      lines+=("Wi-Fi: disabled")
    elif [ -n "$iface" ]; then
      lines+=("Wi-Fi: enabled, not connected")
    fi
  elif [ -z "$iface" ]; then
    lines+=("No Wi-Fi adapter detected")
  elif [ -n "$wifi_conn" ]; then
    if [ -n "$wifi_ap" ]; then
      lines+=("Wi-Fi: ${ssid:-<hidden>} ($(signal_icon "$signal") ${signal}%, $(band_label "$freq"))")
    else
      lines+=("Wi-Fi: ${ssid:-<hidden>} (connected)")
    fi
    append_network_info "$iface"
    if [ -n "$wifi_ap" ]; then
      lines+=("Security: $(security_label "$security")")
    fi
  elif wifi_enabled; then
    lines+=("Wi-Fi: enabled, not connected")
  else
    lines+=("Wi-Fi: disabled")
  fi

  if [ -n "$status_message" ]; then
    lines+=("")
    lines+=("$status_message")
  fi

  printf '%s\n' "${lines[@]}"
}

build_menu() {
  local iface="$1"
  local ethernet wifi_conn
  ethernet="$(active_ethernet)"
  wifi_conn=""

  if [ -n "$iface" ]; then
    wifi_conn="$(active_wifi_connection "$iface")"
  fi

  printf 'section:actions\0display\x1f<b>QUICK ACTIONS</b>\x1factive\x1ftrue\n'
  printf '󰈀  Connect wired network\n'
  printf '󰖫  Connect new network\n'

  if [ -n "$iface" ] && wifi_enabled; then
    printf 'section:wifi\0display\x1f<b>NEARBY WI-FI</b>\x1factive\x1ftrue\n'
    wifi_network_entries "$iface"
  fi

  printf 'section:manage\0display\x1f<b>MANAGE</b>\x1factive\x1ftrue\n'
  if [ -n "$ethernet" ]; then
    printf '󰈂  Disconnect wired network\0urgent\x1ftrue\n'
  fi
  if [ -n "$wifi_conn" ]; then
    printf '󰤭  Disconnect current network\0urgent\x1ftrue\n'
  fi
  printf '󰌘  Edit saved network\n'

  if [ -n "$iface" ] && wifi_enabled; then
    printf '󰑐  Scan network\n'
    printf '󰖪  Turn Wi-Fi off\0urgent\x1ftrue\n'
  else
    printf '󰖩  Turn Wi-Fi on\n'
    if [ -n "$iface" ]; then
      printf '󰑐  Scan network\n'
    fi
  fi

  if [ -z "$iface" ] || ! wifi_enabled; then
    return
  fi
}

prompt_password() {
  local ssid="$1"
  rofi "${ROFI_COMMON[@]}" -password -p "Password for ${ssid:-Wi-Fi}" <<< "" || true
}

connect_ap() {
  local iface="$1"
  local bssid="$2"
  local ap
  local ssid security output password saved_uuid

  ap="$(lookup_ap "$iface" "$bssid")"
  if [ -z "$ap" ]; then
    status_message="Selected access point is no longer visible."
    return
  fi

  IFS=: read -r _active ssid _signal security _freq _bssid <<< "$ap"
  ssid="${ssid//$'\x01'/:}"
  security="${security//$'\x01'/:}"
  saved_uuid="$(saved_wifi_uuid_by_name "$ssid")"
  if [ -n "$saved_uuid" ]; then
    output="$(nmcli --wait "$NMCLI_CONNECT_TIMEOUT" connection up uuid "$saved_uuid" ifname "$iface" ap "$bssid" 2>&1)" && {
      status_message="Connected to ${ssid:-<hidden>}."
      return
    }
    status_message="$(first_line "$output")"
    return
  fi

  if [ -n "$security" ] && [ "$security" != "--" ]; then
    password="$(prompt_password "$ssid")"
    if [ -z "$password" ]; then
      status_message="Connection cancelled."
      return
    fi

    output="$(nmcli --wait "$NMCLI_CONNECT_TIMEOUT" device wifi connect "$ssid" ifname "$iface" bssid "$bssid" password "$password" 2>&1)" && {
      status_message="Connected to ${ssid:-<hidden>}."
      return
    }
  else
    output="$(nmcli --wait "$NMCLI_CONNECT_TIMEOUT" device wifi connect "$ssid" ifname "$iface" bssid "$bssid" 2>&1)" && {
      status_message="Connected to ${ssid:-<hidden>}."
      return
    }
  fi

  status_message="$(first_line "$output")"
}

main() {
  local iface result selection bssid
  local selected_row=1

  close_existing_rofi
  iface="$(wifi_iface)"

  while true; do
    result="$(
      build_menu "$iface" | rofi "${ROFI_COMMON[@]}" -no-custom -format 'i:s' -selected-row "$selected_row" -p "Network" -mesg "$(build_message "$iface")" || true
    )"

    [ -n "$result" ] || exit 0
    selected_row="${result%%:*}"
    selection="${result#*:}"
    status_message=""

    case "$selection" in
      section:*)
        continue
        ;;
      "󰈀  Connect wired network")
        connect_wired_network
        ;;
      "󰈂  Disconnect wired network")
        disconnect_wired_network
        ;;
      "󰖫  Connect new network")
        connect_new_network "$iface"
        ;;
      "󰌘  Edit saved network")
        edit_saved_network
        ;;
      "󰑐  Scan network")
        scan_network "$iface"
        ;;
      "󰖪  Turn Wi-Fi off")
        nmcli radio wifi off >/dev/null 2>&1 && status_message="Wi-Fi turned off." || status_message="Failed to turn Wi-Fi off."
        ;;
      "󰖩  Turn Wi-Fi on")
        if nmcli radio wifi on >/dev/null 2>&1; then
          sleep 0.5
          [ -n "$iface" ] && nmcli device wifi rescan ifname "$iface" >/dev/null 2>&1 || true
          status_message="Wi-Fi turned on."
        else
          status_message="Failed to turn Wi-Fi on."
        fi
        ;;
      "󰤭  Disconnect current network")
        if [ -n "$iface" ]; then
          nmcli device disconnect "$iface" >/dev/null 2>&1 && status_message="Disconnected $iface." || status_message="Failed to disconnect $iface."
        else
          status_message="No Wi-Fi adapter detected."
        fi
        ;;
      *)
        if [[ "$selection" =~ ^ap:(([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2})$ ]]; then
          bssid="${BASH_REMATCH[1]}"
          if [ -n "$iface" ]; then
            connect_ap "$iface" "$bssid"
          else
            status_message="No Wi-Fi adapter detected."
          fi
        else
          status_message="Unsupported selection."
        fi
        ;;
    esac

    refresh_waybar_network
    iface="$(wifi_iface)"
  done
}

main "$@"
