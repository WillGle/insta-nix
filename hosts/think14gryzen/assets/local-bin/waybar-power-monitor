#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
# Waybar consolidated hardware monitor
# Usage: waybar-power-monitor apu|pwr|toggle|bmode-toggle
#
# These four are what waybar's config.jsonc calls. Three further display modes
# (sys, prof, bmode) used to live here with no caller anywhere in the config;
# the pwr tooltip already shows everything they rendered.

MODE="${1:-pwr}"
# Colors are substituted at build time from theme.signal / theme.colors, so
# there is no palette to source and no fallback literal that could drift.
WARN_DIR="${XDG_RUNTIME_DIR:-/tmp}/waybar-power-monitor"
STATE_DIR="$WARN_DIR/state"
CPU_STAT_FILE="$STATE_DIR/cpu.stat"
BOARD_W_FILE="$STATE_DIR/board_w"
BAT_DIR=""
AMDGPU_HWMON=""
K10TEMP_HWMON=""
GPU_BUSY_PATH=""
CPU_FREQ_AVG="0.00"
CPU_FREQ_PEAK_CORE="C0"
CPU_FREQ_PEAK_GHZ="0.00"
CPU_POLICY_MAX_GHZ="N/A"
CPU_HARDWARE_MAX_GHZ="N/A"
CPU_CLOCK_STATUS="Unavailable"
CPU_POLICY_VALID_COUNT=0
CPU_CLOCK_CAP_COUNT=0

# --- Icons (Nerd Font Hex) ---
ICON_CPU=$(printf "\uf2db")
ICON_GPU=$(printf "\uf108")
ICON_BAT_100=$(printf "\uf240")
ICON_BAT_80=$(printf "\uf241")
ICON_BAT_60=$(printf "\uf242")
ICON_BAT_40=$(printf "\uf243")
ICON_BAT_20=$(printf "\uf244")
ICON_PLUG=$(printf "\uf1e6")
ICON_PERF=$(printf "\uf0e7")     # Bolt
ICON_BALANCED=$(printf "\uf24e") # Scales
ICON_SAVER=$(printf "\uf06c")   # Leaf

ACCENT="@themeAccent@"
SEP="<span alpha='30%'>──────────────────────────</span>"

# --- Helper Functions ---

# Progress bar helper
progress_bar() {
  local p=$1
  local width=${2:-10}
  local filled=$((p * width / 100))
  [ "$filled" -gt "$width" ] && filled=$width
  local empty=$((width - filled))
  local bar=""
  for ((i=0; i<filled; i++)); do bar+="■"; done
  for ((i=0; i<empty; i++)); do bar+="□"; done
  printf '[%s]' "$bar"
}

log_warn() {
    printf '[waybar-power-monitor] %s\n' "$*" >&2
}

warn_once() {
    local key="$1"
    local message="$2"
    local marker
    marker="$WARN_DIR/$key"

    mkdir -p "$WARN_DIR"
    if [ ! -e "$marker" ]; then
        log_warn "$message"
        : > "$marker"
    fi
}

# No fork on the happy path: this runs after every successful read, so the
# unconditional rm was ~15 processes per refresh for markers that never exist.
clear_warn() {
    local key="$1"
    [ -e "$WARN_DIR/$key" ] || return 0
    rm -f "$WARN_DIR/$key" 2>/dev/null || true
}

# One-line sysfs node via the read builtin. `cat` forked a process per value,
# and the apu and pwr modes read about forty of them every two seconds; that
# was most of the ~1 s of CPU each refresh cost. Fails when the node is
# unreadable, so callers keep their `|| echo 0` / `|| true` fallbacks.
read_node() {
    local value=""
    IFS= read -r value 2>/dev/null < "$1" || [ -n "$value" ] || return 1
    printf '%s\n' "$value"
}

# powerprofilesctl is a D-Bus round-trip (~0.1 s of CPU) and both bar modes
# asked it every two seconds. The coordinator's committed state is checked
# first; the answer is cached as "<epoch> <profile>" only when that marker is
# unavailable.
PROFILE_CACHE_FILE="$STATE_DIR/profile"
PROFILE_CACHE_SECONDS=10
PROFILE_OVERRIDE_FILE="/run/ryzenadj-profile/active"
PROFILE_CONFIG_FILE=/etc/ryzenadj-profiles.tsv

remember_power_profile() {
    local temporary
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    temporary="$(mktemp "$PROFILE_CACHE_FILE.XXXXXX" 2>/dev/null)" || return 0
    if ! {
        printf '%(%s)T %s\n' -1 "$1" > "$temporary"
        mv -f -- "$temporary" "$PROFILE_CACHE_FILE"
    } 2>/dev/null; then
        rm -f -- "$temporary" 2>/dev/null || true
    fi
}

get_power_profile() {
    local line stamp profile now override
    if override="$(read_node "$PROFILE_OVERRIDE_FILE" 2>/dev/null || true)"; then
        case "$override" in
            performance|sustained-build|balanced|power-saver)
                printf '%s\n' "$override"
                return 0
                ;;
        esac
    fi
    if line="$(read_node "$PROFILE_CACHE_FILE")"; then
        read -r stamp profile <<< "$line"
        printf -v now '%(%s)T' -1
        if is_uint "$stamp" && [ -n "$profile" ] && [ $((now - stamp)) -lt "$PROFILE_CACHE_SECONDS" ]; then
            printf '%s\n' "$profile"
            return 0
        fi
    fi
    profile="$(/run/current-system/sw/bin/powerprofilesctl get 2>/dev/null || echo "unknown")"
    remember_power_profile "$profile"
    printf '%s\n' "$profile"
}

is_uint() {
    case "$1" in
        ''|*[!0-9]*)
            return 1
            ;;
        *)
            return 0
            ;;
    esac
}

detect_battery_dir() {
    local d t
    if [ -n "$BAT_DIR" ] && [ -d "$BAT_DIR" ]; then
        return 0
    fi

    for d in /sys/class/power_supply/*; do
        [ -d "$d" ] || continue
        t="$(read_node "$d/type" || true)"
        if [ "$t" = "Battery" ]; then
            BAT_DIR="$d"
            clear_warn "battery_dir"
            return 0
        fi
    done

    BAT_DIR=""
    warn_once "battery_dir" "battery node not found under /sys/class/power_supply"
    return 1
}

battery_num() {
    local node="$1"
    local path
    if detect_battery_dir; then
        path="$BAT_DIR/$node"
        if [ -r "$path" ]; then
            clear_warn "battery_node_$node"
            read_node "$path" || true
        else
            warn_once "battery_node_$node" "missing battery node: $path"
            echo 0
        fi
    else
        echo 0
    fi
}

battery_text() {
    local node="$1"
    local fallback="$2"
    local path
    if detect_battery_dir; then
        path="$BAT_DIR/$node"
        if [ -r "$path" ]; then
            clear_warn "battery_text_$node"
            read_node "$path" || true
        else
            warn_once "battery_text_$node" "missing battery node: $path"
            echo "$fallback"
        fi
    else
        echo "$fallback"
    fi
}

battery_num_optional() {
    local node="$1"
    local fallback="${2:-0}"
    local path
    if detect_battery_dir; then
        path="$BAT_DIR/$node"
        if [ -r "$path" ]; then
            read_node "$path" || true
            return 0
        fi
    fi
    echo "$fallback"
}

battery_power_uw() {
    local current_uv current_ua
    if detect_battery_dir; then
        if [ -r "$BAT_DIR/power_now" ]; then
            clear_warn "battery_power"
            read_node "$BAT_DIR/power_now" || true
            return 0
        fi

        if [ -r "$BAT_DIR/current_now" ] && [ -r "$BAT_DIR/voltage_now" ]; then
            clear_warn "battery_power"
            current_ua="$(read_node "$BAT_DIR/current_now" || echo 0)"
            current_uv="$(read_node "$BAT_DIR/voltage_now" || echo 0)"
            awk -v ua="${current_ua:-0}" -v uv="${current_uv:-0}" 'BEGIN{printf "%.0f", (ua * uv) / 1000000}'
            return 0
        fi
    fi

    warn_once "battery_power" "missing battery power nodes: power_now or current_now+voltage_now"
    echo 0
}

battery_energy_uwh() {
    local kind="$1"
    local energy_node="energy_${kind}"
    local charge_node="charge_${kind}"
    local voltage_node="voltage_now"
    local charge_now voltage_now

    if detect_battery_dir; then
        if [ -r "$BAT_DIR/$energy_node" ]; then
            clear_warn "battery_energy_$kind"
            read_node "$BAT_DIR/$energy_node" || echo 0
            return 0
        fi

        if [ "$kind" = "full_design" ] && [ -r "$BAT_DIR/voltage_min_design" ]; then
            voltage_node="voltage_min_design"
        fi

        if [ -r "$BAT_DIR/$charge_node" ] && [ -r "$BAT_DIR/$voltage_node" ]; then
            clear_warn "battery_energy_$kind"
            charge_now="$(read_node "$BAT_DIR/$charge_node" || echo 0)"
            voltage_now="$(read_node "$BAT_DIR/$voltage_node" || echo 0)"
            awk -v c="${charge_now:-0}" -v v="${voltage_now:-0}" 'BEGIN{printf "%.0f", (c * v) / 1000000}'
            return 0
        fi
    fi

    warn_once "battery_energy_$kind" "missing battery energy nodes for '$kind': $energy_node or $charge_node+$voltage_node"
    echo 0
}

detect_amdgpu_hwmon() {
    local d
    if [ -n "$AMDGPU_HWMON" ] && [ -d "$AMDGPU_HWMON" ]; then
        return 0
    fi

    for d in /sys/class/hwmon/hwmon*; do
        if [ "$(read_node "$d/name" || true)" = "amdgpu" ]; then
            AMDGPU_HWMON="$d"
            clear_warn "amdgpu_hwmon"
            return 0
        fi
    done

    AMDGPU_HWMON=""
    warn_once "amdgpu_hwmon" "amdgpu hwmon node not found"
    return 1
}

detect_gpu_busy_path() {
    local p
    if [ -n "$GPU_BUSY_PATH" ] && [ -r "$GPU_BUSY_PATH" ]; then
        return 0
    fi

    for p in /sys/class/drm/card*/device/gpu_busy_percent; do
        if [ -r "$p" ]; then
            GPU_BUSY_PATH="$p"
            clear_warn "gpu_busy_path"
            return 0
        fi
    done

    GPU_BUSY_PATH=""
    warn_once "gpu_busy_path" "gpu_busy_percent node not found"
    return 1
}

detect_k10temp_hwmon() {
    local d
    if [ -n "$K10TEMP_HWMON" ] && [ -d "$K10TEMP_HWMON" ]; then
        return 0
    fi

    for d in /sys/class/hwmon/hwmon*; do
        if [ "$(read_node "$d/name" || true)" = "k10temp" ]; then
            K10TEMP_HWMON="$d"
            clear_warn "k10temp_hwmon"
            return 0
        fi
    done

    K10TEMP_HWMON=""
    warn_once "k10temp_hwmon" "k10temp hwmon node not found"
    return 1
}

ac_online() {
    local d type online

    for d in /sys/class/power_supply/*; do
        [ -d "$d" ] || continue
        type="$(read_node "$d/type" || true)"
        [ "$type" = "Mains" ] || continue
        online="$(read_node "$d/online" || echo 0)"
        if [ "$online" = "1" ]; then
            echo 1
            return 0
        fi
    done

    echo 0
}

get_ppt_input_uw() {
    if detect_amdgpu_hwmon; then
        if [ -r "$AMDGPU_HWMON/power1_input" ]; then
            clear_warn "ppt_input"
            read_node "$AMDGPU_HWMON/power1_input" || echo 0
            return 0
        fi
    fi

    warn_once "ppt_input" "missing amdgpu PPT node: power1_input"
    echo 0
}

get_ppt_average_uw() {
    if detect_amdgpu_hwmon; then
        if [ -r "$AMDGPU_HWMON/power1_average" ]; then
            clear_warn "ppt_average"
            read_node "$AMDGPU_HWMON/power1_average" || echo 0
            return 0
        fi

        if [ -r "$AMDGPU_HWMON/power1_input" ]; then
            clear_warn "ppt_average"
            read_node "$AMDGPU_HWMON/power1_input" || echo 0
            return 0
        fi
    fi

    warn_once "ppt_average" "missing amdgpu PPT node: power1_average/power1_input"
    echo 0
}

get_ppt_label() {
    local label

    if detect_amdgpu_hwmon && [ -r "$AMDGPU_HWMON/power1_label" ]; then
        label="$(read_node "$AMDGPU_HWMON/power1_label" || true)"
        if [ -n "$label" ]; then
            echo "$label"
            return 0
        fi
    fi

    echo "PPT"
}

# Counted with a glob rather than find | wc: two processes per refresh for a
# directory that is empty whenever the sensors are healthy.
warning_count() {
    local f n=0
    for f in "$WARN_DIR"/*; do
        [ -f "$f" ] && n=$((n + 1))
    done
    echo "$n"
}

# Profile limits are generated by the NixOS Ryzen module and shared with the
# privileged coordinator, so the tooltip cannot drift from the applied values.
#   profile -> STAPM mW | slow mW | fast mW | tctl °C
profile_limits() {
    local wanted="$1"
    local name ppd stapm slow fast tctl skin vrm vrmmax scheduler mode

    [ -r "$PROFILE_CONFIG_FILE" ] || return 1
    while IFS=$'\t' read -r name ppd stapm slow fast tctl skin vrm vrmmax scheduler mode; do
        case "$name" in
            ''|'#'*) continue ;;
        esac
        [ "$name" = "$wanted" ] || continue
        printf '%s\t%s\t%s\t%s\n' "$stapm" "$slow" "$fast" "$tctl"
        return 0
    done <"$PROFILE_CONFIG_FILE"
    return 1
}

# One cheat-sheet row: "Performance:  48W / 64W / 98°C ◀". Keep the display
# labels within the same 14-column field so every value starts in one column.
cheat_sheet_line() {
    local label="$1" prof="$2" marker="$3" fields stapm fast temp stapm_w fast_w
    fields="$(profile_limits "$prof")" || return 0
    IFS=$'\t' read -r stapm _ fast temp <<< "$fields"
    stapm_w=$((stapm / 1000))
    fast_w=$((fast / 1000))
    printf '%-14s%sW / %sW / %s°C%s' "$label:" "$stapm_w" "$fast_w" "$temp" "$marker"
}

# STAPM, the figure the power tile draws its cap bar against.
profile_ppt_cap() {
    local fields cap_mw
    fields="$(profile_limits "$1")" || { printf '0\n'; return 0; }
    cap_mw="${fields%%$'\t'*}"
    printf '%s\n' "$((cap_mw / 1000))"
}

apply_ryzen_settings() {
    local prof="$1"
    # Optimized for Ryzen 7 8845H (Hawk Point)
    if sudo -n /run/current-system/sw/bin/ryzenadj-profile "$prof" >/dev/null 2>&1; then
        clear_warn "ryzenadj_$prof"
        return 0
    fi

    warn_once "ryzenadj_$prof" "failed to apply ryzenadj-profile '$prof'"
    return 1
}

get_temp() {
    local name="$1"
    local hwmon_dir=""

    # The APU branch reads the amdgpu temperature and frequency in one pass;
    # keep the resolved hwmon path so the second read does not scan every
    # hwmon directory again. The CPU sensor gets the same treatment.
    case "$name" in
        amdgpu)
            if detect_amdgpu_hwmon; then
                hwmon_dir="$AMDGPU_HWMON"
            fi
            ;;
        k10temp)
            if detect_k10temp_hwmon; then
                hwmon_dir="$K10TEMP_HWMON"
            fi
            ;;
    esac

    if [ -n "$hwmon_dir" ]; then
        read_node "$hwmon_dir/edge_input" || \
        read_node "$hwmon_dir/temp1_input" || \
        read_node "$hwmon_dir/junction_input" || \
        echo 0
        return
    fi

    for d in /sys/class/hwmon/hwmon*; do
        if [ "$(read_node "$d/name" || true)" = "$name" ]; then
            # Try multiple common temperature inputs (Edge/Junction usually safer/faster)
            read_node "$d/edge_input" || \
            read_node "$d/temp1_input" || \
            read_node "$d/junction_input" || \
            echo 0
            return
        fi
    done
    echo 0
}

read_cpu_stat_sample() {
    local cpu user nice system idle iowait irq softirq steal guest guest_nice

    read -r cpu user nice system idle iowait irq softirq steal guest guest_nice < /proc/stat || return 1

    if ! is_uint "$user" || ! is_uint "$nice" || ! is_uint "$system" || ! is_uint "$idle" || \
       ! is_uint "$iowait" || ! is_uint "$irq" || ! is_uint "$softirq" || ! is_uint "$steal"; then
        return 1
    fi

    idle=$((idle + iowait))
    printf '%s %s\n' "$((user + nice + system + idle + irq + softirq + steal))" "$idle"
}

calc_cpu_usage_from_samples() {
    local prev_total="$1"
    local prev_idle="$2"
    local total="$3"
    local idle="$4"
    local diff_total diff_idle usage

    diff_total=$((total - prev_total))
    diff_idle=$((idle - prev_idle))
    usage=0

    if [ "$diff_total" -gt 0 ]; then
        usage=$((100 * (diff_total - diff_idle) / diff_total))
    fi

    if [ "$usage" -lt 0 ]; then
        usage=0
    elif [ "$usage" -gt 100 ]; then
        usage=100
    fi

    echo "$usage"
}

get_cpu_usage() {
    local sample total idle prev_total prev_idle next_total next_idle usage

    mkdir -p "$STATE_DIR"

    sample="$(read_cpu_stat_sample 2>/dev/null)" || {
        echo 0
        return
    }
    read -r total idle <<< "$sample"

    if [ -r "$CPU_STAT_FILE" ] && read -r prev_total prev_idle < "$CPU_STAT_FILE" 2>/dev/null && \
       is_uint "$prev_total" && is_uint "$prev_idle"; then
        usage="$(calc_cpu_usage_from_samples "$prev_total" "$prev_idle" "$total" "$idle")"
    else
        sleep 0.1
        sample="$(read_cpu_stat_sample 2>/dev/null)" || {
            printf '%s %s\n' "$total" "$idle" > "$CPU_STAT_FILE"
            echo 0
            return
        }
        read -r next_total next_idle <<< "$sample"
        usage="$(calc_cpu_usage_from_samples "$total" "$idle" "$next_total" "$next_idle")"
        total="$next_total"
        idle="$next_idle"
    fi

    printf '%s %s\n' "$total" "$idle" > "$CPU_STAT_FILE"
    echo "$usage"
}

get_cpu_freq_data() {
    local cpu_path cpu_idx khz avg_sum avg_count avg_khz peak_khz peak_idx

    CPU_FREQ_AVG="0.00"
    CPU_FREQ_PEAK_CORE="C0"
    CPU_FREQ_PEAK_GHZ="0.00"
    avg_sum=0
    avg_count=0
    peak_khz=0
    peak_idx=0

    # Walk cpu0, cpu1, … in numeric order by index rather than globbing and
    # piping through sort -V: same order, no processes, builtin reads.
    for ((cpu_idx = 0; ; cpu_idx++)); do
        cpu_path="/sys/devices/system/cpu/cpu${cpu_idx}/cpufreq/scaling_cur_freq"
        [ -e "$cpu_path" ] || break
        [ -r "$cpu_path" ] || continue

        khz=0
        IFS= read -r khz < "$cpu_path" || true
        if ! is_uint "$khz"; then
            khz=0
        fi

        avg_sum=$((avg_sum + khz))
        avg_count=$((avg_count + 1))

        if [ "$khz" -gt "$peak_khz" ]; then
            peak_khz="$khz"
            peak_idx="$cpu_idx"
        fi
    done

    if [ "$avg_count" -gt 0 ]; then
        avg_khz=$((avg_sum / avg_count))
        printf -v CPU_FREQ_AVG '%d.%02d' \
            "$((avg_khz / 1000000))" "$(((avg_khz % 1000000) / 10000))"
        CPU_FREQ_PEAK_CORE="C${peak_idx}"
        printf -v CPU_FREQ_PEAK_GHZ '%d.%02d' \
            "$((peak_khz / 1000000))" "$(((peak_khz % 1000000) / 10000))"
    fi
}

get_cpu_clock_limits() {
    local policy_path policy_max_khz hardware_max_khz hardware_max_path
    local lowest_policy_max highest_hardware_max

    CPU_POLICY_MAX_GHZ="N/A"
    CPU_HARDWARE_MAX_GHZ="N/A"
    CPU_CLOCK_STATUS="Unavailable"
    CPU_POLICY_VALID_COUNT=0
    CPU_CLOCK_CAP_COUNT=0
    lowest_policy_max=0
    highest_hardware_max=0

    # Read every policy: cpupower-gui may apply a limit to all policies, and
    # showing the lowest one makes a partial limit visible as well.
    for policy_path in /sys/devices/system/cpu/cpufreq/policy*; do
        [ -d "$policy_path" ] || continue

        policy_max_khz=0
        IFS= read -r policy_max_khz < "$policy_path/scaling_max_freq" || true
        # With amd-pstate, cpuinfo_max_freq can follow the policy cap. The
        # driver-owned max_perf value remains the actual 5.14 GHz ceiling.
        hardware_max_path="$policy_path/amd_pstate_max_freq"
        [ -r "$hardware_max_path" ] || hardware_max_path="$policy_path/cpuinfo_max_freq"
        hardware_max_khz=0
        IFS= read -r hardware_max_khz < "$hardware_max_path" || true
        if ! is_uint "$policy_max_khz" || ! is_uint "$hardware_max_khz"; then
            continue
        fi

        CPU_POLICY_VALID_COUNT=$((CPU_POLICY_VALID_COUNT + 1))
        if [ "$lowest_policy_max" -eq 0 ] || [ "$policy_max_khz" -lt "$lowest_policy_max" ]; then
            lowest_policy_max="$policy_max_khz"
        fi
        if [ "$hardware_max_khz" -gt "$highest_hardware_max" ]; then
            highest_hardware_max="$hardware_max_khz"
        fi
        if [ "$policy_max_khz" -lt "$hardware_max_khz" ]; then
            CPU_CLOCK_CAP_COUNT=$((CPU_CLOCK_CAP_COUNT + 1))
        fi
    done

    if [ "$CPU_POLICY_VALID_COUNT" -eq 0 ]; then
        return 0
    fi

    printf -v CPU_POLICY_MAX_GHZ '%d.%02d' \
        "$((lowest_policy_max / 1000000))" "$(((lowest_policy_max % 1000000) / 10000))"
    printf -v CPU_HARDWARE_MAX_GHZ '%d.%02d' \
        "$((highest_hardware_max / 1000000))" "$(((highest_hardware_max % 1000000) / 10000))"
    if [ "$CPU_CLOCK_CAP_COUNT" -gt 0 ]; then
        CPU_CLOCK_STATUS="LIMITED: ${CPU_CLOCK_CAP_COUNT}/${CPU_POLICY_VALID_COUNT} policies below hardware max"
    else
        CPU_CLOCK_STATUS="OK: policy reaches hardware max"
    fi
}

get_gpu_usage() {
    if detect_gpu_busy_path; then
        read_node "$GPU_BUSY_PATH" || echo 0
    else
        echo 0
    fi
}

get_gpu_freq() {
    # GPU Shader Clock in MHz
    local hz
    if detect_amdgpu_hwmon && hz="$(read_node "$AMDGPU_HWMON/freq1_input")" && is_uint "$hz"; then
        echo $((hz / 1000000))
    else
        echo 0
    fi
}

get_reserve_state() {
    local state

    if state="$(sudo -n /run/current-system/sw/bin/toggle-battery-reserve status 2>/dev/null)"; then
        clear_warn "reserve_status"
        case "$state" in
            on|off)
                clear_warn "reserve_value"
                echo "$state"
                return 0
                ;;
            *)
                warn_once "reserve_value" "unexpected reserve status value: '$state'"
                ;;
        esac
    else
        warn_once "reserve_status" "failed to read battery reserve mode via sudo"
    fi

    echo "unknown"
    return 1
}

# --- Action modes ---
#
# These change state and print no tile, so they run before the gathering below:
# that preamble spends roughly twenty-five subprocesses walking sysfs for
# figures only the display modes render, and a click paid all of it.

case "$MODE" in
    toggle)
        p="$(get_power_profile)"
        next_profile=""
        case "$p" in
            performance)
                next_profile=sustained-build
                ;;
            sustained-build)
                next_profile=balanced
                ;;
            balanced)
                next_profile=power-saver
                ;;
            power-saver)
                next_profile=performance
                ;;
            *)
                warn_once "profile_toggle" "cannot toggle unknown power profile '$p'"
                exit 1
                ;;
        esac
        if apply_ryzen_settings "$next_profile"; then
            remember_power_profile "$next_profile"
            pkill -RTMIN+2 -x waybar || pkill -RTMIN+2 -x .waybar-wrapped || true
        else
            warn_once "profile_toggle" "profile transition to '$next_profile' failed"
            exit 1
        fi
        exit 0
        ;;
    bmode-toggle)
        if sudo -n /run/current-system/sw/bin/toggle-battery-reserve toggle >/dev/null 2>&1; then
            clear_warn "reserve_toggle"
            pkill -RTMIN+2 -x waybar || pkill -RTMIN+2 -x .waybar-wrapped || true
        else
            warn_once "reserve_toggle" "failed to toggle battery reserve mode via sudo"
        fi
        exit 0
        ;;
esac

# --- Main Data Gathering ---

# The APU tile does not render battery/charging data. Keep its fast CPU/GPU
# monitor independent of the much larger power-flow collection below.
warn_count="$(warning_count)"
health_msg="Sensor health: OK"
health_cls="healthy"
if [ "${warn_count:-0}" -gt 0 ]; then
    health_msg="Sensor health: Degraded (${warn_count} warning marker(s))"
    health_cls="degraded"
fi

if [ "$MODE" = "pwr" ]; then

# System Total Power & Voltage
# Raw readings first (all builtin reads), then one awk turns them into every
# displayed figure. This block used to be eleven awk processes, one per number,
# on every refresh of both bar modes. The formulas and roundings are the ones
# each of those awks applied, including the two quirks worth keeping straight:
# the time estimate goes through awk's default %.6g print before it is split
# into hours and minutes, and the board power is the difference of the
# already-rounded watt strings, not of the raw microwatts.
sys_uw=$(battery_power_uw)
volt_uv=$(battery_num "voltage_now")
cap=$(battery_num "capacity")
stat=$(battery_text "status" "Unknown")
ac_is_online=$(ac_online)

# Battery Health & Capacity Metrics
e_now=$(battery_energy_uwh "now")
e_full=$(battery_energy_uwh "full")
e_design="$(battery_num_optional "energy_full_design" "")"
if [ -z "$e_design" ]; then
    e_design="$(battery_energy_uwh "full_design")"
fi
cycles=$(battery_num_optional "cycle_count" "N/A")

# PPT power. Temperatures are read where they are consumed (the apu branch), not
# here: this preamble runs for every mode, and a reading nothing prints is a
# hwmon directory walk charged to every waybar poll.
ppt_label=$(get_ppt_label)
ppt_input_uw=$(get_ppt_input_uw)
ppt_avg_uw=$(get_ppt_average_uw)

# "|" separates the fields: read would fold the empty time estimate away if
# the separator were whitespace.
IFS='|' read -r sys_w volt_v h_m wh_now wh_full health_text ppt_now_w ppt_avg_w cpu_w_measured < <(
    awk -v uw="${sys_uw:-0}" -v uv="${volt_uv:-0}" -v stat="$stat" \
        -v now="${e_now:-0}" -v full="${e_full:-0}" -v design="${e_design:-0}" \
        -v ppt_in="${ppt_input_uw:-0}" -v ppt_avg="${ppt_avg_uw:-0}" '
    BEGIN {
        sys_w = sprintf("%.1f", uw / 1000000)
        volt  = sprintf("%.2f", uv / 1000000)

        # Battery time estimation: 0.5 W minimum to avoid noise.
        hm = ""
        if (uw > 500000) {
            hr = ""
            if (stat == "Discharging")   hr = sprintf("%.6g", now / uw) + 0
            else if (stat == "Charging") hr = sprintf("%.6g", (full - now) / uw) + 0
            if (hr != "" && hr > 0 && hr < 24) {
                h = int(hr)
                m = int((hr - h) * 60 + 0.5)
                if (m == 60) { h++; m = 0 }
                hm = sprintf("%d:%02d", h, m)
            }
        }

        wh_now  = sprintf("%.1f", now / 1000000)
        wh_full = sprintf("%.1f", full / 1000000)
        health  = (design > 0) ? sprintf("%.1f%%", (full / design) * 100) : "N/A"

        ppt_now = sprintf("%.1f", ppt_in / 1000000)
        ppt_avg_s = sprintf("%.1f", ppt_avg / 1000000)

        v = sys_w - ppt_avg_s
        if (v < 0) v = 0
        board = sprintf("%.1f", v)

        printf "%s|%s|%s|%s|%s|%s|%s|%s|%s\n", sys_w, volt, hm, wh_now, wh_full, health, ppt_now, ppt_avg_s, board
    }'
)
time_str=""
[ -n "$h_m" ] && time_str="[$h_m]"

# Board/peripheral power is only measurable while discharging, where it is
# whatever is left of the battery draw after the APU. On AC nothing measures
# it, so the last figure taken on battery is reused — a number from this
# machine rather than the constant that used to stand in here. Only the
# Discharging branch may write: on "Not charging" the battery draw is ~0, so
# the same subtraction would clamp to 0 and poison the stored value.
if [ "$stat" = "Discharging" ]; then
    cpu_w="$cpu_w_measured"
    board_w_state="measured"
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    printf '%s\n' "$cpu_w" > "$BOARD_W_FILE" 2>/dev/null || true
else
    cpu_w="$(read_node "$BOARD_W_FILE" || true)"
    case "$cpu_w" in
        '' | *[!0-9.]*)
            cpu_w="5.0"
            board_w_state="default"
            ;;
        *)
            board_w_state="cached"
            ;;
    esac
fi

# No node on this board reports charger input: UCSI reports 0.00 A even while
# charging and ACAD exposes only "online". So input is assembled from the
# parts that are measurable. Charging-circuit loss is not one of them, so this
# reads low — the "~" and the "est." are load-bearing, not decoration.
estimate_input_line() {
    local apu="$1" board="$2" batt="$3"
    local total board_disp parts

    local batt_shown
    # Both figures from one awk instead of two.
    read -r total batt_shown < <(awk -v a="${apu:-0}" -v b="${board:-0}" -v c="${batt:-0}" \
        'BEGIN{ printf "%.0f %d\n", a+b+c, (c > 0.1) ? 1 : 0 }')
    board_disp="$board"
    [ "${board_w_state:-default}" = "default" ] && board_disp="~${board}"
    parts="APU ${apu} + board ${board_disp}"
    if [ "$batt_shown" = "1" ]; then
        parts="${parts} + batt ${batt}"
    fi

    printf 'In (est.):    ~%s W\nBreakdown:    %s' "$total" "$parts"
}

# Battery Icon & Style Class
icon="$ICON_BAT_100"
if [ "${cap:-0}" -le 20 ]; then icon="$ICON_BAT_20"; fi
if [ "${cap:-0}" -gt 20 ] && [ "${cap:-0}" -le 40 ]; then icon="$ICON_BAT_40"; fi
if [ "${cap:-0}" -gt 40 ] && [ "${cap:-0}" -le 60 ]; then icon="$ICON_BAT_60"; fi
if [ "${cap:-0}" -gt 60 ] && [ "${cap:-0}" -le 80 ]; then icon="$ICON_BAT_80"; fi
if [ "$stat" = "Charging" ] || [ "$stat" = "Full" ] || [ "$stat" = "Not charging" ]; then icon="$ICON_PLUG"; fi

b_cls="normal"
if [ "${cap:-0}" -le 20 ]; then b_cls="critical"; fi
if [ "$stat" = "Charging" ]; then b_cls="charging"; fi

fi

# --- Output Generation ---

case "$MODE" in
    apu) # Formerly GPU
        # APU Metrics: PPT power, thermals, CPU usage, CPU/GPU clocks
        t_gpu_raw=$(get_temp "amdgpu")
        t_cpu_raw=$(get_temp "k10temp")
        
        read -r t_gpu t_cpu < <(awk -v g="${t_gpu_raw:-0}" -v c="${t_cpu_raw:-0}" 'BEGIN{printf "%.0f %.0f\n", g/1000, c/1000}')
        
        # Usage & Freq
        cpu_util=$(get_cpu_usage)
        gpu_util=$(get_gpu_usage)
        get_cpu_freq_data
        cpu_freq="$CPU_FREQ_AVG"
        cpu_peak_core="$CPU_FREQ_PEAK_CORE"
        cpu_peak_freq="$CPU_FREQ_PEAK_GHZ"
        get_cpu_clock_limits
        cpu_policy_max="$CPU_POLICY_MAX_GHZ"
        cpu_hardware_max="$CPU_HARDWARE_MAX_GHZ"
        cpu_clock_status="$CPU_CLOCK_STATUS"
        gpu_freq=$(get_gpu_freq)

        profile=$(get_power_profile)

        case "$profile" in
            performance)     active_marker_perf=" ◀" ; active_marker_build="" ;   active_marker_bal="" ;   active_marker_sav="" ;;
            sustained-build) active_marker_perf="" ;   active_marker_build=" ◀" ; active_marker_bal="" ;   active_marker_sav="" ;;
            balanced)        active_marker_perf="" ;   active_marker_build="" ;   active_marker_bal=" ◀" ; active_marker_sav="" ;;
            power-saver)     active_marker_perf="" ;   active_marker_build="" ;   active_marker_bal="" ;   active_marker_sav=" ◀" ;;
            *)               active_marker_perf="" ;   active_marker_build="" ;   active_marker_bal="" ;   active_marker_sav="" ;;
        esac

        # Classes
        t_cls="normal"
        if [ "$t_cpu" -ge 85 ] || [ "$t_gpu" -ge 85 ]; then t_cls="critical";
        elif [ "$t_cpu" -ge 75 ] || [ "$t_gpu" -ge 75 ]; then t_cls="hot";
        elif [ "$t_cpu" -ge 60 ] || [ "$t_gpu" -ge 60 ]; then t_cls="warm";
        fi
        
        # Format: [GPU Temp] [CPU Temp] [Avg CPU GHz] [CPU Usage] [PPT avg W]
        tooltip="<b><span foreground='$ACCENT'>APU (RYZEN 7 8845H)</span></b>
$SEP
<tt>CPU:          $(printf "%3d" "$cpu_util")% $(progress_bar "$cpu_util") @ $cpu_freq GHz avg
GPU:          $(printf "%3d" "$gpu_util")% $(progress_bar "$gpu_util") @ $gpu_freq MHz</tt>

<b><span foreground='$ACCENT'>POWER PROFILE</span></b>
$SEP
<tt>$(cheat_sheet_line "Performance" performance "$active_marker_perf")
$(cheat_sheet_line "Build" sustained-build "$active_marker_build")
$(cheat_sheet_line "Balanced" balanced "$active_marker_bal")
$(cheat_sheet_line "Power Saver" power-saver "$active_marker_sav")</tt>

<b><span foreground='$ACCENT'>CLOCK</span></b>
$SEP
<tt>Current avg:  $cpu_freq GHz
Peak sampled: $cpu_peak_core @ $cpu_peak_freq GHz
Policy max:   $cpu_policy_max GHz
Hardware max: $cpu_hardware_max GHz
Limit check:  $cpu_clock_status</tt>

<span size='small' alpha='50%'>Click: cycle profile · $health_msg</span>"

        printf '{"text":"%s %s°C %s %s°C %sGHz %s%%", "tooltip":"%s", "class":["%s", "normal", "%s"]}\n' \
            "$ICON_GPU" "$t_gpu" "$ICON_CPU" "$t_cpu" "$cpu_freq" "$cpu_util" \
            "$(printf '%s' "$tooltip" | sed ':a;N;$!ba;s/\n/\\n/g')" \
            "$t_cls" "$health_cls"
        ;;
    pwr)
        # Power Profile info (for tooltip only)
        profile=$(get_power_profile)
        battery_w_abs=$(awk -v uw="${sys_uw:-0}" 'BEGIN{v=uw/1000000; if(v<0) v=-v; printf "%.1f", v}')

        # On battery the battery draw IS the whole machine, measured exactly, so
        # it is labelled as such. On AC only the charge rate is measurable and
        # total input is not exposed by any node on this board, so the input
        # figure is assembled and flagged as an estimate rather than implied.
        if [ "$stat" = "Discharging" ]; then
            source_label="Battery"
            state_label="Discharging"
            flow_line="Draw:         ${battery_w_abs} W  (whole machine)"
            in_line=""
            time_line="Time left:    ${time_str:-N/A}"
            primary_w="$battery_w_abs"
            text_label="BAT -${battery_w_abs}W"
        elif [ "$stat" = "Charging" ]; then
            source_label="AC"
            state_label="Charging"
            flow_line="To battery:   +${battery_w_abs} W"
            in_line="$(estimate_input_line "$ppt_avg_w" "$cpu_w" "$battery_w_abs")"
            time_line="Time to full: ${time_str:-N/A}"
            primary_w="$battery_w_abs"
            text_label="BAT +${battery_w_abs}W"
        elif [ "${ac_is_online:-0}" = "1" ]; then
            source_label="AC"
            state_label="$stat"
            flow_line="To battery:   Idle (~0 W)"
            in_line="$(estimate_input_line "$ppt_avg_w" "$cpu_w" "0")"
            time_line="Time:         N/A"
            primary_w="$ppt_avg_w"
            text_label="AC ${ppt_avg_w}W"
        else
            source_label="Battery"
            state_label="$stat"
            flow_line="Draw:         ${battery_w_abs} W  (whole machine)"
            in_line=""
            time_line="Time:         N/A"
            primary_w="$battery_w_abs"
            text_label="BAT -${battery_w_abs}W"
        fi

        w_cls=$(awk -v w="${primary_w:-0}" 'BEGIN{if(w>=45) print "high"; else if(w>=25) print "medium"; else print "normal"}')

        # Reserve mode state
        reserve_state="$(get_reserve_state || true)"
        case "$reserve_state" in
            on)  reserve_label="ON" ;;
            off) reserve_label="OFF" ;;
            *)   reserve_label="UNKNOWN" ;;
        esac

        # Load theme static colors or defaults for profile styling
        color_perf="@signalWarning@"
        color_saver="@signalEco@"
        color_bal="@themeAccent@"

        # Power profile cheat-sheet
        case "$profile" in
            performance)     active_marker_perf=" ◀" ; active_marker_build="" ;   active_marker_bal="" ;   active_marker_sav="" ;   prof_cls="prof-perf" ;   p_icon="<span foreground='$color_perf'>$ICON_PERF</span>" ;;
            sustained-build) active_marker_perf="" ;   active_marker_build=" ◀" ; active_marker_bal="" ;   active_marker_sav="" ;   prof_cls="prof-normal" ; p_icon="<span foreground='$color_bal'>$ICON_CPU</span>" ;;
            balanced)        active_marker_perf="" ;   active_marker_build="" ;   active_marker_bal=" ◀" ; active_marker_sav="" ;   prof_cls="prof-normal" ; p_icon="<span foreground='$color_bal'>$ICON_BALANCED</span>" ;;
            power-saver)     active_marker_perf="" ;   active_marker_build="" ;   active_marker_bal="" ;   active_marker_sav=" ◀" ; prof_cls="prof-saver" ;  p_icon="<span foreground='$color_saver'>$ICON_SAVER</span>" ;;
            *)               active_marker_perf="" ;   active_marker_build="" ;   active_marker_bal="" ;   active_marker_sav="" ;   prof_cls="prof-normal" ; p_icon="?" ;;
        esac

        # The rolling average is what the sustained budget applies to, so that
        # is the number headroom is measured against.
        ppt_cap="$(profile_ppt_cap "$profile")"

        # The PPT label comes from sysfs, so its width is only known at runtime;
        # pad it here to keep the value column aligned with every other block.
        ppt_field="$(printf '%-14s' "APU (${ppt_label}):")"
        if [ "$ppt_cap" -gt 0 ]; then
            ppt_pct=$(awk -v w="${ppt_avg_w:-0}" -v c="$ppt_cap" 'BEGIN{p=w/c*100; if(p>100)p=100; if(p<0)p=0; printf "%.0f", p}')
            ppt_line="${ppt_field}${ppt_avg_w} W / ${ppt_cap} W $(progress_bar "$ppt_pct")  now ${ppt_now_w} W"
        else
            ppt_line="${ppt_field}${ppt_avg_w} W  now ${ppt_now_w} W"
        fi

        energy_lines="Source:       $source_label
State:        $state_label
$flow_line"
        [ -z "$in_line" ] || energy_lines="$energy_lines
$in_line"
        energy_lines="$energy_lines
$ppt_line"

        tooltip="<b><span foreground='$ACCENT'>SYSTEM ENERGY</span></b>
$SEP
<tt>$energy_lines</tt>

<b><span foreground='$ACCENT'>BATTERY</span></b>
$SEP
<tt>Charge:       $cap% ($stat) $(progress_bar "$cap")
Health:       $health_text
Capacity:     $wh_now / $wh_full Wh
$time_line
Voltage:      ${volt_v}V  |  Cycles: $cycles</tt>

<b><span foreground='$ACCENT'>BATTERY RESERVE</span></b>
$SEP
<tt>Mode:         ${reserve_label}</tt>

<span size='small' alpha='50%'>Click: toggle reserve · $health_msg</span>"

        printf '{"text":"%s  %s  %s%%  %s", "tooltip":"%s", "class":["%s", "%s", "power-flow", "%s", "%s"]}\n' \
            "$text_label" "$icon" "$cap" "$p_icon" \
            "$(printf '%s' "$tooltip" | sed ':a;N;$!ba;s/\n/\\n/g')" \
            "$w_cls" "$b_cls" "$health_cls" "$prof_cls"
        ;;
esac
