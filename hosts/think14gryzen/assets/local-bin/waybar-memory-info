#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
# Waybar Memory Info — RAM / swap / pressure, with a top-consumers tooltip.
# Outputs JSON for a custom module. Refreshes once a second, so every read below
# is a shell builtin or a single awk pass; nothing loops over processes in bash.
#
# Why this module does not colour itself by used%: on this APU the iGPU has no
# VRAM of its own. amdgpu borrows system RAM (GTT, capped by ttm.pages_limit)
# and llama.cpp keeps a whole model there, so used% sits at ~96% whenever a
# model is loaded and the machine is perfectly fine. The colour instead follows
# what actually predicts a freeze: MemAvailable, PSI (how much wall-clock time
# every task spent stalled on memory), and spill from zram to the SSD swapfile.
# The GPU's own VRAM/GTT split lives in the APU tooltip; disks have their own
# module.

# Use a stable text prefix instead of a private-use glyph to avoid
# missing-glyph/error-icon rendering on some font stacks.
ICON_MEM="RAM"

# Colour thresholds, tuned to warn only when a freeze is close. With a 30B
# model loaded the machine's normal state is Available ≈ 1.2–1.7 G and PSI
# ≈ 0.1–0.2%, and that must stay green — a warning that is on all day is not
# a warning. PSI is "full avg10": the share of the last 10 s in which every
# non-idle task was stalled on memory. ~10% is input starting to stutter,
# ~25% is multi-second freezes and the last moment a terminal still answers.
# Available is in GiB. Spill to the SSD swapfile is critical on its own: it
# only starts once zram is full.
PSI_WARN=10
PSI_CRIT=25
AVAIL_WARN_GIB=1
AVAIL_CRIT_GIB=0.5

# Per-process GTT is attributed from /proc/*/fdinfo, which costs a find plus an
# awk each refresh. Skip it while the GPU holds less than this: desktop apps
# keep tens of MiB there and nothing hides behind that.
GTT_SCAN_MIN_KB=$((1024 * 1024))

STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/waybar-memory-info.class"

# Progress bar helper
progress_bar() {
  local p=$1
  local width=10
  local filled=$((p * width / 100))
  local empty=$((width - filled))
  local bar=""
  for ((i=0; i<filled; i++)); do bar+="■"; done
  for ((i=0; i<empty; i++)); do bar+="□"; done
  printf '[%s]' "$bar"
}

# ── /proc/meminfo, one read ──────────────────────────────────────────────────
declare -A MI
while read -r key value _; do
  MI[${key%:}]=$value
done < /proc/meminfo

mem_total_kb=${MI[MemTotal]:-0}
mem_avail_kb=${MI[MemAvailable]:-0}
# GPUActive is the amdgpu GTT footprint as the kernel accounts it — the same
# figure as mem_info_gtt_used in sysfs, but already in hand.
gtt_used_kb=${MI[GPUActive]:-0}

# ── GPU pools from the first amdgpu card ────────────────────────────────────
# Two pools: the VRAM carve-out (fixed by the BIOS, lives OUTSIDE MemTotal) and
# GTT (borrowed from system RAM, capped by ttm.pages_limit, INSIDE MemTotal —
# the GTT line in the Used tree). RADV hands both to Vulkan as one device-local
# heap, so llama.cpp fills the 4 G carve-out first and the rest lands in GTT.
vram_used_kb=0; vram_total_kb=0; gtt_total_kb=0
for d in /sys/class/drm/card*/device; do
  [ -r "$d/mem_info_gtt_total" ] || continue
  read -r b < "$d/mem_info_vram_used"  2>/dev/null && vram_used_kb=$(( b / 1024 ))
  read -r b < "$d/mem_info_vram_total" 2>/dev/null && vram_total_kb=$(( b / 1024 ))
  read -r b < "$d/mem_info_gtt_total"  2>/dev/null && gtt_total_kb=$(( b / 1024 ))
  break
done
# `free` semantics for Used, so the bar text stays the number it always was.
mem_used_kb=$(( mem_total_kb - ${MI[MemFree]:-0} - ${MI[Buffers]:-0} - ${MI[Cached]:-0} - ${MI[SReclaimable]:-0} ))
(( mem_used_kb < 0 )) && mem_used_kb=0

# ── swap: zram (compressed in RAM) vs the swapfile (NVMe) ───────────────────
# /proc/swaps gives used/size per device; zram's mm_stat gives what its
# compressed pages actually occupy in RAM, which is the number that matters
# when the question is "how much RAM is left".
zram_used_kb=0; zram_size_kb=0; file_used_kb=0; file_size_kb=0
while read -r dev type size used _; do
  case "$dev" in
    Filename) continue ;;
    /dev/zram*) zram_size_kb=$(( zram_size_kb + size )); zram_used_kb=$(( zram_used_kb + used )) ;;
    *) [ "$type" = "file" ] || continue
       file_size_kb=$(( file_size_kb + size )); file_used_kb=$(( file_used_kb + used )) ;;
  esac
done < /proc/swaps

zram_orig_b=0; zram_real_b=0
for f in /sys/block/zram*/mm_stat; do
  [ -r "$f" ] || continue
  read -r orig _ real _ < "$f" || continue
  zram_orig_b=$(( zram_orig_b + orig ))
  zram_real_b=$(( zram_real_b + real ))
done

# ── PSI: memory "full" avg10 ─────────────────────────────────────────────────
psi_full="0.00"
if [ -r /proc/pressure/memory ]; then
  while read -r kind a10 _; do
    [ "$kind" = "full" ] || continue
    psi_full=${a10#avg10=}
  done < /proc/pressure/memory
fi

# ── one awk pass turns the raw figures into every displayed number ───────────
# The last three fields say which signal tripped: 0 normal, 1 warning,
# 2 critical, one each for Available, PSI and the swapfile. The module class is
# the worst of the three, and the tooltip marks the offending line.
IFS=$'\t' read -r used_g total_g avail_g used_pct apps_g gtt_g \
  vram_g vram_tot_g vram_pct gtt_tot_g gtt_pct \
  zram_used_g zram_size_g zram_pct file_used_g file_size_g file_pct psi_pct \
  s_avail s_psi s_swap class < <(
  awk -v used="$mem_used_kb" -v total="$mem_total_kb" -v avail="$mem_avail_kb" \
      -v gtt="$gtt_used_kb" -v gtt_tot="$gtt_total_kb" -v vram="$vram_used_kb" -v vram_tot="$vram_total_kb" \
      -v zu="$zram_used_kb" -v zs="$zram_size_kb" -v zorig="$zram_orig_b" -v zreal="$zram_real_b" \
      -v fu="$file_used_kb" -v fs="$file_size_kb" -v psi="$psi_full" \
      -v psi_warn="$PSI_WARN" -v psi_crit="$PSI_CRIT" \
      -v av_warn="$AVAIL_WARN_GIB" -v av_crit="$AVAIL_CRIT_GIB" '
    function gib(kb) { return kb / 1048576 }
    BEGIN {
      avail_g = gib(avail)
      sa = avail_g < av_crit ? 2 : (avail_g < av_warn ? 1 : 0)
      sp = psi + 0 >= psi_crit ? 2 : (psi + 0 >= psi_warn ? 1 : 0)
      ss = fu > 0 ? 2 : 0
      worst = sa; if (sp > worst) worst = sp; if (ss > worst) worst = ss
      cls = worst == 2 ? "critical" : (worst == 1 ? "warning" : "normal")
      # Apps = Used minus what the GPU borrowed (GTT, shown in the GPU block)
      # and what zram compressed pages physically occupy: RSS + kernel.
      apps = used - gtt - zreal / 1024
      if (apps < 0) apps = 0
      # The pressure bar is scaled to the critical threshold, not to 100%:
      # on a 0–100 scale it would sit empty right up to the freeze.
      psi_pct = psi_crit > 0 ? (psi + 0) * 100 / psi_crit : 0
      if (psi_pct > 100) psi_pct = 100
      printf "%.1f\t%.1f\t%.1f\t%.0f\t%.1f\t%.1f\t%.1f\t%.1f\t%.0f\t%.1f\t%.0f\t%.1f\t%.1f\t%.0f\t%.1f\t%.1f\t%.0f\t%.0f\t%d\t%d\t%d\t%s\n",
        gib(used), gib(total), avail_g, (total > 0 ? used * 100 / total : 0), gib(apps), gib(gtt),
        gib(vram), gib(vram_tot), (vram_tot > 0 ? vram * 100 / vram_tot : 0), gib(gtt_tot), (gtt_tot > 0 ? gtt * 100 / gtt_tot : 0),
        gib(zu), gib(zs), (zs > 0 ? zu * 100 / zs : 0),
        gib(fu), gib(fs), (fs > 0 ? fu * 100 / fs : 0), psi_pct,
        sa, sp, ss, cls
    }'
)

# ── top consumers: RSS + GTT, aggregated by command name ─────────────────────
# ps does not see GTT — llama-server holding 18 GiB shows a few hundred MiB of
# RSS — so the DRM fdinfo of every process with a /dev/dri fd is folded in.
# Only fds pointing at /dev/dri are read (one find), and duplicate fds to the
# same DRM client are counted once via drm-client-id.
gtt_by_pid=""
if (( gtt_used_kb >= GTT_SCAN_MIN_KB )); then
  # shellcheck disable=SC2016  # $1/$2 belong to the awk program, not the shell
  gtt_by_pid="$(
    (find /proc/[0-9]*/fd -lname '/dev/dri/*' -printf '%h/../fdinfo/%f\n' 2>/dev/null || true) \
      | xargs -r awk '
        FNR == 1 { split(FILENAME, p, "/"); pid = p[3] }
        $1 == "drm-client-id:" { client = $2 }
        $1 == "drm-resident-gtt:" {
          kb = $2
          if ($3 == "MiB") kb *= 1024
          else if ($3 == "GiB") kb *= 1048576
          seen_key = pid "/" client
          if (!(seen_key in seen)) { seen[seen_key] = 1; gtt[pid] += kb }
        }
        END { for (id in gtt) print id, gtt[id] }
      ' 2>/dev/null || true
  )"
fi

top_procs="$(
  ps -eo pid=,rss=,comm= | awk -v gtt_list="$gtt_by_pid" '
    BEGIN {
      n = split(gtt_list, lines, "\n")
      for (i = 1; i <= n; i++) if (split(lines[i], kv, " ") == 2) gtt[kv[1]] = kv[2]
    }
    {
      pid = $1; rss = $2
      name = $3; for (i = 4; i <= NF; i++) name = name " " $i
      # Nix wrapProgram runs the real binary as ".foo-wrapped"; show "foo".
      # comm is cut at 15 chars, so the suffix may survive only as "-w".
      if (sub(/^\./, "", name)) sub(/-(w|wr|wra|wrap|wrapp|wrappe|wrapped)$/, "", name)
      t[name] += rss + (pid in gtt ? gtt[pid] : 0)
    }
    END {
      for (k in t) if (t[k] > 0) order[++m] = k
      # Insertion sort, descending by total — a few hundred names at most.
      for (i = 2; i <= m; i++) {
        k = order[i]
        for (j = i - 1; j >= 1 && t[order[j]] < t[k]; j--) order[j + 1] = order[j]
        order[j + 1] = k
      }
      for (i = 1; i <= m && i <= 5; i++) {
        k = order[i]
        label = substr(k, 1, 15)
        gsub(/&/, "\\&amp;", label); gsub(/</, "\\&lt;", label); gsub(/>/, "\\&gt;", label)
        printf "%-15s%7.1f GiB\n", label, t[k] / 1048576
      }
    }'
)"
[ -n "$top_procs" ] || top_procs="Unavailable"

# ── one-shot notification on entering critical ───────────────────────────────
# Nothing here kills anything: the point is a heads-up that arrives while the
# desktop is still responsive, so the user can close something themselves.
# The class is only written when it changes, so the steady state costs no I/O.
last_class=""
if [ -r "$STATE_FILE" ]; then
  read -r last_class < "$STATE_FILE" || true
fi
if [ "$class" != "$last_class" ]; then
  printf '%s\n' "$class" > "$STATE_FILE" 2>/dev/null || true
  if [ "$class" = "critical" ]; then
    notify-send -u critical -a "Memory" "RAM critical" \
      "Available ${avail_g} G · PSI ${psi_full}% · Swapfile ${file_used_g} G
$top_procs" \
      2>/dev/null || true
  fi
fi

# ── tooltip ──────────────────────────────────────────────────────────────────
ACCENT="@themeAccent@"
SEP="<span alpha='30%'>──────────────────────────</span>"

# A ◀ on the line whose signal tripped, with the threshold it crossed, so the
# colour never has to be decoded from memory.
marker() {
  case "$1" in
    2) printf '  ◀ critical (%s)' "$2" ;;
    1) printf '  ◀ warning (%s)' "$2" ;;
    *) ;;
  esac
}
avail_lim=$AVAIL_WARN_GIB; [ "$s_avail" = 2 ] && avail_lim=$AVAIL_CRIT_GIB
psi_lim=$PSI_WARN;         [ "$s_psi" = 2 ] && psi_lim=$PSI_CRIT
m_avail="$(marker "$s_avail" "&lt; $avail_lim G")"
m_psi="$(marker "$s_psi" "&gt; $psi_lim%")"
m_swap="$(marker "$s_swap" "spill")"

# One block, one table: every pool that can fill up gets the same
# "used/total unit [bar]" row — the 27 G the OS sees and the 4 G VRAM
# carve-out are the same LPDDR5, so the header shows both halves of the
# physical total. Below the table, the two figures that are not a pool:
# Available (what the colour thresholds watch) and Apps (Used minus GTT and
# zram's compressed store — what closing programs can give back).
tooltip="<b><span foreground='$ACCENT'>MEMORY ($total_g + $vram_tot_g GiB)</span></b>
$SEP
<tt>RAM       $(printf '%13s' "${used_g} / ${total_g}") GiB $(progress_bar "$used_pct")
VRAM      $(printf '%13s' "${vram_g} / ${vram_tot_g}") GiB $(progress_bar "$vram_pct")
$SEP
GTT       $(printf '%13s' "${gtt_g} / ${gtt_tot_g}") GiB $(progress_bar "$gtt_pct")
zram      $(printf '%13s' "${zram_used_g} / ${zram_size_g}") GiB $(progress_bar "$zram_pct")
Swapfile  $(printf '%13s' "${file_used_g} / ${file_size_g}") GiB $(progress_bar "$file_pct")${m_swap}
Pressure  $(printf '%13s' "${psi_full} / ${PSI_CRIT}") %   $(progress_bar "$psi_pct")${m_psi}

Available $(printf '%13s' "$avail_g") GiB${m_avail}
Apps      $(printf '%13s' "$apps_g") GiB</tt>

<b><span foreground='$ACCENT'>TOP</span></b>
$SEP
<tt>$top_procs</tt>

<span size='small' alpha='50%'>Click: show/hide disks</span>"

jq -cn \
    --arg text "${ICON_MEM} ${used_g}G (${used_pct}%)" \
    --arg tooltip "$tooltip" \
    --arg class "$class" \
    '{text: $text, tooltip: $tooltip, class: $class}'
