#!/usr/bin/env bash
set -euo pipefail

SCREEN_TIME_LIB_DIR="@screenTimeLib@/lib"
# shellcheck source=/dev/null
. "$SCREEN_TIME_LIB_DIR/common.sh"
# shellcheck source=/dev/null
. "$SCREEN_TIME_LIB_DIR/category-map.sh"
# shellcheck source=/dev/null
. "$SCREEN_TIME_LIB_DIR/metrics.sh"
# shellcheck source=/dev/null
. "$SCREEN_TIME_LIB_DIR/scores.sh"
# shellcheck source=/dev/null
. "$SCREEN_TIME_LIB_DIR/insights.sh"
# shellcheck source=/dev/null
. "$SCREEN_TIME_LIB_DIR/views.sh"

VIEW="summary"
FORMAT="json"
TARGET_DATE="$(date +%F)"
THEME_FILE=""
ROWS_FILE=""
ALL_VIEWS_DIR=""

usage() {
  cat <<'EOF'
Usage: rofi-screen-time-stats [--date YYYY-MM-DD] [--view summary|activity|health|timer] [--format json|theme|rows|files] [--theme-file PATH --rows-file PATH]
       rofi-screen-time-stats [--date YYYY-MM-DD] --all-views-dir DIR
  --all-views-dir  render every view from one data pass into
                   DIR/default-<view>-theme.rasi and DIR/default-<view>-rows.txt
EOF
}

render_files() {
  local payload_json="$1"
  local theme_tmp=""
  local rows_tmp=""

  theme_tmp="$(mktemp "${THEME_FILE}.XXXXXX")"
  rows_tmp="$(mktemp "${ROWS_FILE}.XXXXXX")"
  render_theme "$payload_json" >"$theme_tmp"
  render_rows "$payload_json" >"$rows_tmp"
  mv "$theme_tmp" "$THEME_FILE"
  mv "$rows_tmp" "$ROWS_FILE"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --date)
      TARGET_DATE="${2:-}"
      shift 2
      ;;
    --view)
      VIEW="${2:-}"
      shift 2
      ;;
    --format)
      FORMAT="${2:-}"
      shift 2
      ;;
    --theme-file)
      THEME_FILE="${2:-}"
      shift 2
      ;;
    --rows-file)
      ROWS_FILE="${2:-}"
      shift 2
      ;;
    --all-views-dir)
      ALL_VIEWS_DIR="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

TARGET_DATE="$(date -d "$TARGET_DATE" +%F 2>/dev/null || date +%F)"
if ! VIEW="$(resolve_screen_time_view "$VIEW")"; then
  printf 'rofi-screen-time-stats: invalid view %s\n' "$VIEW" >&2
  exit 2
fi

case "$FORMAT" in
  json|theme|rows|files) ;;
  *)
    printf 'rofi-screen-time-stats: invalid format %s\n' "$FORMAT" >&2
    exit 2
    ;;
esac

if [ "$FORMAT" = "files" ] && { [ -z "$THEME_FILE" ] || [ -z "$ROWS_FILE" ]; }; then
  printf 'rofi-screen-time-stats: --theme-file and --rows-file are required for format files\n' >&2
  exit 2
fi

mkdir -p "$SCREEN_TIME_CACHE_HOME"

CATEGORY_MAP_JSON="$(load_category_map_json)"
BUNDLE_JSON="$(build_data_bundle_json "$TARGET_DATE" "$CATEGORY_MAP_JSON")"
METRICS_JSON="$(build_metrics_context "$BUNDLE_JSON")"
SCORED_JSON="$(build_scored_context "$METRICS_JSON")"
CONTEXT_JSON="$(build_insighted_context "$SCORED_JSON")"

# Everything above this line is the same for every view; only the payload is
# per view. The cache warm used to run this script once per view and so paid
# for the day-file bundle four times over.
if [ -n "$ALL_VIEWS_DIR" ]; then
  mkdir -p "$ALL_VIEWS_DIR"
  for VIEW in summary activity health timer; do
    THEME_FILE="$ALL_VIEWS_DIR/default-$VIEW-theme.rasi"
    ROWS_FILE="$ALL_VIEWS_DIR/default-$VIEW-rows.txt"
    render_files "$(build_view_payload "$VIEW" "$CONTEXT_JSON")"
  done
  exit 0
fi

PAYLOAD_JSON="$(build_view_payload "$VIEW" "$CONTEXT_JSON")"

case "$FORMAT" in
  json)
    printf '%s\n' "$PAYLOAD_JSON"
    ;;
  theme)
    render_theme "$PAYLOAD_JSON"
    ;;
  rows)
    render_rows "$PAYLOAD_JSON"
    ;;
  files)
    render_files "$PAYLOAD_JSON"
    ;;
esac
