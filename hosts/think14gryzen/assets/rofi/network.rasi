@theme "~/.config/rofi/theme.rasi"

window {
  width: 46%;
  padding: 12px;
}

mainbox {
  spacing: 8px;
  padding: 8px;
}

entry {
  placeholder: "Search networks and actions...";
}

message {
  margin: 0 0 4px 0;
  padding: 8px 10px;
  border: 1px;
  border-color: @outline-soft;
  border-radius: 9px;
}

textbox {
  font: @mono-font;
}

listview {
  columns: 1;
  lines: 14;
  fixed-height: false;
  spacing: 4px;
  scrollbar: false;
}

element {
  children: [ element-text ];
  padding: 7px 10px;
  border-radius: 8px;
}

element-text {
  font: @mono-font;
}

/* Section rows stay visually static when keyboard focus passes over them. */
element normal.active,
element alternate.active,
element selected.active {
  margin: 6px 0 2px 0;
  padding: 6px 10px;
  border-color: @accent;
  background-color: @accent-soft;
  text-color: @accent;
  cursor: default;
}

element normal.urgent {
  text-color: @signal-warning;
}

element selected.urgent {
  border-color: @signal-warning;
  background-color: @signal-warning;
  text-color: @base;
}
