@theme "~/.config/rofi/theme.rasi"

/* Type a date to jump; use ←/→ to change months.
   Use the shared calendar font to keep the sheet larger than menu rows. */

window {
  width:            400px;
}

mainbox {
  children:         [ inputbar, message, listview ];
  spacing:          0;
  padding:          8px;
}

/* Show the three navigation choices as buttons. */
listview {
  columns:          3;
  lines:            1;
  fixed-columns:    true;
  spacing:          6px;
  margin:           4px 0 0 0;
}

element {
  children:         [ element-text ];
  padding:          7px 9px;
}

element-text {
  horizontal-align: 0.5;
}

inputbar {
  margin:           0 0 4px 0;
}

entry {
  placeholder:      "15/3 · 3/2027 · 15/3/2027";
}

message {
  background-color: transparent;
  margin:           0;
  padding:          8px 4px;
}

textbox {
  font:             @mono-font-calendar;
  horizontal-align: 0.5;
}
