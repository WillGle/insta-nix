@theme "~/.config/rofi/theme.rasi"

/* Three fixed choices need no search box. */

window {
  width:         320px;
}

mainbox {
  children:      [ listview ];
  spacing:       0;
  padding:       6px;
}

listview {
  lines:         3;
  fixed-lines:   true;
  spacing:       2px;
}

element {
  children:      [ element-text ];
  padding:       7px 10px;
}
