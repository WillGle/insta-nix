@theme "~/.config/rofi/theme.rasi"

/* screen-rec: three fixed rows, no search box. The list never grows, so an
   entry that can only ever filter three known strings is a row of chrome that
   pushes the menu taller than the choices it offers. Same single layer of
   padding as calendar.rasi. */

window {
  width:         260px;
}

mainbox {
  children:      [ listview ];
  spacing:       0;
  padding:       8px;
}

listview {
  lines:         3;
  fixed-lines:   true;
  spacing:       2px;
}

element {
  children:      [ element-text ];
  padding:       6px 10px;
}
