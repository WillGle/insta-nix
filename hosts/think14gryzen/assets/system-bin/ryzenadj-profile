#!/usr/bin/env bash
set -euo pipefail

PROFILE="${1:-}"
PROFILE_STATE_DIR=/run/ryzenadj-profile
PROFILE_STATE_FILE="$PROFILE_STATE_DIR/active"
PROFILE_LOCK_FILE="$PROFILE_STATE_DIR/lock"
PROFILE_CONFIG_FILE=/etc/ryzenadj-profiles.tsv
SCHEDULER_AUTOGROUP_FILE=/proc/sys/kernel/sched_autogroup_enabled

usage() {
  echo "Usage: ryzenadj-profile [--sync|--verify|performance|sustained-build|balanced|power-saver]" >&2
}

valid_profile() {
  case "$1" in
    performance|sustained-build|balanced|power-saver) return 0 ;;
    *) return 1 ;;
  esac
}

read_state_profile() {
  local value
  [ -r "$PROFILE_STATE_FILE" ] || return 1
  value="$(<"$PROFILE_STATE_FILE")"
  valid_profile "$value" || return 1
  printf '%s\n' "$value"
}

read_ppd_profile() {
  local value
  value="$(powerprofilesctl get 2>/dev/null)" || return 1
  valid_profile "$value" || return 1
  printf '%s\n' "$value"
}

profile_row() {
  local wanted="$1"
  local name ppd stapm slow fast tctl skin vrm vrmmax scheduler mode

  [ -r "$PROFILE_CONFIG_FILE" ] || return 1
  while IFS=$'\t' read -r name ppd stapm slow fast tctl skin vrm vrmmax scheduler mode; do
    case "$name" in
      ''|'#'*) continue ;;
    esac
    [ "$name" = "$wanted" ] || continue
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$name" "$ppd" "$stapm" "$slow" "$fast" "$tctl" "$skin" "$vrm" "$vrmmax" "$scheduler" "$mode"
    return 0
  done <"$PROFILE_CONFIG_FILE"
  return 1
}

ppd_profile_for() {
  local row name ppd stapm slow fast tctl skin vrm vrmmax scheduler mode
  row="$(profile_row "$1")" || return 1
  IFS=$'\t' read -r name ppd stapm slow fast tctl skin vrm vrmmax scheduler mode <<< "$row"
  printf '%s\n' "$ppd"
}

scheduler_mode_for() {
  local row name ppd stapm slow fast tctl skin vrm vrmmax scheduler mode
  row="$(profile_row "$1")" || return 1
  IFS=$'\t' read -r name ppd stapm slow fast tctl skin vrm vrmmax scheduler mode <<< "$row"
  printf '%s\n' "$scheduler"
}

set_scheduler_mode() {
  local row name ppd stapm slow fast tctl skin vrm vrmmax scheduler mode
  row="$(profile_row "$1")" || return 1
  IFS=$'\t' read -r name ppd stapm slow fast tctl skin vrm vrmmax scheduler mode <<< "$row"
  printf '%s\n' "$scheduler" >"$SCHEDULER_AUTOGROUP_FILE"
}

apply_ryzen_settings() {
  local row name ppd stapm slow fast tctl skin vrm vrmmax scheduler mode
  local -a args

  row="$(profile_row "$1")" || return 1
  IFS=$'\t' read -r name ppd stapm slow fast tctl skin vrm vrmmax scheduler mode <<< "$row"
  args=(
    "--stapm-limit=$stapm"
    "--fast-limit=$fast"
    "--slow-limit=$slow"
    "--tctl-temp=$tctl"
  )
  [ "$skin" = - ] || args+=("--apu-skin-temp=$skin")
  [ "$vrm" = - ] || args+=("--vrm-current=$vrm")
  [ "$vrmmax" = - ] || args+=("--vrmmax-current=$vrmmax")
  case "$mode" in
    max-performance|power-saving) args+=("--$mode") ;;
    none) ;;
    *) return 1 ;;
  esac

  ryzenadj "${args[@]}" --info || return 1
  return 0
}

read_info_value() {
  local info="$1" parameter="$2"

  printf '%s\n' "$info" |
    awk -F'|' -v wanted="$parameter" '
      NF >= 4 {
        value = $3
        parameter = $4
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", parameter)
      }
      parameter == wanted {
        print value
        found = 1
      }
      END { exit !found }
    '
}

verify_metric() {
  local info="$1" parameter="$2" raw_expected="$3" divisor="$4"
  local actual expected

  actual="$(read_info_value "$info" "$parameter")" || {
    printf 'error: RyzenAdj readback missing %s\n' "$parameter" >&2
    return 1
  }
  expected="$(
    awk -v raw="$raw_expected" -v divisor="$divisor" \
      'BEGIN { printf "%.3f", raw / divisor }'
  )"
  awk -v actual="$actual" -v expected="$expected" '
    BEGIN {
      if (actual !~ /^-?[0-9]+([.][0-9]+)?$/) exit 1
      difference = actual - expected
      if (difference < 0) difference = -difference
      exit difference > 0.1
    }
  ' || {
    printf 'error: RyzenAdj readback mismatch for %s: expected %s, got %s\n' \
      "$parameter" "$expected" "$actual" >&2
    return 1
  }
}

verify_ryzen_settings() {
  local profile="$1" info="$2"
  local row name ppd stapm slow fast tctl skin vrm vrmmax scheduler mode

  row="$(profile_row "$profile")" || return 1
  IFS=$'\t' read -r name ppd stapm slow fast tctl skin vrm vrmmax scheduler mode <<< "$row"
  verify_metric "$info" stapm-limit "$stapm" 1000 || return 1
  verify_metric "$info" fast-limit "$fast" 1000 || return 1
  verify_metric "$info" slow-limit "$slow" 1000 || return 1
  verify_metric "$info" tctl-temp "$tctl" 1 || return 1
  [ "$skin" = - ] || verify_metric "$info" apu-skin-temp "$skin" 1 || return 1
  [ "$vrm" = - ] || verify_metric "$info" vrm-current "$vrm" 1000 || return 1
  [ "$vrmmax" = - ] || verify_metric "$info" vrmmax-current "$vrmmax" 1000 || return 1
  if [ "$mode" != none ]; then
    printf 'verification_note=hidden_mode_%s_accepted_unverified\n' "$mode"
  fi
}

verify_profile_state() {
  local profile="$1" info="${2:-}"
  local ppd_profile scheduler current_ppd current_scheduler

  ppd_profile="$(ppd_profile_for "$profile")" || return 1
  scheduler="$(scheduler_mode_for "$profile")" || return 1
  current_scheduler="$(<"$SCHEDULER_AUTOGROUP_FILE")" || {
    printf 'error: cannot read scheduler autogroup state\n' >&2
    return 1
  }
  [ "$current_scheduler" = "$scheduler" ] || {
    printf 'error: scheduler readback mismatch: expected %s, got %s\n' \
      "$scheduler" "$current_scheduler" >&2
    return 1
  }
  current_ppd="$(read_ppd_profile)" || {
    printf 'error: cannot read current power profile\n' >&2
    return 1
  }
  [ "$current_ppd" = "$ppd_profile" ] || {
    printf 'error: power profile verification failed: expected %s, got %s\n' \
      "$ppd_profile" "$current_ppd" >&2
    return 1
  }
  if [ -z "$info" ]; then
    info="$(ryzenadj --info)" || return 1
    printf '%s\n' "$info"
  fi
  verify_ryzen_settings "$profile" "$info"
}

mark_profile() {
  local temporary
  temporary="$(mktemp "$PROFILE_STATE_FILE.XXXXXX")" || return 1
  if ! {
    printf '%s\n' "$1" >"$temporary"
    chmod 0644 "$temporary"
    mv -f -- "$temporary" "$PROFILE_STATE_FILE"
  }; then
    rm -f -- "$temporary"
    return 1
  fi
}

apply_profile() {
  local profile="$1" ppd_profile info retained_info
  ppd_profile="$(ppd_profile_for "$profile")" || return 1

  # The marker is the commit record. Update it only after immediate and
  # delayed readback both show that the requested profile was retained.
  powerprofilesctl set "$ppd_profile" || return 1
  set_scheduler_mode "$profile" || return 1
  info="$(apply_ryzen_settings "$profile")" || return 1
  printf '%s\n' "$info"
  verify_profile_state "$profile" "$info" || return 1
  sleep 3
  retained_info="$(ryzenadj --info)" || return 1
  printf '%s\n' "$retained_info"
  verify_profile_state "$profile" "$retained_info" || return 1
  mark_profile "$profile" || return 1
  printf 'verified_profile=%s\n' "$profile"
  return 0
}

if [ "$#" -ne 1 ]; then
  usage
  exit 2
fi

mkdir -p -- "$PROFILE_STATE_DIR"
exec 9>"$PROFILE_LOCK_FILE"

if [ "$PROFILE" = --verify ]; then
  flock -sn 9 || {
    printf 'error: profile transition is active\n' >&2
    exit 1
  }
  PROFILE="$(read_state_profile 2>/dev/null || true)"
  valid_profile "$PROFILE" || {
    printf 'error: cannot determine committed profile\n' >&2
    exit 1
  }
  verify_profile_state "$PROFILE" || exit 1
  printf 'verified_profile=%s\n' "$PROFILE"
  exit 0
fi

flock -xn 9 || {
  printf 'error: another profile transition or benchmark is active\n' >&2
  exit 1
}

previous_profile="$(read_state_profile 2>/dev/null || true)"
if ! valid_profile "$previous_profile"; then
  previous_profile="$(read_ppd_profile 2>/dev/null || true)"
fi

if [ "$PROFILE" = --sync ]; then
  PROFILE="$(read_state_profile 2>/dev/null || true)"
  if ! valid_profile "$PROFILE"; then
    PROFILE="$(read_ppd_profile 2>/dev/null || true)"
  fi
fi

valid_profile "$PROFILE" || {
  usage
  exit 2
}

if apply_profile "$PROFILE"; then
  exit 0
else
  apply_rc=$?
fi
printf 'error: failed to apply profile %s; attempting rollback to %s\n' \
  "$PROFILE" "${previous_profile:-unknown}" >&2
if valid_profile "$previous_profile"; then
  if apply_profile "$previous_profile"; then
    printf 'rollback_profile=%s\n' "$previous_profile" >&2
  else
    printf 'error: profile rollback also failed\n' >&2
  fi
fi
exit "$apply_rc"
