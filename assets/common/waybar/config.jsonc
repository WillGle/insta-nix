{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": [
    "custom/screen_time",
    "clock#calendar",
    "custom/refresh_rate",
    "backlight",
    "idle_inhibitor",
    "pulseaudio",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "custom/atomic_note",
    "custom/systemd_failed"
  ],
  "modules-right": [
    "custom/memory_info",
    "custom/apu_info",
    "custom/power_flow",
    "custom/network_info",
    "tray"
  ],
  "hyprland/workspaces": {
    "format": "{name}"
  },
  "clock#time": {
    "format": " {:%H:%M}",
    "interval": 60,
    "tooltip-format": "<b><span foreground='#58a6ff'>TIME</span></b>\n<span alpha='30%'>──────────────────────────</span>\n<tt>{:%A, %d %B %Y\n%H:%M}</tt>"
  },
  "clock#calendar": {
    "format": " {:%a %d %b}",
    "interval": 60,
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 1,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#a7d293'><b>{}</b></span>",
        "days":     "{}",
        "weeks":    "W{}",
        "weekdays": "{}",
        "today":    "<span color='#a7d293'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "custom/screen_time": {
    "exec": "$HOME/.local/bin/waybar-screen-time",
    "return-type": "json",
    "interval": 30,
    "signal": 7,
    "on-click": "$HOME/.local/bin/waybar-screen-time toggle",
    "on-click-right": "setsid -f $HOME/.local/bin/rofi-screen-time",
    "on-click-middle": "setsid -f $HOME/.local/bin/rofi-study-timer",
    "tooltip": true
  },
  // ─── Memory (custom with top-process tooltip) ─────────────────────
  "custom/memory_info": {
    "exec": "$HOME/.local/bin/waybar-memory-info",
    "return-type": "json",
    "interval": 1,
    "tooltip": true
  },
  // ─── Audio ────────────────────────────────────────────────────────
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": " {volume}%",
    "format-muted": "󰖁",
    "format-bluetooth-muted": " 󰖁",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 1,
    "tooltip-format": "<b><span foreground='#58a6ff'>AUDIO DEVICE</span></b>\n<span alpha='30%'>──────────────────────────</span>\n<tt>{desc}\nVolume:      {volume}%</tt>",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        ""
      ]
    }
  },
  // ─── Hardware Monitors (consolidated temp + power) ────────────────
  "custom/apu_info": {
    "exec": "$HOME/.local/bin/waybar-power-monitor apu",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "tooltip": true
  },
  "custom/power_flow": {
    "exec": "$HOME/.local/bin/waybar-power-monitor pwr",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 2,
    "on-click": "$HOME/.local/bin/waybar-power-monitor toggle",
    "on-click-right": "$HOME/.local/bin/waybar-power-monitor bmode-toggle",
    "tooltip": true
  },
  // ─── Refresh Rate ─────────────────────────────────────────────────
  "custom/refresh_rate": {
    "exec": "$HOME/.local/bin/waybar-refresh-label",
    "return-type": "text",
    "interval": 1,
    "on-click": "$HOME/.local/bin/waybar-refresh-toggle",
    "tooltip": false
  },
  "custom/atomic_note": {
    "exec": "$HOME/.local/bin/atomic-note render-waybar",
    "max-length": 45,
    "return-type": "json",
    "interval": 1,
    "on-click": "$HOME/.local/bin/atomic-note rofi",
    "on-click-right": "$HOME/.local/bin/atomic-note add",
    "signal": 5,
    "tooltip": true
  },
  "custom/network_info": {
    "exec": "$HOME/.local/bin/waybar-network-info",
    "return-type": "json",
    "interval": 5,
    "signal": 6,
    "on-click": "$HOME/.local/bin/rofi-network",
    "on-click-right": "$HOME/.local/bin/rofi-network",
    "tooltip": true
  },
  "backlight": {
    "device": "amd_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip": false
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉"
    },
    "tooltip-format-activated": "Idle Inhibitor: Active",
    "tooltip-format-deactivated": "Idle Inhibitor: Inactive"
  },
  "custom/systemd_failed": {
    "exec": "$HOME/.local/bin/waybar-systemd-failed",
    "return-type": "json",
    "interval": 10,
    "tooltip": true
  },
  "tray": {}
}
